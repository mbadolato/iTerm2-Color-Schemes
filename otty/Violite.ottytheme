[meta]
name = "Violite"
mode = "dark"

[terminal]
foreground = "#eef4f6"
background = "#241c36"
palette = [
    "#241c36", "#ec7979", "#79ecb3", "#ece279",
    "#a979ec", "#ec79ec", "#79ecec", "#eef4f6",
    "#56447a", "#ef8f8f", "#9fefbf", "#efe78f",
    "#b78fef", "#ef8fcf", "#9fefef", "#f8fafc",
]
cursor = "#eef4f6"
cursor-text = "#241c36"
selection-background = "#49376d"
selection-foreground = "#eef4f6"
