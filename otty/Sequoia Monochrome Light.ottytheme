[meta]
name = "Sequoia Monochrome Light"
mode = "light"
author = "Michael Andreuzza (https://github.com/michael-andreuzza/Sequoia-Theme)"

[terminal]
foreground = "#282930"
background = "#edeef2"
palette = [
    "#d4d5dc", "#525666", "#2e3038", "#50535e",
    "#5f6370", "#25262d", "#454752", "#282930",
    "#42434e", "#525666", "#2e3038", "#50535e",
    "#5f6370", "#25262d", "#454752", "#282930",
]
cursor = "#565760"
cursor-text = "#282930"
selection-background = "#817c9c"
selection-foreground = "#282930"
