[meta]
name = "Flexoki Light"
mode = "light"

[terminal]
foreground = "#100f0f"
background = "#fffcf0"
palette = [
    "#100f0f", "#af3029", "#66800b", "#ad8301",
    "#205ea6", "#a02f6f", "#24837b", "#6f6e69",
    "#b7b5ac", "#d14d41", "#879a39", "#d0a215",
    "#4385be", "#ce5d97", "#3aa99f", "#cecdc3",
]
cursor = "#100f0f"
cursor-text = "#fffcf0"
selection-background = "#cecdc3"
selection-foreground = "#100f0f"
