[meta]
name = "Farmhouse Dark"
mode = "dark"

[terminal]
foreground = "#e8e4e1"
background = "#1d2027"
palette = [
    "#1d2027", "#ba0004", "#549d00", "#c87300",
    "#0049e6", "#9f1b61", "#1fb65c", "#e8e4e1",
    "#464d54", "#eb0009", "#7ac100", "#ea9a00",
    "#006efe", "#bf3b7f", "#19e062", "#f4eef0",
]
cursor = "#006efe"
cursor-text = "#e8e4e1"
selection-background = "#4d5658"
selection-foreground = "#b3b1aa"
