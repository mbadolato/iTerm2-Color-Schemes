[meta]
name = "Green Screen"
mode = "dark"

[terminal]
foreground = "#dff7e8"
background = "#031009"
palette = [
    "#a9bdb0", "#ed8087", "#70d19c", "#e5cc69",
    "#82b3e7", "#c99fdf", "#70d2ce", "#dff7e8",
    "#c0cec5", "#f09ba1", "#90dfb4", "#ecdc8b",
    "#a1c8ef", "#d9bae8", "#92e1dc", "#f6fff9",
]
cursor = "#8af0b4"
cursor-text = "#031009"
selection-background = "#12351f"
selection-foreground = "#effff4"
