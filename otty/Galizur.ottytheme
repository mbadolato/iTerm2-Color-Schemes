[meta]
name = "Galizur"
mode = "dark"

[terminal]
foreground = "#ddeeff"
background = "#071317"
palette = [
    "#223344", "#aa1122", "#33aa11", "#ccaa22",
    "#2255cc", "#7755aa", "#22bbdd", "#8899aa",
    "#556677", "#ff1133", "#33ff11", "#ffdd33",
    "#3377ff", "#aa77ff", "#33ddff", "#bbccdd",
]
cursor = "#ddeeff"
cursor-text = "#071317"
selection-background = "#071317"
selection-foreground = "#ddeeff"
