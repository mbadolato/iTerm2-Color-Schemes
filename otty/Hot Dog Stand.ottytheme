[meta]
name = "Hot Dog Stand"
mode = "dark"
author = "Benjamin Reed (https://github.com/RangerRick/)"

[terminal]
foreground = "#ffffff"
background = "#ea3323"
palette = [
    "#000000", "#ffff54", "#ffff54", "#ffff54",
    "#000000", "#ffff54", "#ffffff", "#c6c6c6",
    "#000000", "#ffff54", "#ffff54", "#ffff54",
    "#000000", "#ffff54", "#ffffff", "#c6c6c6",
]
cursor = "#ffff54"
cursor-text = "#ea3323"
selection-background = "#ffff54"
selection-foreground = "#000000"
