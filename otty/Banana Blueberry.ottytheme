[meta]
name = "Banana Blueberry"
mode = "dark"

[terminal]
foreground = "#cccccc"
background = "#191323"
palette = [
    "#17141f", "#ff6b7f", "#00bd9c", "#e6c62f",
    "#22e8df", "#dc396a", "#56b6c2", "#f1f1f1",
    "#495162", "#fe9ea1", "#98c379", "#f9e46b",
    "#91fff4", "#da70d6", "#bcf3ff", "#ffffff",
]
cursor = "#e07d13"
cursor-text = "#ffffff"
selection-background = "#220525"
selection-foreground = "#f4f4f4"
