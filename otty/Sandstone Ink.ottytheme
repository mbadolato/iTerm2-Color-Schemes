[meta]
name = "Sandstone Ink"
mode = "light"

[terminal]
foreground = "#2b3d45"
background = "#fdf6e3"
palette = [
    "#002b36", "#cf2522", "#4b7000", "#906800",
    "#0d6fa8", "#b5006e", "#00756d", "#6e6855",
    "#2b3d45", "#b33000", "#536868", "#566c6c",
    "#5c6f6f", "#5f64b7", "#5f6e6e", "#fdf6e3",
]
cursor = "#2b3d45"
cursor-text = "#fdf6e3"
selection-background = "#ddd8c0"
selection-foreground = "#a49d8a"
