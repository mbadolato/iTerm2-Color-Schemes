[meta]
name = "Blazer"
mode = "dark"

[terminal]
foreground = "#d9e6f2"
background = "#0d1926"
palette = [
    "#000000", "#b87a7a", "#7ab87a", "#b8b87a",
    "#7a7ab8", "#b87ab8", "#7ab8b8", "#d9d9d9",
    "#4c4c4c", "#dbbdbd", "#bddbbd", "#dbdbbd",
    "#bdbddb", "#dbbddb", "#bddbdb", "#ffffff",
]
cursor = "#d9e6f2"
cursor-text = "#0d1926"
selection-background = "#c1ddff"
selection-foreground = "#000000"
