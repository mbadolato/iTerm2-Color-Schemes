[meta]
name = "JetBrains Darcula"
mode = "dark"

[terminal]
foreground = "#adadad"
background = "#202020"
palette = [
    "#000000", "#fa5355", "#126e00", "#c2c300",
    "#4581eb", "#fa54ff", "#33c2c1", "#adadad",
    "#555555", "#fb7172", "#67ff4f", "#ffff00",
    "#6d9df1", "#fb82ff", "#60d3d1", "#eeeeee",
]
cursor = "#ffffff"
cursor-text = "#000000"
selection-background = "#1a3272"
selection-foreground = "#adadad"
