[meta]
name = "Fish Tank"
mode = "dark"

[terminal]
foreground = "#ecf0fe"
background = "#232537"
palette = [
    "#03073c", "#c6004a", "#acf157", "#fecd5e",
    "#525fb8", "#986f82", "#968763", "#ecf0fc",
    "#6c5b30", "#da4b8a", "#dbffa9", "#fee6a9",
    "#b2befa", "#fda5cd", "#a5bd86", "#f6ffec",
]
cursor = "#fecd5e"
cursor-text = "#232537"
selection-background = "#fcf7e9"
selection-foreground = "#232537"
