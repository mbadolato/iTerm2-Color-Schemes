[meta]
name = "Monospace Dark"
mode = "dark"
author = "Angelo Convento (https://github.com/conventoangelo)"

[terminal]
foreground = "#a4afbd"
background = "#10151d"
palette = [
    "#738295", "#f76769", "#17b877", "#ffa23e",
    "#708fff", "#a87ffb", "#25a6e9", "#a4afbd",
    "#8b98a9", "#fc8f8e", "#66ce98", "#ffc26e",
    "#a2b6ff", "#c8aaff", "#71c2ee", "#fafbfe",
]
cursor = "#c8aaff"
cursor-text = "#10151d"
selection-background = "#264dcb"
selection-foreground = "#d9dfe7"
