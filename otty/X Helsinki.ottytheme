[meta]
name = "X Helsinki"
mode = "light"

[terminal]
foreground = "#544d40"
background = "#f8fafe"
palette = [
    "#f8fafe", "#1faa9e", "#733d9a", "#2e70ad",
    "#b55a0f", "#3e9d21", "#bd4c3d", "#544d40",
    "#b0a999", "#009e91", "#5a1f8a", "#0f5ba2",
    "#b23b00", "#218c00", "#b32e1f", "#000000",
]
cursor = "#544d40"
cursor-text = "#f8fafe"
selection-background = "#544d40"
selection-foreground = "#f8fafe"
