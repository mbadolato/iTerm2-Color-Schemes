[meta]
name = "GitLab Light"
mode = "light"

[terminal]
foreground = "#303030"
background = "#fafaff"
palette = [
    "#303030", "#a31700", "#0a7f3d", "#af551d",
    "#006cd8", "#583cac", "#00798a", "#303030",
    "#303030", "#a31700", "#0a7f3d", "#af551d",
    "#006cd8", "#583cac", "#00798a", "#303030",
]
cursor = "#303030"
cursor-text = "#565656"
selection-background = "#ad95e9"
selection-foreground = "#fafaff"
