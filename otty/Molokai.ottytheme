[meta]
name = "Molokai"
mode = "dark"

[terminal]
foreground = "#bbbbbb"
background = "#121212"
palette = [
    "#121212", "#fa2573", "#98e123", "#dfd460",
    "#1080d0", "#8700ff", "#43a8d0", "#bbbbbb",
    "#555555", "#f6669d", "#b1e05f", "#fff26d",
    "#00afff", "#af87ff", "#51ceff", "#ffffff",
]
cursor = "#bbbbbb"
cursor-text = "#ffffff"
selection-background = "#b5d5ff"
selection-foreground = "#000000"
