[meta]
name = "HN After Dark"
mode = "dark"

[terminal]
foreground = "#f6f6ef"
background = "#181818"
palette = [
    "#858585", "#ff765c", "#65c878", "#e5b94d",
    "#5599ff", "#c27acb", "#53c5e8", "#dddddd",
    "#929292", "#ff916f", "#85dc94", "#f2d17b",
    "#83b7ff", "#d89ce0", "#78dbee", "#ffffff",
]
cursor = "#ff6600"
cursor-text = "#181818"
selection-background = "#454545"
selection-foreground = "#ffffff"
