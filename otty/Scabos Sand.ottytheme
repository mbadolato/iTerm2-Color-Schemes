[meta]
name = "Scabos Sand"
mode = "dark"

[terminal]
foreground = "#fff4dc"
background = "#79563b"
palette = [
    "#fff0d1", "#ffdbc1", "#e1f0b7", "#ffe29b",
    "#c6e4fc", "#eed2f2", "#bce9e6", "#fff4dc",
    "#fff5e5", "#ffe6cf", "#eff6d1", "#ffeaba",
    "#d8ecff", "#f7e0f7", "#d3f5ef", "#fffbed",
]
cursor = "#ffeaba"
cursor-text = "#79563b"
selection-background = "#8e684a"
selection-foreground = "#fff8e8"
