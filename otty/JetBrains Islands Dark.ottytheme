[meta]
name = "JetBrains Islands Dark"
mode = "dark"
author = "Ch1re (https://github.com/bbeny123/)"

[terminal]
foreground = "#bcbec4"
background = "#191a1c"
palette = [
    "#191a1c", "#f75464", "#6aab73", "#cf8e6d",
    "#56a8f5", "#c77dbb", "#2aacb8", "#bcbec4",
    "#7a7e85", "#f57e84", "#6db083", "#f0ac81",
    "#548af7", "#b189f5", "#16baac", "#ffffff",
]
cursor = "#ced0d6"
cursor-text = "#191a1c"
selection-background = "#2a4371"
selection-foreground = "#d1d3d9"
