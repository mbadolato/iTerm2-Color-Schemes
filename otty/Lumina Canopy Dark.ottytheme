[meta]
name = "Lumina Canopy Dark"
mode = "dark"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#d8e3d6"
background = "#0c1b10"
palette = [
    "#0f2014", "#d57068", "#99d0a4", "#d1cca8",
    "#9acaf1", "#e2acdd", "#86cfd7", "#b8c3b6",
    "#7c917e", "#e1928b", "#b2ebbd", "#f4e792",
    "#c0e3ff", "#fdc5f8", "#9fe9f1", "#d8e3d6",
]
cursor = "#d8e3d6"
cursor-text = "#0c1b10"
selection-background = "#403e24"
selection-foreground = "#d8e3d6"
