[meta]
name = "Urple"
mode = "dark"

[terminal]
foreground = "#877a9b"
background = "#1b1b23"
palette = [
    "#000000", "#b0425b", "#37a415", "#ad5c42",
    "#564d9b", "#6c3ca1", "#808080", "#87799c",
    "#6a3f32", "#ff6388", "#29e620", "#f08161",
    "#867aed", "#a05eee", "#eaeaea", "#bfa3ff",
]
cursor = "#a063eb"
cursor-text = "#1b1b22"
selection-background = "#a063eb"
selection-foreground = "#1b1b22"
