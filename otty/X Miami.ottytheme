[meta]
name = "X Miami"
mode = "dark"

[terminal]
foreground = "#f7f1ff"
background = "#000000"
palette = [
    "#000000", "#ff4c8b", "#7fffd4", "#ffd84c",
    "#00ffa8", "#d36cff", "#47cfff", "#f7f1ff",
    "#69676c", "#ff4c8b", "#7fffd4", "#ffd84c",
    "#00ffa8", "#d36cff", "#47cfff", "#f7f1ff",
]
cursor = "#f7f1ff"
cursor-text = "#000000"
selection-background = "#f7f1ff"
selection-foreground = "#000000"
