[meta]
name = "Clear Light"
mode = "light"

[terminal]
foreground = "#3a4851"
background = "#ffffff"
palette = [
    "#2d3840", "#b45648", "#6caa71", "#c4ac62",
    "#5685a8", "#ad64be", "#69c6c9", "#b4bbbf",
    "#506573", "#df6c5a", "#79be7e", "#d8bb65",
    "#49a2e1", "#d389e5", "#5ec7cb", "#d8e1e7",
]
cursor = "#919191"
cursor-text = "#ffffff"
selection-background = "#e5ecf1"
selection-foreground = "#b2b2b2"
