[meta]
name = "Rhoads Tribute"
mode = "dark"

[terminal]
foreground = "#fff0d2"
background = "#29212f"
palette = [
    "#b9adb9", "#ed8b8e", "#a9cb92", "#eac06a",
    "#a4b9e4", "#c3a0e5", "#8bcdd1", "#fff0d2",
    "#d3c8d0", "#f6a3a2", "#c1dda7", "#f5d48a",
    "#b8cbef", "#d8b9ef", "#a6dfe1", "#fff9ec",
]
cursor = "#f2c36a"
cursor-text = "#29212f"
selection-background = "#563a60"
selection-foreground = "#fff8e9"
