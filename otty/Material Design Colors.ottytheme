[meta]
name = "Material Design Colors"
mode = "dark"

[terminal]
foreground = "#e7ebed"
background = "#1d262a"
palette = [
    "#435b67", "#fc3841", "#5cf19e", "#fed032",
    "#37b6ff", "#fc226e", "#59ffd1", "#ffffff",
    "#a1b0b8", "#fc746d", "#adf7be", "#fee16c",
    "#70cfff", "#fc669b", "#9affe6", "#ffffff",
]
cursor = "#eaeaea"
cursor-text = "#000000"
selection-background = "#4e6a78"
selection-foreground = "#e7ebed"
