[meta]
name = "Icy Glacier"
mode = "light"

[terminal]
foreground = "#0f172a"
background = "#eef6ff"
palette = [
    "#263548", "#8f2424", "#17613c", "#6e5500",
    "#174c9b", "#64379a", "#006275", "#3b4858",
    "#536171", "#741a1a", "#1b6945", "#765d00",
    "#123b78", "#503075", "#006b80", "#455365",
]
cursor = "#07517a"
cursor-text = "#eef6ff"
selection-background = "#dbeafe"
selection-foreground = "#0f172a"
