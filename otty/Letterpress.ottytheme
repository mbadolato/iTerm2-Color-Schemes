[meta]
name = "Letterpress"
mode = "light"

[terminal]
foreground = "#3a352c"
background = "#f3ecdf"
palette = [
    "#3a352c", "#b0202a", "#506b24", "#8a5e0a",
    "#2a5c8a", "#6e4b2e", "#176b5f", "#aeaba4",
    "#8e886f", "#b0202a", "#506b24", "#8a4fa0",
    "#2a5c8a", "#176b5f", "#176b5f", "#3a352c",
]
cursor = "#2a5c8a"
cursor-text = "#f3ecdf"
selection-background = "#e3d8c4"
selection-foreground = "#a69f92"
