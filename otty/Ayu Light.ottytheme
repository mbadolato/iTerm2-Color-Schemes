[meta]
name = "Ayu Light"
mode = "light"
author = "Ayu Theme (https://github.com/ayu-theme)"

[terminal]
foreground = "#5c6166"
background = "#f8f9fa"
palette = [
    "#000000", "#ea6c6d", "#6cbf43", "#eca944",
    "#3199e1", "#9e75c7", "#46ba94", "#bababa",
    "#686868", "#f07171", "#86b300", "#f2ae49",
    "#399ee6", "#a37acc", "#4cbf99", "#d1d1d1",
]
cursor = "#ffaa33"
cursor-text = "#f8f9fa"
selection-background = "#035bd6"
selection-foreground = "#f8f9fa"
