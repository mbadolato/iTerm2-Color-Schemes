[meta]
name = "Zenwritten Light"
mode = "light"

[terminal]
foreground = "#353535"
background = "#eeeeee"
palette = [
    "#eeeeee", "#a8334c", "#4f6c31", "#944927",
    "#286486", "#88507d", "#3b8992", "#353535",
    "#aca9a9", "#94253e", "#3f5a22", "#803d1c",
    "#1d5573", "#7b3b70", "#2b747c", "#5c5c5c",
]
cursor = "#353535"
cursor-text = "#eeeeee"
selection-background = "#d7d7d7"
selection-foreground = "#353535"
