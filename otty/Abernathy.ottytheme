[meta]
name = "Abernathy"
mode = "dark"

[terminal]
foreground = "#eeeeec"
background = "#111416"
palette = [
    "#000000", "#cd0000", "#00cd00", "#cdcd00",
    "#1093f5", "#cd00cd", "#00cdcd", "#faebd7",
    "#404040", "#ff0000", "#00ff00", "#ffff00",
    "#11b5f6", "#ff00ff", "#00ffff", "#ffffff",
]
cursor = "#bbbbbb"
cursor-text = "#ffffff"
selection-background = "#eeeeec"
selection-foreground = "#333333"
