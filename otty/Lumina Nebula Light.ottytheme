[meta]
name = "Lumina Nebula Light"
mode = "light"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#2d2c46"
background = "#f8f4ff"
palette = [
    "#2d2c46", "#932222", "#007650", "#955b01",
    "#3f5777", "#894884", "#016e90", "#6d6d8b",
    "#676680", "#6c2421", "#005f40", "#7a4a00",
    "#0e417f", "#72356e", "#005975", "#8c8cab",
]
cursor = "#2d2c46"
cursor-text = "#f8f4ff"
selection-background = "#c7c7ef"
selection-foreground = "#2d2c46"
