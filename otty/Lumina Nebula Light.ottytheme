[meta]
name = "Lumina Nebula Light"
mode = "light"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#1f2a38"
background = "#f6f8fb"
palette = [
    "#1f2a38", "#902725", "#2e7241", "#996000",
    "#34639e", "#84487f", "#00657e", "#657283",
    "#626d7a", "#692623", "#1a5d2f", "#7e4e00",
    "#214f88", "#6e3569", "#005064", "#8491a3",
]
cursor = "#1f2a38"
cursor-text = "#f6f8fb"
selection-background = "#d3e0e7"
selection-foreground = "#1f2a38"
