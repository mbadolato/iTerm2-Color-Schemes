[meta]
name = "Canyon Shadow"
mode = "dark"

[terminal]
foreground = "#fff0df"
background = "#513554"
palette = [
    "#d5ccd3", "#fba493", "#9bd7ad", "#f0d176",
    "#a1cbed", "#e5b1dc", "#96dfda", "#fff0df",
    "#e2dae0", "#ffb8a8", "#b1e1bc", "#f8df94",
    "#bbdaf2", "#edc5e5", "#b4eae5", "#fffaf3",
]
cursor = "#f5c15e"
cursor-text = "#513554"
selection-background = "#6e5270"
selection-foreground = "#fff8ed"
