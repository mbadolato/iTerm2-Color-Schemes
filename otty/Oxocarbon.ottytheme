[meta]
name = "Oxocarbon"
mode = "dark"

[terminal]
foreground = "#f2f4f8"
background = "#161616"
palette = [
    "#161616", "#00dfdb", "#00b4ff", "#ff4297",
    "#00c15a", "#c693ff", "#ff74b8", "#f2f4f8",
    "#585858", "#00dfdb", "#00b4ff", "#ff4297",
    "#00c15a", "#c693ff", "#ff74b8", "#f2f4f8",
]
cursor = "#ffffff"
cursor-text = "#000000"
selection-background = "#393939"
selection-foreground = "#626262"
