[meta]
name = "Cutie Pro"
mode = "dark"

[terminal]
foreground = "#d5d0c9"
background = "#181818"
palette = [
    "#000000", "#f56e7f", "#bec975", "#f58669",
    "#42d9c5", "#d286b7", "#37cb8a", "#d5c3c3",
    "#88847f", "#e5a1a3", "#e8d6a7", "#f1bb79",
    "#80c5de", "#b294bb", "#9dccbb", "#ffffff",
]
cursor = "#efc4cd"
cursor-text = "#181818"
selection-background = "#363636"
selection-foreground = "#d5d0c9"
