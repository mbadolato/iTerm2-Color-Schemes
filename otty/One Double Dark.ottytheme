[meta]
name = "One Double Dark"
mode = "dark"

[terminal]
foreground = "#dbdfe5"
background = "#282c34"
palette = [
    "#3d4452", "#f16372", "#8cc570", "#ecbe70",
    "#3fb1f5", "#d373e3", "#17b9c4", "#dbdfe5",
    "#525d6f", "#ff777b", "#82d882", "#f5c065",
    "#6dcaff", "#ff7bf4", "#00e5fb", "#f7f9fc",
]
cursor = "#f5e0dc"
cursor-text = "#9aa3c1"
selection-background = "#585b70"
selection-foreground = "#cdd6f4"
