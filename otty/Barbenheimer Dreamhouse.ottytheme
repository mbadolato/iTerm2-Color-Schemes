[meta]
name = "Barbenheimer Dreamhouse"
mode = "light"
author = "Jayvic San Antonio (https://github.com/jayvicsanantonio/barbenheimer-zed-theme)"

[terminal]
foreground = "#14140b"
background = "#fff8f0"
palette = [
    "#302820", "#f060a0", "#9bcc6a", "#d1b161",
    "#7ac1ed", "#ba55d3", "#80cbc4", "#14140b",
    "#4a443a", "#dc5687", "#86b465", "#d3b363",
    "#64b5d9", "#9b40b4", "#609e9a", "#000000",
]
cursor = "#f060a0"
cursor-text = "#fff8f0"
selection-background = "#14140b"
selection-foreground = "#fff8f0"
