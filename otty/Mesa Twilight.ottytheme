[meta]
name = "Mesa Twilight"
mode = "dark"

[terminal]
foreground = "#fff0df"
background = "#172b54"
palette = [
    "#bfc4ce", "#f1958c", "#83cba2", "#e9c96c",
    "#83b9e6", "#c89edb", "#78ced3", "#fff0df",
    "#d0d4dc", "#f8aca5", "#9dd8b5", "#f2d98a",
    "#9fcaf0", "#d9b6e5", "#97dce0", "#fffaf2",
]
cursor = "#f3b85b"
cursor-text = "#172b54"
selection-background = "#34496d"
selection-foreground = "#fff8ed"
