[meta]
name = "Unikitty"
mode = "light"

[terminal]
foreground = "#0b0b0b"
background = "#ff8cd9"
palette = [
    "#0c0c0c", "#a80f20", "#c7ff98", "#fff964",
    "#145fcd", "#ffe9ff", "#9effef", "#fcf1fb",
    "#434343", "#d91329", "#d3ffaf", "#ffef50",
    "#0075ea", "#ffefff", "#93ffef", "#fff3fe",
]
cursor = "#c7ff98"
cursor-text = "#202020"
selection-background = "#3ea9fe"
selection-foreground = "#ffffff"
