[meta]
name = "Iceberg Dark"
mode = "dark"

[terminal]
foreground = "#c6c8d1"
background = "#161821"
palette = [
    "#1e2132", "#e27878", "#b4be82", "#e2a478",
    "#84a0c6", "#a093c7", "#89b8c2", "#c6c8d1",
    "#6b7089", "#e98989", "#c0ca8e", "#e9b189",
    "#91acd1", "#ada0d3", "#95c4ce", "#d2d4de",
]
cursor = "#c6c8d1"
cursor-text = "#161821"
selection-background = "#c6c8d1"
selection-foreground = "#161821"
