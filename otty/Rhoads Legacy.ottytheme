[meta]
name = "Rhoads Legacy"
mode = "dark"

[terminal]
foreground = "#c4b5fd"
background = "#0a0614"
palette = [
    "#18111f", "#7c3aed", "#d946ef", "#f4d03f",
    "#6366f1", "#a78bfa", "#c4b5fd", "#f8f6ed",
    "#4b3f72", "#d946ef", "#f472b6", "#fde68a",
    "#7c9cff", "#e9d5ff", "#cbd5e1", "#ffffff",
]
cursor = "#f4d03f"
cursor-text = "#0a0614"
selection-background = "#4c1d95"
selection-foreground = "#fff7d6"
