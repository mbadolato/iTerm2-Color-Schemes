[meta]
name = "Spring"
mode = "light"

[terminal]
foreground = "#4d4d4c"
background = "#ffffff"
palette = [
    "#000000", "#ff4d83", "#1f8c3b", "#1fc95b",
    "#1dd3ee", "#8959a8", "#3e999f", "#bfbfbf",
    "#000000", "#ff0021", "#1fc231", "#d5b807",
    "#15a9fd", "#8959a8", "#3e999f", "#ffffff",
]
cursor = "#4d4d4c"
cursor-text = "#ffffff"
selection-background = "#d6d6d6"
selection-foreground = "#4d4d4c"
