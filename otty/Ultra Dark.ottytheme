[meta]
name = "Ultra Dark"
mode = "dark"

[terminal]
foreground = "#ffffff"
background = "#000000"
palette = [
    "#000000", "#f07178", "#c3e88d", "#ffcb6b",
    "#82aaff", "#c792ea", "#89ddff", "#cccccc",
    "#404040", "#f6a9ae", "#dbf1ba", "#ffdfa6",
    "#b4ccff", "#ddbdf2", "#b8eaff", "#ffffff",
]
cursor = "#fefefe"
cursor-text = "#000000"
selection-background = "#222222"
selection-foreground = "#cccccc"
