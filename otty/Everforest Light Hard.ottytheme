[meta]
name = "Everforest Light Hard"
mode = "light"

[terminal]
foreground = "#5c6a72"
background = "#f2efdf"
palette = [
    "#7a8478", "#e67e80", "#9ab373", "#ceaf72",
    "#7fbbb3", "#d699b6", "#83c092", "#b2af9f",
    "#a6b0a0", "#f85552", "#8da101", "#dfa000",
    "#3a94c5", "#df69ba", "#35a77c", "#fffbef",
]
cursor = "#f57d26"
cursor-text = "#f0f2d4"
selection-background = "#f0f2d4"
selection-foreground = "#5c6a72"
