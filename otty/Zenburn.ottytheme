[meta]
name = "Zenburn"
mode = "dark"

[terminal]
foreground = "#dcdccc"
background = "#3f3f3f"
palette = [
    "#4d4d4d", "#7d5d5d", "#60b48a", "#f0dfaf",
    "#5d6d7d", "#dc8cc3", "#8cd0d3", "#dcdccc",
    "#709080", "#dca3a3", "#c3bf9f", "#e0cf9f",
    "#94bff3", "#ec93d3", "#93e0e3", "#ffffff",
]
cursor = "#73635a"
cursor-text = "#000000"
selection-background = "#21322f"
selection-foreground = "#c2d87a"
