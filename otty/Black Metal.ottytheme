[meta]
name = "Black Metal"
mode = "dark"

[terminal]
foreground = "#c1c1c1"
background = "#000000"
palette = [
    "#000000", "#486e6f", "#dd9999", "#a06666",
    "#888888", "#999999", "#aaaaaa", "#c1c1c1",
    "#404040", "#486e6f", "#dd9999", "#a06666",
    "#888888", "#999999", "#aaaaaa", "#c1c1c1",
]
cursor = "#c1c1c1"
cursor-text = "#8e8e8e"
selection-background = "#c1c1c1"
selection-foreground = "#000000"
