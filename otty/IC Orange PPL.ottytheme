[meta]
name = "IC Orange PPL"
mode = "dark"

[terminal]
foreground = "#ffcb83"
background = "#262626"
palette = [
    "#000000", "#c13900", "#a4a900", "#caaf00",
    "#bd6d00", "#fc5e00", "#f79500", "#ffc88a",
    "#6a4f2a", "#ff8c68", "#f6ff40", "#ffe36e",
    "#ffbe55", "#fc874f", "#c69752", "#fafaff",
]
cursor = "#fc531d"
cursor-text = "#ffc88a"
selection-background = "#c14020"
selection-foreground = "#ffc88a"
