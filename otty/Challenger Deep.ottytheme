[meta]
name = "Challenger Deep"
mode = "dark"

[terminal]
foreground = "#cbe1e7"
background = "#1e1c31"
palette = [
    "#141228", "#ff5458", "#62d196", "#ffb378",
    "#65b2ff", "#906cff", "#63f2f1", "#a6b3cc",
    "#565575", "#ff8080", "#95ffa4", "#ffe9aa",
    "#91ddff", "#c991e1", "#aaffe4", "#cbe3e7",
]
cursor = "#fbfcfc"
cursor-text = "#ff271d"
selection-background = "#cbe1e7"
selection-foreground = "#1e1c31"
