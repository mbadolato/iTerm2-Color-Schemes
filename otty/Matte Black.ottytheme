[meta]
name = "Matte Black"
mode = "dark"

[terminal]
foreground = "#bebebe"
background = "#121212"
palette = [
    "#333333", "#d35f5f", "#ffc107", "#b91c1c",
    "#e68e0d", "#d35f5f", "#bebebe", "#bebebe",
    "#8a8a8d", "#891c1c", "#ffc107", "#b90a0a",
    "#f59e0b", "#b91c1c", "#eaeaea", "#ffffff",
]
cursor = "#eaeaea"
cursor-text = "#121212"
selection-background = "#333333"
selection-foreground = "#eaeaea"
