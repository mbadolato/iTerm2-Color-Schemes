[meta]
name = "Squintless"
mode = "light"

[terminal]
foreground = "#3c3836"
background = "#f2e5bc"
palette = [
    "#f2e5bc", "#9d0006", "#79740e", "#b57614",
    "#076678", "#8f3f71", "#427b58", "#7c6f64",
    "#928374", "#9d0006", "#79740e", "#b57614",
    "#076678", "#8f3f71", "#427b58", "#3c3836",
]
cursor = "#282828"
cursor-text = "#f2e5bc"
selection-background = "#d5c4a1"
selection-foreground = "#3c3836"
