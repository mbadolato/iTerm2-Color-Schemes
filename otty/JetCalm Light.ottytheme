[meta]
name = "JetCalm Light"
mode = "light"
author = "mtueih (https://github.com/mtueih)"

[terminal]
foreground = "#1c2410"
background = "#ededed"
palette = [
    "#383a42", "#a52a2a", "#556b2f", "#5c3e00",
    "#4682b4", "#a626a4", "#0997b3", "#6b8e23",
    "#4f525d", "#df6c75", "#2e8b57", "#808000",
    "#008080", "#c577dd", "#008080", "#7b8d9e",
]
cursor = "#082108"
cursor-text = "#ededed"
selection-background = "#3c444d"
selection-foreground = "#ededed"
