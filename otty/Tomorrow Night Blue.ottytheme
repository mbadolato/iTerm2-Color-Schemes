[meta]
name = "Tomorrow Night Blue"
mode = "dark"

[terminal]
foreground = "#ffffff"
background = "#002451"
palette = [
    "#000000", "#ff9da4", "#d1f1a9", "#ffeead",
    "#bbdaff", "#ebbbff", "#99ffff", "#ffffff",
    "#4c4c4c", "#ff9da4", "#d1f1a9", "#ffeead",
    "#bbdaff", "#ebbbff", "#99ffff", "#ffffff",
]
cursor = "#ffffff"
cursor-text = "#003f8e"
selection-background = "#003f8e"
selection-foreground = "#ffffff"
