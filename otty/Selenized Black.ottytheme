[meta]
name = "Selenized Black"
mode = "dark"
author = "Jan Warchoł (https://github.com/jan-warchol/selenized)"

[terminal]
foreground = "#b9b9b9"
background = "#181818"
palette = [
    "#252525", "#ed4a46", "#70b433", "#dbb32d",
    "#368aeb", "#eb6eb7", "#3fc5b7", "#b9b9b9",
    "#777777", "#ff5e56", "#83c746", "#efc541",
    "#4f9cfe", "#ff81ca", "#56d8c9", "#dedede",
]
cursor = "#777777"
cursor-text = "#181818"
selection-background = "#3b3b3b"
selection-foreground = "#646464"
