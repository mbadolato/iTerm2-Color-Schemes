[meta]
name = "Rainbows and Unicorns Den"
mode = "dark"

[terminal]
foreground = "#ebd9b8"
background = "#1e150d"
palette = [
    "#2e2115", "#d9583b", "#9db85c", "#e0a030",
    "#6f9fb8", "#b87a9a", "#7fb0a0", "#cdbb98",
    "#7d6a50", "#d98036", "#bbd47e", "#f0be5c",
    "#95bdd2", "#d29cb8", "#a2cdbf", "#fff3da",
]
cursor = "#e0a030"
cursor-text = "#1e150d"
selection-background = "#e0a030"
selection-foreground = "#1e150d"
