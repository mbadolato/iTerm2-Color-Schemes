[meta]
name = "Aubade"
mode = "light"

[terminal]
foreground = "#3a3340"
background = "#fbf6fb"
palette = [
    "#33293f", "#c0303a", "#2e7d6e", "#8c610c",
    "#4a3cc0", "#8a4bc0", "#ae3f84", "#b2b2b2",
    "#9a8fa8", "#c0303a", "#2e7d6e", "#ae3f84",
    "#4a3cc0", "#d8b670", "#ae3f84", "#3a3340",
]
cursor = "#ae3f84"
