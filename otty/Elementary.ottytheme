[meta]
name = "Elementary"
mode = "dark"

[terminal]
foreground = "#efefef"
background = "#181818"
palette = [
    "#242424", "#d71c15", "#5aa513", "#fdb40c",
    "#134899", "#e40038", "#2595e1", "#efefef",
    "#4b4b4b", "#fc1c18", "#6bc219", "#fec80e",
    "#0955ff", "#fb0050", "#3ea8fc", "#8c00ec",
]
cursor = "#bbbbbb"
cursor-text = "#ffffff"
selection-background = "#b5d5ff"
selection-foreground = "#000000"
