[meta]
name = "Misterioso"
mode = "dark"

[terminal]
foreground = "#e1e1e0"
background = "#2d3743"
palette = [
    "#000000", "#ff4242", "#74af68", "#ffad29",
    "#338f86", "#9414e6", "#23d7d7", "#e1e1e0",
    "#626262", "#ff3242", "#74cd68", "#ffb929",
    "#23d7d7", "#ff37ff", "#00ede1", "#ffffff",
]
cursor = "#666666"
cursor-text = "#ffffff"
selection-background = "#2d37ff"
selection-foreground = "#000000"
