[meta]
name = "Guezwhoz"
mode = "dark"

[terminal]
foreground = "#d9d9d9"
background = "#1d1d1d"
palette = [
    "#333333", "#e85181", "#7ad694", "#b7d074",
    "#5aa0d6", "#9a90e0", "#58d6ce", "#d9d9d9",
    "#808080", "#e85181", "#afd7af", "#d1ed85",
    "#64b2ed", "#a398ed", "#61ede4", "#ededed",
]
cursor = "#99d4b1"
cursor-text = "#1d1d1d"
selection-background = "#245354"
selection-foreground = "#58d6ce"
