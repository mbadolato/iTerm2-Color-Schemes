[meta]
name = "Solarized Dark Patched"
mode = "dark"

[terminal]
foreground = "#708284"
background = "#001e27"
palette = [
    "#002831", "#d11c24", "#738a05", "#a57706",
    "#2176c7", "#c61c6f", "#259286", "#eae3cb",
    "#475b62", "#bd3613", "#475b62", "#536870",
    "#708284", "#5956ba", "#819090", "#fcf4dc",
]
cursor = "#708284"
cursor-text = "#002831"
selection-background = "#002831"
selection-foreground = "#819090"
