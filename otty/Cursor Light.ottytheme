[meta]
name = "Cursor Light"
mode = "light"

[terminal]
foreground = "#252525"
background = "#f3f3f3"
palette = [
    "#252525", "#cf2d56", "#1f8a65", "#a16900",
    "#3c7cab", "#b8448b", "#4c7f8c", "#afafaf",
    "#5c5c5c", "#e75e78", "#55a583", "#c08532",
    "#6299c3", "#d06ba6", "#6f9ba6", "#ffffff",
]
cursor = "#252525"
cursor-text = "#f3f3f3"
selection-background = "#d9d9d9"
selection-foreground = "#252525"
