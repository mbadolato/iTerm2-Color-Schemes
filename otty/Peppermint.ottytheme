[meta]
name = "Peppermint"
mode = "dark"

[terminal]
foreground = "#c8c8c8"
background = "#000000"
palette = [
    "#353535", "#e74669", "#89d287", "#dab853",
    "#449fd0", "#da62dc", "#65aaaf", "#b4b4b4",
    "#535353", "#e4859b", "#a3cca2", "#e1e487",
    "#6fbce2", "#e586e7", "#96dcdb", "#dfdfdf",
]
cursor = "#bbbbbb"
cursor-text = "#ffffff"
selection-background = "#e6e6e6"
selection-foreground = "#000000"
