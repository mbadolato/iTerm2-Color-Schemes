[meta]
name = "X Lahabana"
mode = "dark"

[terminal]
foreground = "#f7f1ff"
background = "#19191a"
palette = [
    "#19191a", "#fc618d", "#7bd88f", "#e5ff9d",
    "#fd9353", "#948ae3", "#5ad4e6", "#f7f1ff",
    "#4c4c4d", "#fc618d", "#7bd88f", "#e5ff9d",
    "#fd9353", "#948ae3", "#5ad4e6", "#f7f1ff",
]
cursor = "#f7f1ff"
