    "#272822", "#f92672", "#a6e22e", "#e6db74",
    "#fd971f", "#ae81ff", "#66d9ef", "#fdfff1",
    "#6e7066", "#f92672", "#a6e22e", "#e6db74",
    "#fd971f", "#ae81ff", "#66d9ef", "#fdfff1",
]
cursor = "#c0c1b5"
