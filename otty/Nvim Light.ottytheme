[meta]
name = "Nvim Light"
mode = "light"

[terminal]
foreground = "#14161b"
background = "#e0e2ea"
palette = [
    "#07080d", "#590008", "#005523", "#6b5300",
    "#004c73", "#470045", "#007373", "#a1a4ab",
    "#4f5258", "#590008", "#005523", "#6b5300",
    "#004c73", "#470045", "#007373", "#eef1f8",
]
cursor = "#9b9ea4"
cursor-text = "#14161b"
selection-background = "#9b9ea4"
selection-foreground = "#14161b"
