[meta]
name = "Oxide"
mode = "dark"
author = "jakmaz (https://github.com/jakmaz)"

[terminal]
foreground = "#cecece"
background = "#161616"
palette = [
    "#262626", "#ed756e", "#5bb661", "#c39900",
    "#3ba6f5", "#968ff7", "#00baaa", "#cecece",
    "#8f8f8f", "#ff9890", "#7bd77f", "#e3b831",
    "#6fc6ff", "#b5b2ff", "#00dcca", "#dedede",
]
cursor = "#cecece"
cursor-text = "#161616"
selection-background = "#262626"
selection-foreground = "#cecece"
