[meta]
name = "Dark 2026"
mode = "dark"
author = "Microsoft (https://github.com/microsoft/vscode)"

[terminal]
foreground = "#cccccc"
background = "#191a1b"
palette = [
    "#000000", "#cd3131", "#0dbc79", "#e5e510",
    "#2472c8", "#bc3fbc", "#11a8cd", "#e5e5e5",
    "#666666", "#f14c4c", "#23d18b", "#f5f543",
    "#3b8eea", "#d670d6", "#29b8db", "#e5e5e5",
]
cursor = "#bfbfbf"
cursor-text = "#191a1b"
selection-background = "#1f323b"
selection-foreground = "#cccccc"
