[meta]
name = "Box"
mode = "dark"

[terminal]
foreground = "#9fef00"
background = "#141d2b"
palette = [
    "#000000", "#cc0403", "#19cb00", "#cecb00",
    "#0d73cc", "#cb1ed1", "#0dcdcd", "#dddddd",
    "#767676", "#f2201f", "#23fd00", "#fffd00",
    "#1a8fff", "#fd28ff", "#14ffff", "#ffffff",
]
cursor = "#9fef00"
cursor-text = "#111111"
selection-background = "#a4b1cd"
selection-foreground = "#141d2b"
