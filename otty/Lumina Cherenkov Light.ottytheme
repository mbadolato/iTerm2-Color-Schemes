[meta]
name = "Lumina Cherenkov Light"
mode = "light"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#1e2735"
background = "#f2f8fc"
palette = [
    "#1e2735", "#cb3f3c", "#4a7d26", "#a35f00",
    "#2c516b", "#814a8d", "#00697b", "#677182",
    "#65707d", "#9e423d", "#3b671b", "#874e00",
    "#003e60", "#6d347a", "#005462", "#8590a2",
]
cursor = "#1e2735"
cursor-text = "#f2f8fc"
selection-background = "#bfccf0"
selection-foreground = "#1e2735"
