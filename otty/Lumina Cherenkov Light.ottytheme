[meta]
name = "Lumina Cherenkov Light"
mode = "light"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#1f2e53"
background = "#f5f8ff"
palette = [
    "#1f2e53", "#a32224", "#227a3e", "#a35f00",
    "#0a4fcc", "#90478a", "#087181", "#5e709b",
    "#5b6b89", "#792825", "#07652c", "#874e00",
    "#1d448f", "#793474", "#005c69", "#7c90bc",
]
cursor = "#1f2e53"
cursor-text = "#f5f8ff"
selection-background = "#b3d0f4"
selection-foreground = "#1f2e53"
