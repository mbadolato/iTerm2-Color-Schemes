[meta]
name = "iTerm2 Pastel Dark Background"
mode = "dark"

[terminal]
foreground = "#c7c7c7"
background = "#000000"
palette = [
    "#626262", "#ff8373", "#b4fb73", "#fffdc3",
    "#a5d5fe", "#ff90fe", "#d1d1fe", "#f1f1f1",
    "#8f8f8f", "#ffc4be", "#d6fcba", "#fffed5",
    "#c2e3ff", "#ffb2fe", "#e6e6fe", "#ffffff",
]
cursor = "#ffb473"
cursor-text = "#8c8c8c"
selection-background = "#454d96"
selection-foreground = "#f4f4f4"
