[meta]
name = "mistpine"
mode = "dark"
author = "Luan Utimura (https://github.com/mistpine/mistpine)"

[terminal]
foreground = "#c4c9d0"
background = "#0b1f27"
palette = [
    "#0f272e", "#be7356", "#8a9a5b", "#c2a55b",
    "#6f8fa8", "#9a88a8", "#5f9a96", "#a7b0bb",
    "#546b76", "#d08a6e", "#a9b97a", "#dcc27e",
    "#93afc4", "#b8a8c6", "#86bcb6", "#d0d1d6",
]
cursor = "#c4c9d0"
cursor-text = "#0b1f27"
selection-background = "#26414a"
selection-foreground = "#d0d1d6"
