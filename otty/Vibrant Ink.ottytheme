[meta]
name = "Vibrant Ink"
mode = "dark"

[terminal]
foreground = "#ffffff"
background = "#000000"
palette = [
    "#878787", "#ff6600", "#ccff04", "#ffcc00",
    "#44b4cc", "#9933cc", "#44b4cc", "#f5f5f5",
    "#555555", "#ff0000", "#00ff00", "#ffff00",
    "#0000ff", "#ff00ff", "#00ffff", "#e5e5e5",
]
cursor = "#ffffff"
cursor-text = "#000000"
selection-background = "#b5d5ff"
selection-foreground = "#000000"
