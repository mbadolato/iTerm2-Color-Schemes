[meta]
name = "Hadal Bloom"
mode = "dark"

[terminal]
foreground = "#d6eaf0"
background = "#091923"
palette = [
    "#142a35", "#d97494", "#65bfa7", "#c7b87c",
    "#6e9cd6", "#a995ed", "#4abfc6", "#bfd6df",
    "#42606d", "#f3a0bc", "#87e3c2", "#e7d89d",
    "#94bef6", "#c9b5ff", "#76eaf0", "#f1fcff",
]
cursor = "#59d9cb"
cursor-text = "#091923"
selection-background = "#214454"
selection-foreground = "#62727c"
