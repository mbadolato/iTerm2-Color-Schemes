[meta]
name = "Pumpkin Spice"
mode = "dark"

[terminal]
foreground = "#fff0d8"
background = "#9a3d08"
palette = [
    "#d6d3d1", "#dbd1ce", "#d1d7cf", "#d9d4c8",
    "#ced5d9", "#dad3db", "#cbd5d7", "#fff0d8",
    "#d7d3d1", "#f5e2dc", "#d1d7d0", "#f6e5c8",
    "#ced6d9", "#d9d1d9", "#cbd6d7", "#fff2dd",
]
cursor = "#dbd1ce"
cursor-text = "#9a3d08"
selection-background = "#d7d3d1"
selection-foreground = "#a69984"
