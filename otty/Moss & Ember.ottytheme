[meta]
name = "Moss & Ember"
mode = "dark"

[terminal]
foreground = "#e9ddc6"
background = "#18231f"
palette = [
    "#26342c", "#c5755e", "#829d69", "#c6a667",
    "#799ca0", "#ad8a9b", "#72a69b", "#d8ceb9",
    "#586a59", "#e69a75", "#a9bd79", "#e4c481",
    "#9ebcc0", "#c8a4b6", "#92cec0", "#fff0d6",
]
cursor = "#d98a59"
cursor-text = "#18231f"
selection-background = "#36483a"
selection-foreground = "#646f6b"
