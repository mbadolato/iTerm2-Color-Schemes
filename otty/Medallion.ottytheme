[meta]
name = "Medallion"
mode = "dark"

[terminal]
foreground = "#cac296"
background = "#1d1908"
palette = [
    "#000000", "#b64c00", "#7c8b16", "#d3bd26",
    "#616bb0", "#8c5a90", "#916c25", "#cac29a",
    "#5e5219", "#ff9149", "#b2ca3b", "#ffe54a",
    "#acb8ff", "#ffa0ff", "#ffbc51", "#fed698",
]
cursor = "#d3ba30"
cursor-text = "#fffc7d"
selection-background = "#626dac"
selection-foreground = "#cac29a"
