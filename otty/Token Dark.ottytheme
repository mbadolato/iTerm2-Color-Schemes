[meta]
name = "Token Dark"
mode = "dark"

[terminal]
foreground = "#e8e4dc"
background = "#262624"
palette = [
    "#1d1d1c", "#c67777", "#7da47a", "#c4a855",
    "#7b9ebd", "#a68bbf", "#6ba8a8", "#d4cfc6",
    "#5a5955", "#d97757", "#98bf95", "#c4956a",
    "#96b8d3", "#bea5d4", "#88c0c0", "#e8e4dc",
]
cursor = "#e8e4dc"
cursor-text = "#262624"
selection-background = "#3a3a37"
selection-foreground = "#e8e4dc"
