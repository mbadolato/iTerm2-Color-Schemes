[meta]
name = "Noctis Uva"
mode = "dark"
author = "Liviu Schera (https://github.com/liviuschera), ported by Abel Dantas (https://github.com/abeldantas)"

[terminal]
foreground = "#c5c2d6"
background = "#292640"
palette = [
    "#302f3d", "#e66533", "#49e9a6", "#e4b781",
    "#49ace9", "#df769b", "#49d6e9", "#b6b3cc",
    "#504e65", "#e97749", "#60ebb1", "#e69533",
    "#60b6eb", "#e798b3", "#60dbeb", "#c5c2d6",
]
cursor = "#c5c2d6"
cursor-text = "#292640"
selection-background = "#35325a"
selection-foreground = "#c5c2d6"
