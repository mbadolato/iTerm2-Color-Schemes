[meta]
name = "Springfield Resident"
mode = "light"

[terminal]
foreground = "#084f8f"
background = "#ffdd32"
palette = [
    "#252b32", "#b83245", "#237a3b", "#8a5a00",
    "#075aa8", "#a92d87", "#00748a", "#5b5960",
    "#555a61", "#c63d4d", "#2b8243", "#765000",
    "#1267b8", "#b33792", "#007c91", "#4a4d52",
]
cursor = "#1687e0"
cursor-text = "#ffef73"
selection-background = "#ef4fa8"
selection-foreground = "#24205f"
