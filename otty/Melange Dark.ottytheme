[meta]
name = "Melange Dark"
mode = "dark"

[terminal]
foreground = "#ece1d7"
background = "#292522"
palette = [
    "#34302c", "#bd8183", "#78997a", "#e49b5d",
    "#7f91b2", "#b380b0", "#7b9695", "#c1a78e",
    "#867462", "#d47766", "#85b695", "#ebc06d",
    "#a3a9ce", "#cf9bc2", "#89b3b6", "#ece1d7",
]
cursor = "#ece1d7"
cursor-text = "#292522"
selection-background = "#ece1d7"
selection-foreground = "#403a36"
