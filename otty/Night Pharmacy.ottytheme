[meta]
name = "Night Pharmacy"
mode = "dark"

[terminal]
foreground = "#ecf5ef"
background = "#07100b"
palette = [
    "#afbeb5", "#ef8088", "#72d1a0", "#e6cb69",
    "#83b3e7", "#cba0df", "#72d3d0", "#ecf5ef",
    "#c4d0c9", "#f19ba1", "#91dfb7", "#eddb8b",
    "#a3c8ef", "#dabbe8", "#94e2df", "#ffffff",
]
cursor = "#7ff0bd"
cursor-text = "#07100b"
selection-background = "#173425"
selection-foreground = "#f5fff8"
