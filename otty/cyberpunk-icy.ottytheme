[meta]
name = "cyberpunk-icy"
mode = "dark"

[terminal]
foreground = "#d4b3f7"
background = "#0a0a0f"
palette = [
    "#1a1a2e", "#ff0055", "#00ff9f", "#fffc00",
    "#7b2fff", "#ff00ff", "#00ffff", "#d4b3f7",
    "#444468", "#ff3377", "#33ffb2", "#fffe33",
    "#9955ff", "#ff55ff", "#55ffff", "#ffffff",
]
cursor = "#00ffff"
cursor-text = "#0a0a0f"
selection-background = "#004d4d"
selection-foreground = "#0a0a0f"
