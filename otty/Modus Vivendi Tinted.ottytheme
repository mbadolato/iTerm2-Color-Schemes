[meta]
name = "Modus Vivendi Tinted"
mode = "dark"
author = "Protesilaos Stavrou (https://protesilaos.com/)"

[terminal]
foreground = "#ffffff"
background = "#0d0e1c"
palette = [
    "#0d0e1c", "#ff5f59", "#44bc44", "#d0bc00",
    "#2fafff", "#feacd0", "#00d3d0", "#a6a6a6",
    "#595959", "#ff6b55", "#00c06f", "#fec43f",
    "#79a8ff", "#b6a0ff", "#6ae4b9", "#ffffff",
]
cursor = "#ff66ff"
cursor-text = "#0d0e1c"
selection-background = "#555a66"
selection-foreground = "#ffffff"
