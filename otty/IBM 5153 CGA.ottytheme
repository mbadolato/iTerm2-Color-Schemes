[meta]
name = "IBM 5153 CGA"
mode = "dark"
author = "(https://jmiller.com/)"

[terminal]
foreground = "#cecece"
background = "#141414"
palette = [
    "#141414", "#d03333", "#1bd01b", "#d08c1b",
    "#1b1bd0", "#d01bd0", "#1bd0d0", "#cecece",
    "#4e4e4e", "#dc4e4e", "#4edc4e", "#f3f34e",
    "#4e4edc", "#f34ef3", "#4ef3f3", "#ffffff",
]
cursor = "#cecece"
cursor-text = "#141414"
selection-background = "#cecece"
selection-foreground = "#141414"
