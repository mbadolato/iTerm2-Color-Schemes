[meta]
name = "Paranoid Circuit"
mode = "dark"

[terminal]
foreground = "#f2e9d3"
background = "#27322b"
palette = [
    "#aaa9a1", "#dc9771", "#a7c67c", "#d5bd6e",
    "#9cb4b5", "#c69cce", "#9ac7ae", "#eee3cd",
    "#c4c0b4", "#e9aa82", "#bcd992", "#e8d084",
    "#aec8c6", "#d7b2dc", "#afd8c1", "#fff3df",
]
cursor = "#edc179"
cursor-text = "#27322b"
selection-background = "#4b4a3b"
selection-foreground = "#ffffff"
