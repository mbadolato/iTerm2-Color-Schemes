[meta]
name = "Raycast Dark"
mode = "dark"

[terminal]
foreground = "#ffffff"
background = "#1a1a1a"
palette = [
    "#000000", "#ff5360", "#59d499", "#ffc531",
    "#56c2ff", "#cf2f98", "#52eee5", "#ffffff",
    "#4c4c4c", "#ff6363", "#59d499", "#ffc531",
    "#56c2ff", "#cf2f98", "#52eee5", "#ffffff",
]
cursor = "#cccccc"
cursor-text = "#999999"
selection-background = "#333333"
selection-foreground = "#595959"
