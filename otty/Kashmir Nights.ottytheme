[meta]
name = "Kashmir Nights"
mode = "dark"

[terminal]
foreground = "#f4dfc9"
background = "#291714"
palette = [
    "#b4a29a", "#dc805e", "#b6b18a", "#e6b46a",
    "#9cacc1", "#b5a0b7", "#a6b6ad", "#f4dfc9",
    "#c9b8a9", "#f09b72", "#cbc59d", "#f7cc82",
    "#b5c2d2", "#ceb5d0", "#bcd1c1", "#fff0dd",
]
cursor = "#f1bb72"
cursor-text = "#291714"
selection-background = "#604136"
selection-foreground = "#fff9ed"
