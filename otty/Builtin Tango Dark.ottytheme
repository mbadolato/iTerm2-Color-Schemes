[meta]
name = "Builtin Tango Dark"
mode = "dark"

[terminal]
foreground = "#ffffff"
background = "#000000"
palette = [
    "#000000", "#cc0000", "#4e9a06", "#c4a000",
    "#3465a4", "#75507b", "#06989a", "#d3d7cf",
    "#555753", "#ef2929", "#8ae234", "#fce94f",
    "#729fcf", "#ad7fa8", "#34e2e2", "#eeeeec",
]
cursor = "#ffffff"
cursor-text = "#000000"
selection-background = "#b5d5ff"
selection-foreground = "#000000"
