[meta]
name = "Duskfox"
mode = "dark"

[terminal]
foreground = "#e0def4"
background = "#232136"
palette = [
    "#393552", "#eb6f92", "#a3be8c", "#f6c177",
    "#569fba", "#c4a7e7", "#9ccfd8", "#e0def4",
    "#544d8a", "#f083a2", "#b1d196", "#f9cb8c",
    "#65b1cd", "#ccb1ed", "#a6dae3", "#e2e0f7",
]
cursor = "#e0def4"
cursor-text = "#232136"
selection-background = "#433c59"
selection-foreground = "#e0def4"
