[meta]
name = "Apple Classic"
mode = "dark"

[terminal]
foreground = "#d5a200"
background = "#2c2b2b"
palette = [
    "#000000", "#c91b00", "#00c200", "#c7c400",
    "#1c3fe1", "#ca30c7", "#00c5c7", "#c7c7c7",
    "#686868", "#ff6e67", "#5ffa68", "#fffc67",
    "#6871ff", "#ff77ff", "#60fdff", "#ffffff",
]
cursor = "#c7c7c7"
cursor-text = "#8c8c8c"
selection-background = "#6b5b02"
selection-foreground = "#67e000"
