[meta]
name = "Sea Shells"
mode = "dark"

[terminal]
foreground = "#deb88d"
background = "#09141b"
palette = [
    "#17384c", "#d15123", "#027c9b", "#fca02f",
    "#1e4950", "#68d4f1", "#50a3b5", "#deb88d",
    "#434b53", "#d48678", "#628d98", "#fdd39f",
    "#1bbcdd", "#bbe3ee", "#87acb4", "#fee4ce",
]
cursor = "#fca02f"
cursor-text = "#08131a"
selection-background = "#1e4962"
selection-foreground = "#fee4ce"
