[meta]
name = "Thayer Bright"
mode = "dark"

[terminal]
foreground = "#f8f8f8"
background = "#1b1d1e"
palette = [
    "#1b1d1e", "#f92672", "#4df840", "#f4fd22",
    "#2757d6", "#8c54fe", "#38c8b5", "#ccccc6",
    "#505354", "#ff5995", "#b6e354", "#feed6c",
    "#3f78ff", "#9e6ffe", "#23cfd5", "#f8f8f2",
]
cursor = "#fc971f"
cursor-text = "#000000"
selection-background = "#4d4d4d"
selection-foreground = "#ffffff"
