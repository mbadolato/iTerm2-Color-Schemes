[meta]
name = "SeedFlip Phosphor"
mode = "dark"

[terminal]
foreground = "#b3ffb3"
background = "#0c0c0c"
palette = [
    "#070707", "#f04242", "#42f07c", "#f0d342",
    "#428bf0", "#f042f0", "#42f0f0", "#cdffcd",
    "#3f3f3f", "#f58989", "#89f5ad", "#f5e389",
    "#89b6f5", "#f589f5", "#89f5f5", "#ffffff",
]
cursor = "#00ff88"
cursor-text = "#0c0c0c"
selection-background = "#141414"
selection-foreground = "#b3ffb3"
