[meta]
name = "Fahrenheit"
mode = "dark"

[terminal]
foreground = "#ffffce"
background = "#000000"
palette = [
    "#1d1d1d", "#cda074", "#9e744d", "#fecf75",
    "#7f0e0f", "#734c4d", "#979797", "#ffffce",
    "#404040", "#fecea0", "#cc734d", "#fd9f4d",
    "#cb4a05", "#4e739f", "#fed04d", "#ffffff",
]
cursor = "#bbbbbb"
cursor-text = "#ffffff"
selection-background = "#4e739f"
selection-foreground = "#ffffce"
