[meta]
name = "Sonoran Afterglow"
mode = "dark"

[terminal]
foreground = "#ede1d9"
background = "#201a2b"
palette = [
    "#30283a", "#d66d73", "#83ad89", "#d9ae69",
    "#819cd3", "#b78ec5", "#67b8b0", "#d8ccc7",
    "#67586d", "#f47c65", "#a5d0a3", "#f2cb82",
    "#a5baf1", "#d7ace0", "#86e0d3", "#fff1e3",
]
cursor = "#e9b872"
cursor-text = "#201a2b"
selection-background = "#49364c"
selection-foreground = "#6c6677"
