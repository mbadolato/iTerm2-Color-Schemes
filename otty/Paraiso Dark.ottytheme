[meta]
name = "Paraiso Dark"
mode = "dark"

[terminal]
foreground = "#a39e9b"
background = "#2f1e2e"
palette = [
    "#2f1e2e", "#ef6155", "#48b685", "#fec418",
    "#06b6ef", "#815ba4", "#5bc4bf", "#a39e9b",
    "#776e71", "#ef6155", "#48b685", "#fec418",
    "#06b6ef", "#815ba4", "#5bc4bf", "#e7e9db",
]
cursor = "#a39e9b"
cursor-text = "#2f1e2e"
selection-background = "#4f424c"
selection-foreground = "#a39e9b"
