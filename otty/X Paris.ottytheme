[meta]
name = "X Paris"
mode = "dark"

[terminal]
foreground = "#f7f1ff"
background = "#1a0a30"
palette = [
    "#1a0a30", "#fc618d", "#7bd88f", "#fce566",
    "#a3f3ff", "#c4bdff", "#a3f3ff", "#4d3d63",
    "#c4bdff", "#fc618d", "#7bd88f", "#fce566",
    "#a3f3ff", "#c4bdff", "#a3f3ff", "#f7f1ff",
]
cursor = "#f7f1ff"
cursor-text = "#1a0a30"
selection-background = "#f7f1ff"
selection-foreground = "#1a0a30"
