[meta]
name = "Miami Heat"
mode = "dark"

[terminal]
foreground = "#fce7ff"
background = "#120b2e"
palette = [
    "#2a1a4a", "#ff3d7f", "#2ee6b6", "#ffcb52",
    "#29b6ff", "#b86bff", "#18e0ff", "#e6d4ff",
    "#5e5388", "#ff2e97", "#2ee6b6", "#ff7847",
    "#29b6ff", "#b86bff", "#18e0ff", "#fce7ff",
]
cursor = "#ff2e97"
