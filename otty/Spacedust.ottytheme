[meta]
name = "Spacedust"
mode = "dark"

[terminal]
foreground = "#ecf0c1"
background = "#0a1e24"
palette = [
    "#6e5346", "#e35b00", "#5cab96", "#e3cd7b",
    "#0f548b", "#e35b00", "#06afc7", "#f0f1ce",
    "#684c31", "#ff8a3a", "#aecab8", "#ffc878",
    "#67a0ce", "#ff8a3a", "#83a7b4", "#fefff1",
]
cursor = "#708284"
cursor-text = "#002831"
selection-background = "#0a385c"
selection-foreground = "#ffffff"
