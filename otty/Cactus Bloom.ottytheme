[meta]
name = "Cactus Bloom"
mode = "light"

[terminal]
foreground = "#111a11"
background = "#fff9f0"
palette = [
    "#292d29", "#8c1b1b", "#0d5b30", "#684b00",
    "#174b9a", "#612d8e", "#005b69", "#3a403a",
    "#464c46", "#961f1f", "#106234", "#704f00",
    "#123a78", "#693696", "#004a57", "#454b45",
]
cursor = "#0b6897"
cursor-text = "#fff9f0"
selection-background = "#f1dcc4"
selection-foreground = "#111a11"
