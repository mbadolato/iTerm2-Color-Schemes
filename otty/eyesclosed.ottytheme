[meta]
name = "eyesclosed"
mode = "dark"
author = "thdxg (https://github.com/thdxg/eyesclosed)"

[terminal]
foreground = "#bbbcc7"
background = "#111214"
palette = [
    "#383b4a", "#ffaba2", "#779bb0", "#ecd8ae",
    "#b7c8cb", "#9a9dae", "#d8d0d0", "#bbbcc7",
    "#696d7d", "#ffaba2", "#779bb0", "#ecd8ae",
    "#b7c8cb", "#9a9dae", "#d8d0d0", "#cdcfd1",
]
cursor = "#cdcfd1"
cursor-text = "#111214"
selection-background = "#383b4a"
selection-foreground = "#bbbcc7"
