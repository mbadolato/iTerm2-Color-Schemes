[meta]
name = "Neobones Dark"
mode = "dark"

[terminal]
foreground = "#c6d5cf"
background = "#0f191f"
palette = [
    "#0f191f", "#de6e7c", "#90ff6b", "#b77e64",
    "#8190d4", "#b279a7", "#66a5ad", "#c6d5cf",
    "#334652", "#e8838f", "#a0ff85", "#d68c67",
    "#92a0e2", "#cf86c1", "#65b8c1", "#98a39e",
]
cursor = "#ceddd7"
cursor-text = "#0f191f"
selection-background = "#3a3e3d"
selection-foreground = "#c6d5cf"
