[meta]
name = "Blue Matrix"
mode = "dark"

[terminal]
foreground = "#00a2ff"
background = "#101116"
palette = [
    "#101116", "#ff5680", "#00ff9c", "#fffc58",
    "#00b0ff", "#d57bff", "#76c1ff", "#c7c7c7",
    "#686868", "#ff6e67", "#5ffa68", "#fffc67",
    "#6871ff", "#d682ec", "#60fdff", "#ffffff",
]
cursor = "#76ff9f"
cursor-text = "#a6a6a6"
selection-background = "#c1deff"
selection-foreground = "#000000"
