[meta]
name = "Clockwork Gold"
mode = "dark"

[terminal]
foreground = "#ebe8e0"
background = "#1d1c19"
palette = [
    "#1d1c19", "#e94b4a", "#73c881", "#ffcc00",
    "#4fa3f4", "#ef3ead", "#64c3c3", "#a9a69d",
    "#4c4b47", "#ff716b", "#88e196", "#c89f00",
    "#76c0ff", "#ff68c6", "#82e1e0", "#fcfaf4",
]
cursor = "#ffcc00"
cursor-text = "#1d1c19"
selection-background = "#4c4b47"
selection-foreground = "#fcfaf4"
