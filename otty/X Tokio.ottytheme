[meta]
name = "X Tokio"
mode = "dark"

[terminal]
foreground = "#f7f1ff"
background = "#1c1c1d"
palette = [
    "#1c1c1d", "#fc618d", "#7bd88f", "#fce566",
    "#fd9353", "#948ae3", "#5ad4e6", "#f7f1ff",
    "#4f4f50", "#fc618d", "#7bd88f", "#fce566",
    "#fd9353", "#948ae3", "#5ad4e6", "#f7f1ff",
]
cursor = "#f7f1ff"
cursor-text = "#1c1c1d"
selection-background = "#f7f1ff"
selection-foreground = "#1c1c1d"
