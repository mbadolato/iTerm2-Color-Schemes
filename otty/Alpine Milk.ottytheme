[meta]
name = "Alpine Milk"
mode = "light"

[terminal]
foreground = "#333940"
background = "#fafafa"
palette = [
    "#333940", "#c94f46", "#4a9256", "#b28422",
    "#3d7cc9", "#8a5fb0", "#2e8fa0", "#b1b4b8",
    "#757d86", "#e0655b", "#58ab66", "#c9982e",
    "#5292dd", "#a075c6", "#3ba6b8", "#ffffff",
]
cursor = "#4a90d9"
cursor-text = "#ffffff"
selection-background = "#d6e6f7"
selection-foreground = "#333940"
