[meta]
name = "Ghost Circuit"
mode = "dark"

[terminal]
foreground = "#e9f4f0"
background = "#07100f"
palette = [
    "#aebfba", "#ed7f86", "#72d2a2", "#e7cc69",
    "#82b3e8", "#caa0df", "#72d3d1", "#e9f4f0",
    "#c4d0cc", "#f09ba0", "#91dfb8", "#eddc8b",
    "#a2c8ef", "#dabbe8", "#94e2df", "#ffffff",
]
cursor = "#7ce4df"
cursor-text = "#07100f"
selection-background = "#1d3430"
selection-foreground = "#f4fffb"
