[meta]
name = "Selenized Dark"
mode = "dark"

[terminal]
foreground = "#adbcbc"
background = "#103c48"
palette = [
    "#184956", "#fa5750", "#75b938", "#dbb32d",
    "#4695f7", "#f275be", "#41c7b9", "#adbcbc",
    "#72898f", "#ff665c", "#84c747", "#ebc13d",
    "#58a3ff", "#ff84cd", "#53d6c7", "#cad8d9",
]
cursor = "#adbcbc"
cursor-text = "#103c48"
selection-background = "#184956"
selection-foreground = "#53d6c7"
