[meta]
name = "Terminal Basic Dark"
mode = "dark"

[terminal]
foreground = "#ffffff"
background = "#1d1e1d"
palette = [
    "#000000", "#c65339", "#6ac44b", "#b8b74a",
    "#6444ed", "#d357db", "#69c1cf", "#d1d1d1",
    "#909090", "#eb5a3a", "#77ea51", "#efef53",
    "#d09af9", "#eb5af7", "#78f1f2", "#ededed",
]
cursor = "#9d9d9d"
cursor-text = "#1d1e1d"
selection-background = "#3f638a"
selection-foreground = "#ffffff"
