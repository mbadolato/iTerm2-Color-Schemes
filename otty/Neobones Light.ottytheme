[meta]
name = "Neobones Light"
mode = "light"

[terminal]
foreground = "#202e18"
background = "#e5ede6"
palette = [
    "#e5ede6", "#a8334c", "#567a30", "#944927",
    "#286486", "#88507d", "#3b8992", "#202e18",
    "#99ac9c", "#94253e", "#3f5a22", "#803d1c",
    "#1d5573", "#7b3b70", "#2b747c", "#415934",
]
cursor = "#202e18"
cursor-text = "#e5ede6"
selection-background = "#ade48c"
selection-foreground = "#202e18"
