[meta]
name = "Zacess Warm Light"
mode = "light"

[terminal]
foreground = "#342410"
background = "#f4ead5"
palette = [
    "#342410", "#8c1a16", "#275200", "#6a4603",
    "#014b79", "#742c60", "#05514d", "#574e44",
    "#60574c", "#a4332b", "#386616", "#845701",
    "#115f93", "#8a4074", "#066662", "#342410",
]
cursor = "#5b1301"
cursor-text = "#f4ead5"
selection-background = "#215779"
selection-foreground = "#f4ead5"
