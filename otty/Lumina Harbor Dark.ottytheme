[meta]
name = "Lumina Harbor Dark"
mode = "dark"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#dde1eb"
background = "#0d111d"
palette = [
    "#111523", "#d0756c", "#9bd8b4", "#eace8c",
    "#91c5ea", "#d3a9dd", "#91cfd6", "#bdc1ca",
    "#808599", "#de968e", "#b9f1d0", "#ffe5a9",
    "#b1deff", "#ebc4f5", "#aae9f0", "#dde1eb",
]
cursor = "#dde1eb"
cursor-text = "#0d111d"
selection-background = "#423139"
selection-foreground = "#dde1eb"
