[meta]
name = "Lumina Harbor Dark"
mode = "dark"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#cfdceb"
background = "#0c1e37"
palette = [
    "#0e233f", "#dd6b62", "#82d9b4", "#e8d66b",
    "#87c6f2", "#e8a9e1", "#bedee4", "#afbcca",
    "#76889e", "#e88f86", "#a1f2ce", "#fbea87",
    "#b1deff", "#ffc5f8", "#b8f4ff", "#cfdceb",
]
cursor = "#cfdceb"
cursor-text = "#0c1e37"
selection-background = "#3e4a4b"
selection-foreground = "#cfdceb"
