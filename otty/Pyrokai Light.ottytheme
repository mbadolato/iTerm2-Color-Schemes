[meta]
name = "Pyrokai Light"
mode = "light"

[terminal]
foreground = "#242120"
background = "#faf6f5"
palette = [
    "#242120", "#b84963", "#568413", "#8e7100",
    "#0979c4", "#b44a74", "#008490", "#b4afad",
    "#807c7a", "#943c50", "#456a13", "#735a00",
    "#0f619d", "#913c5d", "#006a74", "#faf6f5",
]
cursor = "#b65318"
cursor-text = "#faf6f5"
selection-background = "#e4e0de"
selection-foreground = "#242120"
