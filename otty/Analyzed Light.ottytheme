[meta]
name = "Analyzed Light"
mode = "light"

[terminal]
foreground = "#253449"
background = "#f6f5f0"
palette = [
    "#536177", "#b13e55", "#16765c", "#8a590c",
    "#215ea8", "#7444a0", "#08757e", "#253449",
    "#48576d", "#9d2f49", "#0d674f", "#78500b",
    "#1b5396", "#673891", "#06666f", "#17273c",
]
cursor = "#215ea8"
cursor-text = "#ffffff"
selection-background = "#d5e6ef"
selection-foreground = "#253449"
