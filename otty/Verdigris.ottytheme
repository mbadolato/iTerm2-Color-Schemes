palette = [
    "#221c12", "#d9604f", "#a8b86a", "#d9a441",
    "#5fbfb0", "#b98fb0", "#8fd6b0", "#bfb29a",
    "#6e6450", "#d9604f", "#a8b86a", "#c97a45",
    "#5fbfb0", "#b98fb0", "#8fd6b0", "#e8dcc6",
]
cursor = "#ce8b45"
