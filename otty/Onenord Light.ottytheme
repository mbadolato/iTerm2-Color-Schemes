[meta]
name = "Onenord Light"
mode = "light"

[terminal]
foreground = "#2e3440"
background = "#f7f8fa"
palette = [
    "#2e3440", "#cb4f53", "#48a53d", "#ee5e25",
    "#3879c5", "#9f4aca", "#3ea1ad", "#b2b6bd",
    "#646a76", "#d16366", "#5f9e9d", "#ba793e",
    "#1b40a6", "#9665af", "#8fbcbb", "#eceff4",
]
cursor = "#3879c5"
cursor-text = "#f7f8fa"
selection-background = "#eaebed"
selection-foreground = "#000000"
