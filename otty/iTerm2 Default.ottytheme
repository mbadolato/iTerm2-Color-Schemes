[meta]
name = "iTerm2 Default"
mode = "dark"

[terminal]
foreground = "#ffffff"
background = "#000000"
palette = [
    "#000000", "#c91b00", "#00c200", "#c7c400",
    "#2225c4", "#ca30c7", "#00c5c7", "#ffffff",
    "#686868", "#ff6e67", "#5ffa68", "#fffc67",
    "#6871ff", "#ff77ff", "#60fdff", "#ffffff",
]
cursor = "#e5e5e5"
cursor-text = "#000000"
selection-background = "#c1deff"
selection-foreground = "#000000"
