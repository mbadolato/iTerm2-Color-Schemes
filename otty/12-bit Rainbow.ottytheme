[meta]
name = "12-bit Rainbow"
mode = "dark"

[terminal]
foreground = "#feffff"
background = "#040404"
palette = [
    "#000000", "#a03050", "#40d080", "#e09040",
    "#3060b0", "#603090", "#0090c0", "#dbded8",
    "#685656", "#c06060", "#90d050", "#e0d000",
    "#00b0c0", "#801070", "#20b0c0", "#ffffff",
]
cursor = "#e0d000"
cursor-text = "#000000"
selection-background = "#606060"
selection-foreground = "#ffffff"
