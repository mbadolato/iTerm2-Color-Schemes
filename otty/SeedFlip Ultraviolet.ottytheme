[meta]
name = "SeedFlip Ultraviolet"
mode = "dark"

[terminal]
foreground = "#e8e0f5"
background = "#0b0014"
palette = [
    "#05000a", "#f04242", "#42f07c", "#f0d342",
    "#428bf0", "#f042f0", "#42f0f0", "#f6f3fb",
    "#5b2687", "#f58989", "#89f5ad", "#f5e389",
    "#89b6f5", "#f589f5", "#89f5f5", "#ffffff",
]
cursor = "#c77dff"
cursor-text = "#0b0014"
selection-background = "#13082a"
selection-foreground = "#e8e0f5"
