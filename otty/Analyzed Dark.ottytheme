[meta]
name = "Analyzed Dark"
mode = "dark"

[terminal]
foreground = "#e7eff8"
background = "#0b1220"
palette = [
    "#8395a9", "#f0788a", "#65d5ae", "#f2c477",
    "#77b9f8", "#c2a3fa", "#5dd5d9", "#e7eff8",
    "#9aafc5", "#ff9bab", "#8aebc5", "#ffe09d",
    "#a1ceff", "#d9bdff", "#8af0ee", "#ffffff",
]
cursor = "#5dd5d9"
cursor-text = "#0b1220"
selection-background = "#344b64"
selection-foreground = "#ffffff"
