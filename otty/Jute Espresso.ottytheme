[meta]
name = "Jute Espresso"
mode = "dark"

[terminal]
foreground = "#fff0d7"
background = "#604331"
palette = [
    "#e0c7ab", "#ffc0a1", "#c4ddad", "#fbd18a",
    "#a9cbea", "#d8b9dc", "#a9ded6", "#fff0d7",
    "#efd9c1", "#ffd1b3", "#d5e9c1", "#ffe0a4",
    "#c2ddf7", "#e9cdea", "#c2ece3", "#fff9e9",
]
cursor = "#ffe0a4"
cursor-text = "#604331"
selection-background = "#8e684a"
selection-foreground = "#fff8e8"
