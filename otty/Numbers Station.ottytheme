[meta]
name = "Numbers Station"
mode = "dark"

[terminal]
foreground = "#f0edf6"
background = "#0d0b12"
palette = [
    "#b8b4c1", "#f08188", "#79d0a1", "#e9cb69",
    "#88b3e9", "#d5a2e6", "#7bd3da", "#f0edf6",
    "#cbc7d2", "#f29ca2", "#98deb7", "#efdc8a",
    "#a7c8f0", "#e3baed", "#9ce2e5", "#ffffff",
]
cursor = "#c5a0ff"
cursor-text = "#0d0b12"
selection-background = "#30283b"
selection-foreground = "#fbf8ff"
