[meta]
name = "Dot Gov"
mode = "dark"

[terminal]
foreground = "#ebebeb"
background = "#262c35"
palette = [
    "#191919", "#bf091d", "#3d9751", "#f6bb34",
    "#17b2e0", "#7830b0", "#8bd2ed", "#ffffff",
    "#595959", "#bf091d", "#3d9751", "#f6bb34",
    "#17b2e0", "#7830b0", "#8bd2ed", "#ffffff",
]
cursor = "#d9002f"
cursor-text = "#ffffff"
selection-background = "#1a4080"
selection-foreground = "#ffffff"
