[meta]
name = "ENCOM"
mode = "dark"

[terminal]
foreground = "#00a595"
background = "#000000"
palette = [
    "#000000", "#9f0000", "#008b00", "#ffd000",
    "#0081ff", "#bc00ca", "#008b8b", "#bbbbbb",
    "#555555", "#ff0000", "#00ee00", "#ffff00",
    "#0000ff", "#ff00ff", "#00cdcd", "#ffffff",
]
cursor = "#bbbbbb"
cursor-text = "#ffffff"
selection-background = "#00a48c"
selection-foreground = "#3de1c9"
