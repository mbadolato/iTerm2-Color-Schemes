[meta]
name = "Rhoads RR Black"
mode = "dark"

[terminal]
foreground = "#f4ecd7"
background = "#0a0907"
palette = [
    "#1c1a16", "#c81e1e", "#2e7d32", "#d4af37",
    "#3b82f6", "#a855f7", "#06b6d4", "#e5e1cc",
    "#5a5750", "#ef6b6b", "#8fdc82", "#f5df8a",
    "#73a7f2", "#c49af2", "#77d9e5", "#fffaf0",
]
cursor = "#d4af37"
cursor-text = "#1f1b12"
selection-background = "#5a4512"
selection-foreground = "#e6d7a5"
