[meta]
name = "Synthwave"
mode = "dark"

[terminal]
foreground = "#dad9c7"
background = "#000000"
palette = [
    "#000000", "#f6188f", "#1ebb2b", "#fdf834",
    "#2186ec", "#f85a21", "#12c3e2", "#ffffff",
    "#7f7094", "#f841a0", "#25c141", "#fdf454",
    "#2f9ded", "#f97137", "#19cde6", "#ffffff",
]
cursor = "#19cde6"
cursor-text = "#ffffed"
selection-background = "#19cde6"
selection-foreground = "#000000"
