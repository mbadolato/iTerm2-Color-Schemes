[meta]
name = "Zacess Cream"
mode = "light"

[terminal]
foreground = "#000000"
background = "#fdf6e3"
palette = [
    "#000000", "#c1000a", "#016f1b", "#815601",
    "#015ac2", "#a901a6", "#016969", "#434343",
    "#484848", "#df0010", "#008120", "#966501",
    "#0069e3", "#c500bf", "#027b7b", "#000000",
]
cursor = "#000000"
cursor-text = "#fdf6e3"
selection-background = "#7401ca"
selection-foreground = "#fdf6e3"
