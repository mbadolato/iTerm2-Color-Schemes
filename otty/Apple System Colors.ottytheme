[meta]
name = "Apple System Colors"
mode = "dark"

[terminal]
foreground = "#ffffff"
background = "#1e1e1e"
palette = [
    "#1a1a1a", "#cc372e", "#26a439", "#cdac08",
    "#0869cb", "#9647bf", "#479ec2", "#98989d",
    "#464646", "#ff453a", "#32d74b", "#ffd60a",
    "#0a84ff", "#bf5af2", "#76d6ff", "#ffffff",
]
cursor = "#98989d"
cursor-text = "#ffffff"
selection-background = "#3f638b"
selection-foreground = "#ffffff"
