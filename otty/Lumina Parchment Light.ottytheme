[meta]
name = "Lumina Parchment Light"
mode = "light"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#352516"
background = "#f9efda"
palette = [
    "#352516", "#912918", "#2d7341", "#654935",
    "#2e5fb0", "#87418e", "#006e81", "#7b6858",
    "#706251", "#6b281c", "#195e2f", "#5f2f00",
    "#284d8a", "#6b3770", "#005868", "#9b8776",
]
cursor = "#352516"
cursor-text = "#f9efda"
selection-background = "#d4be95"
selection-foreground = "#352516"
