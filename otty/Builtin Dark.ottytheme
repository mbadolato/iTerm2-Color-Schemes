[meta]
name = "Builtin Dark"
mode = "dark"

[terminal]
foreground = "#bbbbbb"
background = "#000000"
palette = [
    "#000000", "#bb0000", "#00bb00", "#bbbb00",
    "#0d0dc8", "#bb00bb", "#00bbbb", "#bbbbbb",
    "#555555", "#ff5555", "#55ff55", "#ffff55",
    "#5555ff", "#ff55ff", "#55ffff", "#ffffff",
]
cursor = "#bbbbbb"
cursor-text = "#ffffff"
selection-background = "#b5d5ff"
selection-foreground = "#000000"
