[meta]
name = "Modus Operandi Tritanopia"
mode = "light"

[terminal]
foreground = "#000000"
background = "#ffffff"
palette = [
    "#000000", "#a60000", "#006800", "#695500",
    "#0031a9", "#721045", "#005e8b", "#a6a6a6",
    "#595959", "#b21100", "#00663f", "#973300",
    "#3548cf", "#531ab6", "#005f5f", "#595959",
]
cursor = "#000000"
cursor-text = "#ffffff"
selection-background = "#bdbdbd"
selection-foreground = "#000000"
