[meta]
name = "Batman"
mode = "dark"

[terminal]
foreground = "#6f6f6f"
background = "#1b1d1e"
palette = [
    "#1b1d1e", "#e6dc44", "#c8be46", "#f4fd22",
    "#737174", "#747271", "#62605f", "#c6c5bf",
    "#505354", "#fff78e", "#fff27d", "#feed6c",
    "#919495", "#9a9a9d", "#a3a3a6", "#dadbd6",
]
cursor = "#fcef0c"
cursor-text = "#000000"
selection-background = "#4d504c"
selection-foreground = "#f0e04a"
