[meta]
name = "Pencil Dark"
mode = "dark"

[terminal]
foreground = "#f1f1f1"
background = "#212121"
palette = [
    "#212121", "#c30771", "#10a778", "#a89c14",
    "#008ec4", "#5f4986", "#20a5ba", "#d9d9d9",
    "#4f4f4f", "#fb007a", "#5fd7af", "#f3e430",
    "#20bbfc", "#6855de", "#4fb8cc", "#f1f1f1",
]
cursor = "#20bbfc"
cursor-text = "#f1f1f1"
selection-background = "#b6d6fd"
selection-foreground = "#989898"
