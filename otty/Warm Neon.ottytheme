[meta]
name = "Warm Neon"
mode = "dark"

[terminal]
foreground = "#afdab6"
background = "#404040"
palette = [
    "#000000", "#e24346", "#39b13a", "#dae145",
    "#4261c5", "#f920fb", "#2abbd4", "#d0b8a3",
    "#fefcfc", "#e97071", "#9cc090", "#ddda7a",
    "#7b91d6", "#f674ba", "#5ed1e5", "#d8c8bb",
]
cursor = "#30ff24"
cursor-text = "#0bbc04"
selection-background = "#b0ad21"
selection-foreground = "#ffffff"
