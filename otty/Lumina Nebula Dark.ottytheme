[meta]
name = "Lumina Nebula Dark"
mode = "dark"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#cadceb"
background = "#0a111a"
palette = [
    "#0e1520", "#d36059", "#8bce99", "#f7cf55",
    "#92bef8", "#e3a2dc", "#00dfe5", "#aabcca",
    "#728295", "#df847d", "#a3e9b2", "#ffe6a0",
    "#bad7ff", "#ffbbf7", "#8ff1f4", "#cadceb",
]
cursor = "#cadceb"
cursor-text = "#0a111a"
selection-background = "#163c45"
selection-foreground = "#cadceb"
