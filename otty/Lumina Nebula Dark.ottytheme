[meta]
name = "Lumina Nebula Dark"
mode = "dark"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#dde1ec"
background = "#161826"
palette = [
    "#1a1c2c", "#d57068", "#8fdcba", "#f3c085",
    "#c6d6e8", "#e5aedf", "#88d2da", "#bdc1cb",
    "#838ba5", "#e2928a", "#b0f5d5", "#ffdfba",
    "#d8eaff", "#ffc8f9", "#a1ecf5", "#dde1ec",
]
cursor = "#dde1ec"
cursor-text = "#161826"
selection-background = "#393856"
selection-foreground = "#dde1ec"
