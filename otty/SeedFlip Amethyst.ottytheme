[meta]
name = "SeedFlip Amethyst"
mode = "light"

[terminal]
foreground = "#1a0a2e"
background = "#f8f7f6"
palette = [
    "#d7d1cb", "#bd0f0f", "#0fbd49", "#bda00f",
    "#0f58bd", "#bd0fbd", "#0fbdbd", "#0e0519",
    "#b5aba0", "#ee2b2b", "#12d452", "#d4b312",
    "#2b7cee", "#ee2bee", "#05c8c8", "#1a0a2e",
]
cursor = "#635bff"
cursor-text = "#1a0a2e"
selection-background = "#ffffff"
selection-foreground = "#1a0a2e"
