[meta]
name = "C64"
mode = "dark"

[terminal]
foreground = "#7869c4"
background = "#40318d"
palette = [
    "#090300", "#a2524c", "#55a049", "#bfce72",
    "#6657b3", "#984ca3", "#67b6bd", "#ffffff",
    "#000000", "#a2524c", "#55a049", "#bfce72",
    "#6657b3", "#984ca3", "#67b6bd", "#f7f7f7",
]
cursor = "#7869c4"
