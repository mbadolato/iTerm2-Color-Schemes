[meta]
name = "Rainbows and Unicorns Miami"
mode = "dark"

[terminal]
foreground = "#f9ecf5"
background = "#1b1433"
palette = [
    "#2a2148", "#ff5c8a", "#7cf0a8", "#ffe27a",
    "#6fb7ff", "#ff6fd8", "#3fe0d0", "#d9cbe8",
    "#7a6c9c", "#ff9e64", "#a8f7c6", "#ffefae",
    "#a3d2ff", "#ffa3e8", "#8af0e4", "#ffffff",
]
cursor = "#ff6fd8"
cursor-text = "#1b1433"
selection-background = "#ff6fd8"
selection-foreground = "#1b1433"
