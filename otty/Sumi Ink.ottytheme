[meta]
name = "Sumi Ink"
mode = "dark"
author = "EldinBegano"

[terminal]
foreground = "#e6dcc6"
background = "#1e1b18"
palette = [
    "#3a342e", "#c0503f", "#7f9a6a", "#c9a45c",
    "#6f86a8", "#a66b86", "#6fa39a", "#d8ccb4",
    "#7a7166", "#d8705e", "#9cb585", "#dcbd7a",
    "#8ea2c0", "#c08aa2", "#8fbdb3", "#efe5d1",
]
cursor = "#a3362a"
cursor-text = "#efe5d1"
selection-background = "#a3362a"
selection-foreground = "#efe5d1"
