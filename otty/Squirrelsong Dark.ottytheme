    "#372920", "#ba4138", "#468336", "#d4b139",
    "#4395c6", "#855fb8", "#2f9794", "#d3b9a2",
    "#704f39", "#df4d43", "#659a4c", "#e8c23f",
    "#4ca4db", "#9d70da", "#60aca9", "#f2d4bb",
]
cursor = "#b19b89"
