[meta]
name = "Niji"
mode = "dark"

[terminal]
foreground = "#ffffff"
background = "#141515"
palette = [
    "#333333", "#d23e08", "#54ca74", "#fff700",
    "#2ab9ff", "#ff50da", "#1ef9f5", "#ddd0c4",
    "#515151", "#ffb7b7", "#c1ffae", "#fcffb8",
    "#8efff3", "#ffa2ed", "#bcffc7", "#ffffff",
]
cursor = "#ffc663"
cursor-text = "#141515"
selection-background = "#515151"
selection-foreground = "#ffc663"
