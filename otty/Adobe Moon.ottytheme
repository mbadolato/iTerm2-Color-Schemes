[meta]
name = "Adobe Moon"
mode = "dark"

[terminal]
foreground = "#fff0d8"
background = "#54251d"
palette = [
    "#d4c3b5", "#ff9b83", "#8ed8a8", "#f6d06d",
    "#8fc8ef", "#e7a5cf", "#82ddd6", "#fff0d8",
    "#e2d3c8", "#ffb09a", "#a9e2bb", "#ffe08d",
    "#acd8f4", "#efbddc", "#a3e8e2", "#fffaf0",
]
cursor = "#f5c15b"
cursor-text = "#54251d"
selection-background = "#7b4033"
selection-foreground = "#fff6e8"
