[meta]
name = "Purple Portal"
mode = "dark"
author = "theebest.com (https://www.theebest.com)"

[terminal]
foreground = "#faf5ff"
background = "#160528"
palette = [
    "#483a57", "#fb7185", "#34d399", "#f472b6",
    "#facc15", "#38bdf8", "#580ff0", "#d8b4fe",
    "#503872", "#fc8d9d", "#5ddcad", "#f68bc3",
    "#fbd644", "#60caf9", "#793ff3", "#faf5ff",
]
cursor = "#faf5ff"
cursor-text = "#160528"
selection-background = "#faf5ff"
selection-foreground = "#160528"
