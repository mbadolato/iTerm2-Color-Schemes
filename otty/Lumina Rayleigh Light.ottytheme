[meta]
name = "Lumina Rayleigh Light"
mode = "light"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#1d2638"
background = "#f7fbfe"
palette = [
    "#1d2638", "#941419", "#187538", "#9b6400",
    "#0555b7", "#a43687", "#005c71", "#677388",
    "#656f81", "#6b1d1b", "#005f28", "#815200",
    "#0a4490", "#81326b", "#004758", "#8792a9",
]
cursor = "#1d2638"
cursor-text = "#f7fbfe"
selection-background = "#bdcfee"
selection-foreground = "#1d2638"
