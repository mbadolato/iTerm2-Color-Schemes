[meta]
name = "Green Phosphor CRT"
mode = "dark"

[terminal]
foreground = "#33ff33"
background = "#0b0f0b"
palette = [
    "#002200", "#00aa00", "#33ff33", "#66ff66",
    "#00cc44", "#00ff88", "#66ffaa", "#b6ffb6",
    "#0a5a0a", "#19cc19", "#66ff66", "#99ff99",
    "#33ff77", "#66ffaa", "#99ffcc", "#e6ffe6",
]
cursor = "#33ff33"
cursor-text = "#0b0f0b"
selection-background = "#0a3a0a"
selection-foreground = "#575b57"
