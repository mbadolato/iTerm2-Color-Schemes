[meta]
name = "Flatland"
mode = "dark"

[terminal]
foreground = "#b8dbef"
background = "#1d1f21"
palette = [
    "#1d1d19", "#f18339", "#9fd364", "#f4ef6d",
    "#5096be", "#695abc", "#d63865", "#ffffff",
    "#50504c", "#d22a24", "#a7d42c", "#ff8949",
    "#61b9d0", "#695abc", "#d63865", "#ffffff",
]
cursor = "#708284"
cursor-text = "#002831"
selection-background = "#2b2a24"
selection-foreground = "#ffffff"
