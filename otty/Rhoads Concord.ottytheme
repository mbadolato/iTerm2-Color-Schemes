[meta]
name = "Rhoads Concord"
mode = "light"

[terminal]
foreground = "#1a1a1a"
background = "#fdfcf4"
palette = [
    "#2b2b2b", "#c81e1e", "#2e7d32", "#d4af37",
    "#2563eb", "#a855f7", "#06b6d4", "#bfc1c5",
    "#6b6b6b", "#ef6b6b", "#82cf75", "#cfb964",
    "#7daaf2", "#c59af2", "#76ced8", "#ffffff",
]
cursor = "#000000"
cursor-text = "#4b4b4b"
selection-background = "#b8860b"
selection-foreground = "#e3c384"
