[meta]
name = "Spacegray Bright"
mode = "dark"

[terminal]
foreground = "#f3f3f3"
background = "#2a2e3a"
palette = [
    "#080808", "#bc5553", "#a0b56c", "#f6c987",
    "#7baec1", "#b98aae", "#85c9b8", "#d8d8d8",
    "#626262", "#bc5553", "#a0b56c", "#f6c987",
    "#7baec1", "#b98aae", "#85c9b8", "#f7f7f7",
]
cursor = "#c6c6c6"
cursor-text = "#8c8c8c"
selection-background = "#cacaca"
selection-foreground = "#000000"
