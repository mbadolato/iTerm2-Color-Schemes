[meta]
name = "Powershell"
mode = "dark"

[terminal]
foreground = "#f6f6f7"
background = "#052454"
palette = [
    "#000000", "#981a22", "#098003", "#c4a000",
    "#4140c3", "#d33682", "#0e807f", "#7f7c7f",
    "#808080", "#ef2929", "#1cfe3c", "#fefe45",
    "#268ad2", "#fe13fa", "#29fffe", "#c2c1c3",
]
cursor = "#f6f6f7"
cursor-text = "#052454"
selection-background = "#f6f6f7"
selection-foreground = "#052454"
