[meta]
name = "Callie Light"
mode = "light"
author = "Greylock Labs (https://github.com/greylocklabs/themes)"

[terminal]
foreground = "#55414e"
background = "#fbf5f8"
palette = [
    "#2b1a26", "#9e5251", "#3f7b4a", "#886518",
    "#4b6ba6", "#985270", "#027c7d", "#8f7a87",
    "#6b5562", "#8a4140", "#2d6a39", "#755402",
    "#3b5993", "#85415f", "#006869", "#dcc8d3",
]
cursor = "#e45f97"
cursor-text = "#2e0f20"
selection-background = "#e0ccd7"
selection-foreground = "#55414e"
