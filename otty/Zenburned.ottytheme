[meta]
name = "Zenburned"
mode = "dark"

[terminal]
foreground = "#f0e4cf"
background = "#404040"
palette = [
    "#404040", "#e3716e", "#819b69", "#b77e64",
    "#6099c0", "#b279a7", "#66a5ad", "#f0e4cf",
    "#6f6768", "#ec8685", "#8bae68", "#d68c67",
    "#61abda", "#cf86c1", "#65b8c1", "#c0ab86",
]
cursor = "#f3eadb"
cursor-text = "#404040"
selection-background = "#746956"
selection-foreground = "#f0e4cf"
