    "#685742", "#cc967b", "#97976d", "#6c9861",
    "#b5955e", "#c9a554", "#d7c483", "#b5955e",
    "#75644f", "#cc967b", "#97976d", "#6c9861",
    "#b5955e", "#c9a554", "#d7c483", "#b5955e",
]
cursor = "#d7c483"
