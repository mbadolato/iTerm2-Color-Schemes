[meta]
name = "Obsurdian"
mode = "dark"

[terminal]
foreground = "#f5f5f5"
background = "#0a0a0a"
palette = [
    "#b8b8b8", "#ff6b6b", "#66d98b", "#ffe37a",
    "#82aaff", "#ff8fd1", "#8be9f4", "#f0f0f0",
    "#c7c7c7", "#ff8585", "#82e6a0", "#ffeb96",
    "#9abaff", "#ffa8dc", "#a4f1f7", "#ffffff",
]
cursor = "#ffd54a"
cursor-text = "#0a0a0a"
selection-background = "#3a3a3a"
selection-foreground = "#ffffff"
