[meta]
name = "Hopscotch.256"
mode = "dark"

[terminal]
foreground = "#b9b5b8"
background = "#322931"
palette = [
    "#322931", "#dd464c", "#8fc13e", "#fdcc59",
    "#1290bf", "#c85e7c", "#149b93", "#b9b5b8",
    "#797379", "#dd464c", "#8fc13e", "#fdcc59",
    "#1290bf", "#c85e7c", "#149b93", "#ffffff",
]
cursor = "#b9b5b8"
