[meta]
name = "GitHub Dark Colorblind"
mode = "dark"

[terminal]
foreground = "#c9d1d9"
background = "#0d1117"
palette = [
    "#484f58", "#ec8e2c", "#58a6ff", "#d29922",
    "#58a6ff", "#bc8cff", "#39c5cf", "#b1bac4",
    "#6e7681", "#fdac54", "#79c0ff", "#e3b341",
    "#79c0ff", "#d2a8ff", "#56d4dd", "#ffffff",
]
cursor = "#58a6ff"
cursor-text = "#98e6ff"
selection-background = "#c9d1d9"
selection-foreground = "#0d1117"
