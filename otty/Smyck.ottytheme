[meta]
name = "Smyck"
mode = "dark"

[terminal]
foreground = "#f7f7f7"
background = "#1b1b1b"
palette = [
    "#000000", "#b84131", "#7da900", "#c4a500",
    "#62a3c4", "#ba8acc", "#207383", "#a1a1a1",
    "#7a7a7a", "#d6837c", "#c4f137", "#fee14d",
    "#8dcff0", "#f79aff", "#6ad9cf", "#f7f7f7",
]
cursor = "#bbbbbb"
cursor-text = "#ffffff"
selection-background = "#207483"
selection-foreground = "#f7f7f7"
