[meta]
name = "TokyoNight Moon"
mode = "dark"

[terminal]
foreground = "#c8d3f5"
background = "#222436"
palette = [
    "#1b1d2b", "#ff757f", "#c3e88d", "#ffc777",
    "#82aaff", "#c099ff", "#86e1fc", "#828bb8",
    "#444a73", "#ff757f", "#c3e88d", "#ffc777",
    "#82aaff", "#c099ff", "#86e1fc", "#c8d3f5",
]
cursor = "#c8d3f5"
cursor-text = "#222436"
selection-background = "#2d3f76"
selection-foreground = "#c8d3f5"
