[meta]
name = "CLRS"
mode = "light"

[terminal]
foreground = "#262626"
background = "#ffffff"
palette = [
    "#000000", "#f8282a", "#328a5d", "#fa701d",
    "#135cd0", "#9f00bd", "#33c3c1", "#b3b3b3",
    "#555753", "#fb0416", "#2cc631", "#e3bd0e",
    "#1670ff", "#e900b0", "#3ad5ce", "#eeeeec",
]
cursor = "#62c6ef"
cursor-text = "#ffffff"
selection-background = "#6fd3fc"
selection-foreground = "#041730"
