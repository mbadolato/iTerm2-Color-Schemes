[meta]
name = "Cold Storage"
mode = "light"

[terminal]
foreground = "#102235"
background = "#f4f9ff"
palette = [
    "#29394a", "#842121", "#0c5935", "#644b00",
    "#17468f", "#5e3188", "#005969", "#3b4b5b",
    "#40505f", "#902727", "#10613b", "#6c5100",
    "#123a78", "#653890", "#004b59", "#455565",
]
cursor = "#0b5f83"
cursor-text = "#f4f9ff"
selection-background = "#dce9f5"
selection-foreground = "#102235"
