[meta]
name = "Cobalt Next Dark"
mode = "dark"

[terminal]
foreground = "#d7deea"
background = "#0b1c24"
palette = [
    "#262f37", "#f94967", "#8cc98f", "#ffc64c",
    "#409dd4", "#cba3c7", "#37b5b4", "#d7deea",
    "#62747f", "#e47e8b", "#baddbb", "#ffdc91",
    "#7ac0eb", "#f3ccef", "#84e4e3", "#ffffff",
]
cursor = "#ffc64c"
cursor-text = "#999999"
selection-background = "#37b5b4"
selection-foreground = "#ffffff"
