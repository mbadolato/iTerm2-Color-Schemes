[meta]
name = "Dimidium"
mode = "dark"

[terminal]
foreground = "#bab7b6"
background = "#141414"
palette = [
    "#000000", "#cf494c", "#60b442", "#db9c11",
    "#0575d8", "#af5ed2", "#1db6bb", "#bab7b6",
    "#817e7e", "#ff643b", "#37e57b", "#fccd1a",
    "#688dfd", "#ed6fe9", "#32e0fb", "#dee3e4",
]
cursor = "#37e57b"
