[meta]
name = "Lumina Oxblood Light"
mode = "light"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#42222f"
background = "#fef2f4"
palette = [
    "#42222f", "#9b2827", "#237742", "#a1600a",
    "#3166a6", "#82469d", "#087380", "#8a6472",
    "#7d5d68", "#732926", "#0f6131", "#874e00",
    "#1c5290", "#683a7d", "#005d68", "#ab8392",
]
cursor = "#42222f"
cursor-text = "#fef2f4"
selection-background = "#e6b8cb"
selection-foreground = "#42222f"
