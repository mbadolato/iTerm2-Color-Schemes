[meta]
name = "Snazzy Soft"
mode = "dark"

[terminal]
foreground = "#eff0eb"
background = "#282a36"
palette = [
    "#000000", "#ff5c57", "#5af78e", "#f3f99d",
    "#57c7ff", "#ff6ac1", "#9aedfe", "#f1f1f0",
    "#686868", "#ff5c57", "#5af78e", "#f3f99d",
    "#57c7ff", "#ff6ac1", "#9aedfe", "#f1f1f0",
]
cursor = "#eaeaea"
cursor-text = "#282a36"
selection-background = "#92bcd0"
selection-foreground = "#000000"
