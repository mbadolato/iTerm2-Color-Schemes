[meta]
name = "Lumina Espresso Dark"
mode = "dark"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#e5dfd6"
background = "#1e150e"
palette = [
    "#231911", "#cd766e", "#95d3b1", "#efca86",
    "#96bfe9", "#dbadd6", "#90cad1", "#c5bfb6",
    "#938a81", "#db968f", "#b5ebcd", "#ffe4b4",
    "#b5d8fd", "#f6c6f1", "#a9e4ec", "#e5dfd6",
]
cursor = "#e5dfd6"
cursor-text = "#1e150e"
selection-background = "#45383f"
selection-foreground = "#e5dfd6"
