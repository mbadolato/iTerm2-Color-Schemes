[meta]
name = "Karma Dark Dimmed"
mode = "dark"

[terminal]
foreground = "#e2def0"
background = "#14181f"
palette = [
    "#14181f", "#e87691", "#82c891", "#ebd870",
    "#6cc4d2", "#a892d4", "#6cc4d2", "#a8a4ae",
    "#5c5a5f", "#e8869c", "#98cea4", "#ebd870",
    "#80c8d2", "#b6a4d6", "#80c8d2", "#e2def0",
]
cursor = "#ebd870"
cursor-text = "#14181f"
selection-background = "#2f2d3d"
selection-foreground = "#e2def0"
