[meta]
name = "Serendipity Sunset"
mode = "dark"
author = "Michael Andreuzza (https://github.com/michael-andreuzza/Serendipity-Theme)"

[terminal]
foreground = "#dee0ef"
background = "#202231"
palette = [
    "#363847", "#d1918f", "#709bbd", "#a392dc",
    "#a0b6e8", "#aac9d4", "#d6b4b4", "#dee0ef",
    "#6b6d7c", "#d1918f", "#709bbd", "#a392dc",
    "#a0b6e8", "#aac9d4", "#d6b4b4", "#dee0ef",
]
cursor = "#8d8f9e"
cursor-text = "#dee0ef"
selection-background = "#6b6d7c"
selection-foreground = "#dee0ef"
