[meta]
name = "Lumina Quartz Light"
mode = "light"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#30353b"
background = "#f5f7fa"
palette = [
    "#30353b", "#7d2b28", "#217550", "#9a642c",
    "#446894", "#82527e", "#007092", "#6b7177",
    "#656b72", "#5a2522", "#215e41", "#82511c",
    "#31547e", "#6c3f69", "#115a74", "#8a9097",
]
cursor = "#30353b"
cursor-text = "#f5f7fa"
selection-background = "#bbbec1"
selection-foreground = "#30353b"
