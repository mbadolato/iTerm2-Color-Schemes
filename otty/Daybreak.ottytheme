[meta]
name = "Daybreak"
mode = "light"

[terminal]
foreground = "#44413b"
background = "#f3efe8"
palette = [
    "#44413b", "#af2817", "#3c6a12", "#795900",
    "#186875", "#754193", "#006a62", "#6e6b62",
    "#8c8579", "#c03a27", "#538625", "#9a4c1f",
    "#207887", "#8552a3", "#087a71", "#2e2c27",
]
cursor = "#a25327"
cursor-text = "#f3efe8"
selection-background = "#e2daca"
selection-foreground = "#a6a29b"
