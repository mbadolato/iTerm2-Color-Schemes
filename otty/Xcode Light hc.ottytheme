[meta]
name = "Xcode Light hc"
mode = "light"

[terminal]
foreground = "#000000"
background = "#ffffff"
palette = [
    "#b4d8fd", "#ad1805", "#355d61", "#78492a",
    "#0058a1", "#9c2191", "#703daa", "#000000",
    "#8a99a6", "#ad1805", "#174145", "#78492a",
    "#003f73", "#9c2191", "#441ea1", "#000000",
]
cursor = "#000000"
cursor-text = "#ffffff"
selection-background = "#b4d8fd"
selection-foreground = "#000000"
