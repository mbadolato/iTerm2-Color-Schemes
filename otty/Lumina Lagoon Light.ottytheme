[meta]
name = "Lumina Lagoon Light"
mode = "light"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#212829"
background = "#eef9fb"
palette = [
    "#212829", "#901f1f", "#007853", "#a06200",
    "#1e69a2", "#8a4885", "#345a61", "#697273",
    "#626b6d", "#69221e", "#006143", "#855100",
    "#00558b", "#73356f", "#004953", "#889192",
]
cursor = "#212829"
cursor-text = "#eef9fb"
selection-background = "#cce0ed"
selection-foreground = "#212829"
