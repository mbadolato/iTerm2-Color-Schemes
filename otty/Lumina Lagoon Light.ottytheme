[meta]
name = "Lumina Lagoon Light"
mode = "light"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#0b323b"
background = "#e9fafa"
palette = [
    "#0b323b", "#8f2121", "#2e6147", "#a1600d",
    "#185ca9", "#894984", "#006e71", "#507580",
    "#546f74", "#682220", "#005031", "#874e00",
    "#154986", "#72366e", "#00585b", "#6f95a0",
]
cursor = "#0b323b"
cursor-text = "#e9fafa"
selection-background = "#afd3d7"
selection-foreground = "#0b323b"
