[meta]
name = "Lumina Canopy Light"
mode = "light"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#1e3323"
background = "#f1f9ef"
palette = [
    "#1e3323", "#860c2c", "#337545", "#905705",
    "#046aa7", "#864c82", "#007184", "#5e7563",
    "#5b6f5d", "#5b1d26", "#206033", "#764600",
    "#0e5686", "#70396c", "#005b6b", "#7d9582",
]
cursor = "#1e3323"
cursor-text = "#f1f9ef"
selection-background = "#cecda8"
selection-foreground = "#1e3323"
