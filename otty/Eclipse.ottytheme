[meta]
name = "Eclipse"
mode = "dark"

[terminal]
foreground = "#dce3ed"
background = "#0e1116"
palette = [
    "#0a0d12", "#ff6366", "#85df5e", "#f1c655",
    "#5fb9ff", "#cea5ff", "#3addc4", "#b7c0ce",
    "#5c6675", "#ff8688", "#a0ec7e", "#fad77c",
    "#84ccff", "#ddbfff", "#68ead3", "#f4f8fd",
]
cursor = "#f6c45f"
cursor-text = "#0e1116"
selection-background = "#25324a"
selection-foreground = "#5a5e62"
