[meta]
name = "Hopscotch"
mode = "dark"

[terminal]
foreground = "#b9b5b8"
background = "#322931"
palette = [
    "#322931", "#dd464c", "#8fc13e", "#fdcc59",
    "#1290bf", "#c85e7c", "#149b93", "#b9b5b8",
    "#797379", "#fd8b19", "#5c545c", "#5c545b",
    "#989498", "#d5d3d5", "#b33508", "#ffffff",
]
cursor = "#b9b5b8"
cursor-text = "#322931"
selection-background = "#5c545b"
selection-foreground = "#b9b5b8"
