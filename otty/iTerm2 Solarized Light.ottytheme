[meta]
name = "iTerm2 Solarized Light"
mode = "light"

[terminal]
foreground = "#657b83"
background = "#fdf6e3"
palette = [
    "#073642", "#dc322f", "#859900", "#b58900",
    "#268bd2", "#d33682", "#2aa198", "#bbb5a2",
    "#002b36", "#cb4b16", "#586e75", "#657b83",
    "#839496", "#6c71c4", "#93a1a1", "#fdf6e3",
]
cursor = "#657b83"
cursor-text = "#eee8d5"
selection-background = "#eee8d5"
selection-foreground = "#586e75"
