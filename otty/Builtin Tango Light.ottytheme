[meta]
name = "Builtin Tango Light"
mode = "light"

[terminal]
foreground = "#000000"
background = "#ffffff"
palette = [
    "#000000", "#cc0000", "#4e9a06", "#c4a000",
    "#3465a4", "#75507b", "#06989a", "#b9bdb5",
    "#555753", "#ef2929", "#7dd527", "#d6c329",
    "#729fcf", "#ad7fa8", "#27d5d5", "#eeeeec",
]
cursor = "#000000"
cursor-text = "#ffffff"
selection-background = "#b5d5ff"
selection-foreground = "#000000"
