[meta]
name = "Caliche"
mode = "dark"

[terminal]
foreground = "#fff0d5"
background = "#55452f"
palette = [
    "#c9c4b5", "#ebad90", "#87c79e", "#dfbf68",
    "#91c1d6", "#d2afc4", "#76c9c4", "#fff0d5",
    "#d8d3c5", "#eeaa89", "#99d0aa", "#e9d087",
    "#9bc9dc", "#d8b6c8", "#94d7d2", "#fff9e9",
]
cursor = "#f0bd5b"
cursor-text = "#55452f"
selection-background = "#74634c"
selection-foreground = "#fff8e8"
