[meta]
name = "Wild Cherry"
mode = "dark"

[terminal]
foreground = "#dafaff"
background = "#1f1726"
palette = [
    "#000507", "#d94085", "#2ab250", "#ffd16f",
    "#883cdc", "#ececec", "#c1b8b7", "#fff8de",
    "#009cc9", "#da6bac", "#f4dca5", "#eac066",
    "#308cba", "#ae636b", "#ff919d", "#e4838d",
]
cursor = "#dd00ff"
cursor-text = "#ff7fff"
selection-background = "#002831"
selection-foreground = "#e4ffff"
