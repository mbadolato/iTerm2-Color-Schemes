[meta]
name = "Candlelight"
mode = "dark"

[terminal]
foreground = "#f8e7c4"
background = "#432708"
palette = [
    "#c8b99e", "#e89661", "#9ab57c", "#dfbb53",
    "#83aebd", "#bc91a4", "#79b8ae", "#f8e7c4",
    "#cfc1aa", "#eba374", "#a6be8c", "#e3c368",
    "#92b8c5", "#c49eaf", "#89c1b8", "#f9eacb",
]
cursor = "#eba374"
cursor-text = "#432708"
selection-background = "#cfc1aa"
selection-foreground = "#a09172"
