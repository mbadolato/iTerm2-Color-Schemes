[meta]
name = "Xcode Light"
mode = "light"

[terminal]
foreground = "#262626"
background = "#ffffff"
palette = [
    "#b4d8fd", "#d12f1b", "#3e8087", "#78492a",
    "#0f68a0", "#ad3da4", "#804fb8", "#262626",
    "#8a99a6", "#d12f1b", "#23575c", "#78492a",
    "#0b4f79", "#ad3da4", "#4b21b0", "#262626",
]
cursor = "#262626"
cursor-text = "#ffffff"
selection-background = "#b4d8fd"
selection-foreground = "#262626"
