[meta]
name = "Ember"
mode = "dark"

[terminal]
foreground = "#f3e3d1"
background = "#1b0f0b"
palette = [
    "#40261b", "#e4573f", "#79ad58", "#d99a33",
    "#6196e6", "#d077b3", "#4ac3b1", "#d7b995",
    "#6a4a38", "#ff7b5e", "#a8c976", "#ffc15a",
    "#8bb8f2", "#e59ad6", "#66d9c4", "#ffe8c7",
]
cursor = "#d17a3c"
cursor-text = "#1b0f0b"
selection-background = "#4a2a1e"
selection-foreground = "#f3e3d1"
