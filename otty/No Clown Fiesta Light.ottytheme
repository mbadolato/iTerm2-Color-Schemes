[meta]
name = "No Clown Fiesta Light"
mode = "light"

[terminal]
foreground = "#151515"
background = "#e1e1e1"
palette = [
    "#d6d6d6", "#874e42", "#677940", "#b89058",
    "#8ba1bf", "#aa759f", "#3e5f66", "#151515",
    "#2b2b2b", "#637786", "#677940", "#b89058",
    "#93a2ab", "#aa759f", "#99ab93", "#373737",
]
cursor = "#151515"
cursor-text = "#d0d0d0"
selection-background = "#c6d5de"
selection-foreground = "#151515"
