[meta]
name = "Signal Ghost"
mode = "dark"

[terminal]
foreground = "#e7efe7"
background = "#0e1414"
palette = [
    "#9da9a9", "#e56f75", "#62c99b", "#e6c45c",
    "#72a9e8", "#bd8ee0", "#65ced0", "#e7efe7",
    "#b5bebe", "#ef8b90", "#82d9b2", "#f0d77b",
    "#92bff0", "#d1a9e8", "#87dcdd", "#ffffff",
]
cursor = "#6dd0e6"
cursor-text = "#0e1414"
selection-background = "#1f2a2a"
selection-foreground = "#f3faf5"
