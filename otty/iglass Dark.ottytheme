[meta]
name = "iglass Dark"
mode = "dark"

[terminal]
foreground = "#f7f8fd"
background = "#17181c"
palette = [
    "#2c2c2e", "#ff7f70", "#32d74b", "#ffd60a",
    "#62a7ff", "#d384ff", "#64d2ff", "#d1d1d6",
    "#a4a5aa", "#ffb8b0", "#44e968", "#ffeaa3",
    "#a3cdff", "#e7b9ff", "#95e0ff", "#ffffff",
]
cursor = "#62a7ff"
cursor-text = "#17181c"
selection-background = "#124172"
selection-foreground = "#f7f8fd"
