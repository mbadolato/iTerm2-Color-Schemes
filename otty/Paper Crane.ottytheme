[meta]
name = "Paper Crane"
mode = "light"

[terminal]
foreground = "#353b3a"
background = "#f5f1e8"
palette = [
    "#424845", "#a74e45", "#53765e", "#8a6c2b",
    "#4c688f", "#805b83", "#3e7b7a", "#626c66",
    "#777d76", "#bf6354", "#668a6d", "#a3833d",
    "#607eaa", "#966f9b", "#529392", "#454f49",
]
cursor = "#b85d4b"
cursor-text = "#f5f1e8"
selection-background = "#b8cdb6"
selection-foreground = "#353b3a"
