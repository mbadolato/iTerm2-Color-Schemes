[meta]
name = "IRIX Terminal"
mode = "dark"

[terminal]
foreground = "#f2f2f2"
background = "#000043"
palette = [
    "#1a1919", "#ff2b1e", "#57ff3d", "#ffff44",
    "#0004ff", "#ff2cff", "#56ffff", "#ffffff",
    "#ffff44", "#ffff44", "#ffff44", "#fffc72",
    "#ffff44", "#ffff44", "#ffff44", "#ffff44",
]
cursor = "#c7c7c7"
cursor-text = "#8c8c8c"
selection-background = "#c2deff"
selection-foreground = "#000000"
