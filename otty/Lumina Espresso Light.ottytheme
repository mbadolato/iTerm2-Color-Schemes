[meta]
name = "Lumina Espresso Light"
mode = "light"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#39261b"
background = "#fcf0e3"
palette = [
    "#39261b", "#842120", "#15744d", "#6d4e36",
    "#2868a3", "#864b81", "#007083", "#7f685c",
    "#756457", "#5f201e", "#005e3c", "#653400",
    "#1a5488", "#70386b", "#005a6a", "#9f877a",
]
cursor = "#39261b"
cursor-text = "#fcf0e3"
selection-background = "#d8bccc"
selection-foreground = "#39261b"
