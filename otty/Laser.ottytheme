[meta]
name = "Laser"
mode = "dark"

[terminal]
foreground = "#f106e3"
background = "#030d18"
palette = [
    "#626262", "#ff8373", "#b4fb73", "#09b4bd",
    "#fed300", "#ff90fe", "#d1d1fe", "#f1f1f1",
    "#8f8f8f", "#ffc4be", "#d6fcba", "#fffed5",
    "#f92883", "#ffb2fe", "#e6e7fe", "#ffffff",
]
cursor = "#00ff9c"
cursor-text = "#a6a6a6"
selection-background = "#2e206a"
selection-foreground = "#f4f4f4"
