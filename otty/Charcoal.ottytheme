[meta]
name = "Charcoal"
mode = "dark"

[terminal]
foreground = "#c4c4c4"
background = "#0d0d0d"
palette = [
    "#111111", "#888888", "#a8a8a8", "#b0b0b0",
    "#9a9a9a", "#8a8a8a", "#a0a0a0", "#c0c0c0",
    "#474747", "#a0a0a0", "#c4c4c4", "#c8c8c8",
    "#d0d0d0", "#b8b8b8", "#cccccc", "#ececec",
]
cursor = "#d0d0d0"
cursor-text = "#0d0d0d"
selection-background = "#2e2e2e"
selection-foreground = "#e0e0e0"
