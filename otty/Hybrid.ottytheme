[meta]
name = "Hybrid"
mode = "dark"

[terminal]
foreground = "#b7bcba"
background = "#161719"
palette = [
    "#2a2e33", "#b84d51", "#b3bf5a", "#e4b55e",
    "#6e90b0", "#a17eac", "#7fbfb4", "#b5b9b6",
    "#434548", "#8d2e32", "#798431", "#e58a50",
    "#4b6b88", "#6e5079", "#4d7b74", "#5a626a",
]
cursor = "#b7bcba"
cursor-text = "#1e1f22"
selection-background = "#1e1f22"
selection-foreground = "#b7bcba"
