[meta]
name = "Mona Lisa"
mode = "dark"

[terminal]
foreground = "#f7d66a"
background = "#120b0d"
palette = [
    "#351b0e", "#9b291c", "#636232", "#c36e28",
    "#515c5d", "#9b1d29", "#588056", "#f7d75c",
    "#874228", "#ff4331", "#b4b264", "#ff9566",
    "#9eb2b4", "#ff5b6a", "#8acd8f", "#ffe598",
]
cursor = "#c46c32"
cursor-text = "#120b0d"
selection-background = "#f7d66a"
selection-foreground = "#120b0d"
