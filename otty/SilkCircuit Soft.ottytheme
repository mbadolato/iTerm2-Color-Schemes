[meta]
name = "SilkCircuit Soft"
mode = "dark"
author = "Stefanie Jane (https://github.com/hyperb1iss/silkcircuit)"

[terminal]
foreground = "#f8f8f2"
background = "#1a1626"
palette = [
    "#141220", "#ff6677", "#66ff99", "#ffe699",
    "#92aaff", "#ff99ff", "#99ffee", "#f8f8f2",
    "#6272a4", "#ff7788", "#80ffb3", "#ffffa5",
    "#a2bbff", "#ffb3ff", "#b3ffea", "#ffffff",
]
cursor = "#99ffee"
cursor-text = "#1a1626"
selection-background = "#44475a"
selection-foreground = "#f8f8f2"
