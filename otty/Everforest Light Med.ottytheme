[meta]
name = "Everforest Light Med"
mode = "light"

[terminal]
foreground = "#5c6a72"
background = "#efebd4"
palette = [
    "#7a8478", "#e67e80", "#9ab373", "#c1a266",
    "#7fbbb3", "#d699b6", "#83c092", "#b2af9f",
    "#a6b0a0", "#f85552", "#8da101", "#dfa000",
    "#3a94c5", "#df69ba", "#35a77c", "#fffbef",
]
cursor = "#f57d26"
cursor-text = "#eaedc8"
selection-background = "#eaedc8"
selection-foreground = "#5c6a72"
