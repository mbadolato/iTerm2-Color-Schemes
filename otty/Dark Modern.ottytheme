[meta]
name = "Dark Modern"
mode = "dark"

[terminal]
foreground = "#cccccc"
background = "#1f1f1f"
palette = [
    "#000000", "#cd3131", "#0dbc79", "#e5e510",
    "#2472c8", "#bc3fbc", "#11a8cd", "#e5e5e5",
    "#666666", "#f14c4c", "#23d18b", "#f5f543",
    "#3b8eea", "#d670d6", "#29b8db", "#e5e5e5",
]
cursor = "#ffffff"
cursor-text = "#000000"
selection-background = "#3a3d41"
selection-foreground = "#e0e0e0"
