[meta]
name = "Solar Flare"
mode = "light"

[terminal]
foreground = "#1a1a1a"
background = "#fff9e6"
palette = [
    "#292929", "#8d1818", "#0f5c2b", "#685000",
    "#15479a", "#673096", "#004b5a", "#3a3a37",
    "#55534d", "#982020", "#0b5028", "#594500",
    "#1a50a5", "#713a9e", "#004957", "#46443e",
]
cursor = "#7d3e00"
cursor-text = "#fff9e6"
selection-background = "#f5e1a8"
selection-foreground = "#1a1a1a"
