[meta]
name = "Xcode Dark"
mode = "dark"

[terminal]
foreground = "#dfdfe0"
background = "#292a30"
palette = [
    "#414453", "#ff8170", "#78c2b3", "#d9c97c",
    "#4eb0cc", "#ff7ab2", "#b281eb", "#dfdfe0",
    "#7f8c98", "#ff8170", "#acf2e4", "#ffa14f",
    "#6bdfff", "#ff7ab2", "#dabaff", "#dfdfe0",
]
cursor = "#dfdfe0"
cursor-text = "#292a30"
selection-background = "#414453"
selection-foreground = "#dfdfe0"
