[meta]
name = "Atlas Ragnarok"
mode = "dark"

[terminal]
foreground = "#ffffff"
background = "#000000"
palette = [
    "#000000", "#ff8080", "#99ffe4", "#2563eb",
    "#a0a0a0", "#3b82f6", "#99ffe4", "#ffffff",
    "#505050", "#ff9999", "#b3ffe4", "#60a5fa",
    "#b0b0b0", "#93c5fd", "#99ffe4", "#ffffff",
]
cursor = "#3b82f6"
cursor-text = "#ffffff"
selection-background = "#1e3a5f"
selection-foreground = "#ffffff"
