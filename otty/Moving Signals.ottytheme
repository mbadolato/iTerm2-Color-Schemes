[meta]
name = "Moving Signals"
mode = "dark"

[terminal]
foreground = "#f6e9dc"
background = "#28141b"
palette = [
    "#a99b9d", "#d56b70", "#9cb6a2", "#d7a96c",
    "#8baac0", "#b9a0b7", "#91b5b2", "#efe1d3",
    "#c2b2b2", "#ee8382", "#afcbb2", "#edc385",
    "#a2bfd1", "#cdb2c8", "#a7ccc5", "#fff4e8",
]
cursor = "#e6c077"
cursor-text = "#28141b"
selection-background = "#58303b"
selection-foreground = "#ffffff"
