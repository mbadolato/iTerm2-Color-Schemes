[meta]
name = "Tumbling Stones"
mode = "dark"

[terminal]
foreground = "#f1e9e2"
background = "#141212"
palette = [
    "#a5a4a2", "#eb655f", "#9fb5a5", "#d6b5a1",
    "#89aebc", "#b6a3b2", "#8fbac0", "#f1e9e2",
    "#c2bfbb", "#fa8177", "#b6c9b8", "#ebcabb",
    "#a2c4cf", "#d0b8c5", "#a9d0d2", "#fff8f0",
]
cursor = "#f05b54"
cursor-text = "#141212"
selection-background = "#553337"
selection-foreground = "#fff9ed"
