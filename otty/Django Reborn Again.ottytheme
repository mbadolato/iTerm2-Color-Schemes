[meta]
name = "Django Reborn Again"
mode = "dark"

[terminal]
foreground = "#dadedc"
background = "#051f14"
palette = [
    "#000000", "#fd6209", "#41a83e", "#ffe862",
    "#245032", "#f8f8f8", "#9df39f", "#ffffff",
    "#4c4c4c", "#ff943b", "#73da70", "#ffff94",
    "#568264", "#ffffff", "#cfffd1", "#ffffff",
]
cursor = "#ffcc00"
cursor-text = "#9a9e9c"
selection-background = "#203727"
selection-foreground = "#dadedc"
