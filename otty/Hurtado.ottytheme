[meta]
name = "Hurtado"
mode = "dark"

[terminal]
foreground = "#dbdbdb"
background = "#000000"
palette = [
    "#575757", "#ff1b00", "#a5e055", "#fbe74a",
    "#496487", "#fd5ff1", "#86e9fe", "#cbcccb",
    "#404040", "#d51d00", "#a5df55", "#fbe84a",
    "#89beff", "#c001c1", "#86eafe", "#dbdbdb",
]
cursor = "#bbbbbb"
cursor-text = "#ffffff"
selection-background = "#b5d5ff"
selection-foreground = "#000000"
