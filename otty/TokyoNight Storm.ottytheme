[meta]
name = "TokyoNight Storm"
mode = "dark"

[terminal]
foreground = "#c0caf5"
background = "#24283b"
palette = [
    "#1d202f", "#f7768e", "#9ece6a", "#e0af68",
    "#7aa2f7", "#bb9af7", "#7dcfff", "#a9b1d6",
    "#4e5575", "#f7768e", "#9ece6a", "#e0af68",
    "#7aa2f7", "#bb9af7", "#7dcfff", "#c0caf5",
]
cursor = "#c0caf5"
cursor-text = "#1d202f"
selection-background = "#364a82"
selection-foreground = "#c0caf5"
