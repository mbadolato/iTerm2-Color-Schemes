[meta]
name = "Chalkboard"
mode = "dark"

[terminal]
foreground = "#d9e6f2"
background = "#29262f"
palette = [
    "#000000", "#c37372", "#72c373", "#c2c372",
    "#7372c3", "#c372c2", "#72c2c3", "#d9d9d9",
    "#585858", "#dbaaaa", "#aadbaa", "#dadbaa",
    "#aaaadb", "#dbaada", "#aadadb", "#ffffff",
]
cursor = "#d9e6f2"
cursor-text = "#29262f"
selection-background = "#073642"
selection-foreground = "#ffffff"
