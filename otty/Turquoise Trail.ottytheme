[meta]
name = "Turquoise Trail"
mode = "dark"

[terminal]
foreground = "#fff0d5"
background = "#075153"
palette = [
    "#d0d9d2", "#ffad8e", "#a7dfae", "#f7d879",
    "#b1d6f4", "#efb0d2", "#a9e5df", "#fff0d5",
    "#e0e5df", "#ffc0a5", "#bce8c2", "#ffe493",
    "#c8e3f7", "#f4c6df", "#c5eee9", "#fffaf0",
]
cursor = "#ffb34f"
cursor-text = "#063d3f"
selection-background = "#287071"
selection-foreground = "#fff8e8"
