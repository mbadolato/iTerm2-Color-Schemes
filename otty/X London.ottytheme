[meta]
name = "X London"
mode = "light"

[terminal]
foreground = "#333333"
background = "#ffffff"
palette = [
    "#ffffff", "#333333", "#444444", "#555555",
    "#666666", "#777777", "#888888", "#333333",
    "#333333", "#444444", "#555555", "#666666",
    "#777777", "#888888", "#999999", "#aaaaaa",
]
cursor = "#333333"
cursor-text = "#ffffff"
selection-background = "#333333"
selection-foreground = "#ffffff"
