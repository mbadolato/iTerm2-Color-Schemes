[meta]
name = "Nightfox"
mode = "dark"

[terminal]
foreground = "#cdcecf"
background = "#192330"
palette = [
    "#393b44", "#c94f6d", "#81b29a", "#dbc074",
    "#719cd6", "#9d79d6", "#63cdcf", "#dfdfe0",
    "#575860", "#d16983", "#8ebaa4", "#e0c989",
    "#86abdc", "#baa1e2", "#7ad5d6", "#e4e4e5",
]
cursor = "#cdcecf"
cursor-text = "#192330"
selection-background = "#2b3b51"
selection-foreground = "#cdcecf"
