[meta]
name = "Retro Legends"
mode = "dark"

[terminal]
foreground = "#45eb45"
background = "#0d0d0d"
palette = [
    "#262626", "#de5454", "#45eb45", "#f7bf2b",
    "#4066f2", "#bf4cf2", "#40d9e6", "#bfe6bf",
    "#4c594c", "#ff6666", "#59ff59", "#ffd933",
    "#4c80ff", "#e666ff", "#59e6ff", "#f2fff2",
]
cursor = "#45eb45"
cursor-text = "#0d0d0d"
selection-background = "#336633"
selection-foreground = "#f2fff2"
