[meta]
name = "Espresso Libre"
mode = "dark"

[terminal]
foreground = "#b8a898"
background = "#2a211c"
palette = [
    "#000000", "#cc0000", "#1a921c", "#f0e53a",
    "#0066ff", "#c5656b", "#06989a", "#d3d7cf",
    "#555753", "#ef2929", "#9aff87", "#fffb5c",
    "#43a8ed", "#ff818a", "#34e2e2", "#eeeeec",
]
cursor = "#ffffff"
cursor-text = "#000000"
selection-background = "#c3dcff"
selection-foreground = "#ab9b8b"
