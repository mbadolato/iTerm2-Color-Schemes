[meta]
name = "Matrix"
mode = "dark"

[terminal]
foreground = "#426644"
background = "#0f191c"
palette = [
    "#0f191c", "#23755a", "#82d967", "#ffd700",
    "#3f5242", "#409931", "#50b45a", "#507350",
    "#688060", "#2fc079", "#90d762", "#faff00",
    "#4f7e7e", "#11ff25", "#c1ff8a", "#678c61",
]
cursor = "#384545"
cursor-text = "#00ff00"
selection-background = "#18282e"
selection-foreground = "#00ff87"
