[meta]
name = "Poltergeist"
mode = "dark"

[terminal]
foreground = "#f0ffff"
background = "#06444b"
palette = [
    "#c0d1d2", "#ff9c91", "#8ce0b0", "#e9d06c",
    "#8ed4ed", "#c5a7e8", "#77e1df", "#f0ffff",
    "#c8d7d7", "#ffa89e", "#9ae4b9", "#ecd67e",
    "#9cd9ef", "#ccb2eb", "#87e5e3", "#f2ffff",
]
cursor = "#ffa89e"
cursor-text = "#06444b"
selection-background = "#c8d7d7"
selection-foreground = "#8c9999"
