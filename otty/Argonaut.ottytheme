[meta]
name = "Argonaut"
mode = "dark"

[terminal]
foreground = "#fffaf4"
background = "#0e1019"
palette = [
    "#232323", "#ff000f", "#8ce10b", "#ffb900",
    "#008df8", "#6d43a6", "#00d8eb", "#ffffff",
    "#444444", "#ff2740", "#abe15b", "#ffd242",
    "#0092ff", "#9a5feb", "#67fff0", "#ffffff",
]
cursor = "#ff0018"
cursor-text = "#ff8ca4"
selection-background = "#002a3b"
selection-foreground = "#ffffff"
