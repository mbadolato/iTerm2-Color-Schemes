[meta]
name = "Violet Light"
mode = "light"

[terminal]
foreground = "#536870"
background = "#fcf4dc"
palette = [
    "#56595c", "#c94c22", "#85981c", "#b4881d",
    "#2e8bce", "#d13a82", "#32a198", "#b9b6af",
    "#45484b", "#bd3613", "#738a04", "#a57705",
    "#2176c7", "#c61c6f", "#259286", "#c9c6bd",
]
cursor = "#536870"
cursor-text = "#fcf4dc"
selection-background = "#595ab7"
selection-foreground = "#fcf4dc"
