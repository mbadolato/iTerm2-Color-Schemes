[meta]
name = "Seoulbones Light"
mode = "light"

[terminal]
foreground = "#555555"
background = "#e2e2e2"
palette = [
    "#e2e2e2", "#dc5284", "#628562", "#c48562",
    "#0084a3", "#896788", "#008586", "#555555",
    "#a5a0a1", "#be3c6d", "#487249", "#a76b48",
    "#006f89", "#7f4c7e", "#006f70", "#777777",
]
cursor = "#555555"
cursor-text = "#e2e2e2"
selection-background = "#cccccc"
selection-foreground = "#555555"
