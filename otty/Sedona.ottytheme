[meta]
name = "Sedona"
mode = "dark"

[terminal]
foreground = "#fff0dc"
background = "#55172f"
palette = [
    "#c8b9bd", "#f58d79", "#83cd94", "#efc257",
    "#8fc1e5", "#dc98c7", "#79d1cb", "#fff0dc",
    "#d9c9cd", "#fba594", "#9ad9a7", "#f8d47b",
    "#acd2ed", "#e7b2d5", "#99dfda", "#fff9ed",
]
cursor = "#f3bd50"
cursor-text = "#55172f"
selection-background = "#772c47"
selection-foreground = "#fff8ea"
