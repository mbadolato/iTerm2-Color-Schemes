[meta]
name = "Seti"
mode = "dark"

[terminal]
foreground = "#cacecd"
background = "#111213"
palette = [
    "#323232", "#c22832", "#8ec43d", "#e0c64f",
    "#43a5d5", "#8b57b5", "#8ec43d", "#eeeeee",
    "#3f3f3f", "#c22832", "#8ec43d", "#e0c64f",
    "#43a5d5", "#8b57b5", "#8ec43d", "#ffffff",
]
cursor = "#e3bf21"
cursor-text = "#ad8b00"
selection-background = "#303233"
selection-foreground = "#cacecd"
