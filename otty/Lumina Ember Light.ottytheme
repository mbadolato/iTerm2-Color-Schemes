[meta]
name = "Lumina Ember Light"
mode = "light"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#3d332b"
background = "#fbf8f0"
palette = [
    "#3d332b", "#972524", "#23784f", "#68482d",
    "#3770b0", "#a43a7c", "#007488", "#7a6f66",
    "#73665a", "#6f2623", "#00633c", "#5c3100",
    "#235b99", "#7f3762", "#005e6f", "#9a8e85",
]
cursor = "#3d332b"
cursor-text = "#fbf8f0"
selection-background = "#efd9c9"
selection-foreground = "#3d332b"
