[meta]
name = "Lumina Ember Light"
mode = "light"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#372b1e"
background = "#f9f4ea"
palette = [
    "#372b1e", "#811d1d", "#437329", "#a06116",
    "#256b99", "#96437b", "#007285", "#7a6c5e",
    "#716657", "#5c1d1b", "#355d20", "#874e01",
    "#005785", "#783763", "#005c6c", "#9a8b7c",
]
cursor = "#372b1e"
cursor-text = "#f9f4ea"
selection-background = "#e6bba2"
selection-foreground = "#372b1e"
