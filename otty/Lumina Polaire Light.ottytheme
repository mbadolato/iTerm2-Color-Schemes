[meta]
name = "Lumina Polaire Light"
mode = "light"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#17323f"
background = "#f0f9fa"
palette = [
    "#17323f", "#882322", "#327645", "#965a1c",
    "#3e5372", "#884c84", "#06677c", "#587483",
    "#556a74", "#63221f", "#1f6133", "#7f4700",
    "#173e76", "#723a6e", "#005264", "#7694a4",
]
cursor = "#17323f"
cursor-text = "#f0f9fa"
selection-background = "#b8d1de"
selection-foreground = "#17323f"
