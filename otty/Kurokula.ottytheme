[meta]
name = "Kurokula"
mode = "dark"

[terminal]
foreground = "#e0cfc2"
background = "#141515"
palette = [
    "#333333", "#c35a52", "#78b3a9", "#e1b917",
    "#5c91dd", "#8b79a6", "#867268", "#e0cfc2",
    "#515151", "#ffc34c", "#afffa5", "#fff700",
    "#90dbff", "#ad93ff", "#ffcdb6", "#ffffff",
]
cursor = "#7a1c1c"
cursor-text = "#fffbf2"
selection-background = "#515151"
selection-foreground = "#ffc34c"
