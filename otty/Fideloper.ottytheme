[meta]
name = "Fideloper"
mode = "dark"

[terminal]
foreground = "#dbdae0"
background = "#292f33"
palette = [
    "#292f33", "#cb1e2d", "#edb8ac", "#b7ab9b",
    "#2e78c2", "#c0236f", "#309186", "#eae3ce",
    "#496068", "#d4605a", "#d4605a", "#a86671",
    "#7c85c4", "#5c5db2", "#819090", "#fcf4df",
]
cursor = "#d4605a"
cursor-text = "#fefff2"
selection-background = "#efb8ac"
selection-foreground = "#8c8c8c"
