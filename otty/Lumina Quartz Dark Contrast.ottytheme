[meta]
name = "Lumina Quartz Dark Contrast"
mode = "dark"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#ebeff2"
background = "#0d0e0f"
palette = [
    "#111213", "#ffa69b", "#62d17f", "#ffc334",
    "#7fb7ff", "#ec8ce4", "#00e2fc", "#caced1",
    "#8c949a", "#ffcdc6", "#7eeb98", "#ffe4b0",
    "#add1ff", "#ffadf7", "#a6f2ff", "#ebeff2",
]
cursor = "#ebeff2"
cursor-text = "#0d0e0f"
selection-background = "#1d3d43"
selection-foreground = "#ebeff2"
