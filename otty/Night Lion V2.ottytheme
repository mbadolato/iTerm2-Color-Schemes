[meta]
name = "Night Lion V2"
mode = "dark"

[terminal]
foreground = "#bbbbbb"
background = "#171717"
palette = [
    "#4c4c4c", "#bb0000", "#04f623", "#f3f167",
    "#64d0f0", "#ce6fdb", "#00dadf", "#bbbbbb",
    "#555555", "#ff5555", "#7df71d", "#ffff55",
    "#62cbe8", "#ff9bf5", "#00ccd8", "#ffffff",
]
cursor = "#bbbbbb"
cursor-text = "#ffffff"
selection-background = "#b5d5ff"
selection-foreground = "#000000"
