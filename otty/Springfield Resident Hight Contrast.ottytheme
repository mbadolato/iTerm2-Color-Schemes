[meta]
name = "Springfield Resident Hight Contrast"
mode = "light"

[terminal]
foreground = "#062f63"
background = "#ffdd32"
palette = [
    "#171b24", "#7a1026", "#134e24", "#5d3e00",
    "#063d82", "#67145d", "#004a5d", "#29303b",
    "#343b46", "#85162c", "#164e27", "#5c3e00",
    "#084287", "#701966", "#004a5c", "#303742",
]
cursor = "#0b4b94"
cursor-text = "#fff3a3"
selection-background = "#0b4b94"
selection-foreground = "#fff3a3"
