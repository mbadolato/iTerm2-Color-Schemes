[meta]
name = "Gruvbox Material"
mode = "dark"

[terminal]
foreground = "#d4be98"
background = "#1d2021"
palette = [
    "#141617", "#ea6926", "#c1d041", "#eecf75",
    "#6da3ec", "#fd9bc1", "#fe9d6e", "#ffffff",
    "#4c4c4c", "#d3573b", "#c1d041", "#eecf75",
    "#2c86ff", "#fd9bc1", "#92a5df", "#ffffff",
]
cursor = "#ffffff"
cursor-text = "#000000"
selection-background = "#2b2c3f"
selection-foreground = "#7cfb70"
