[meta]
name = "Catppuccin Latte"
mode = "light"
author = "Catppuccin (https://github.com/catppuccin/)"

[terminal]
foreground = "#4c4f69"
background = "#eff1f5"
palette = [
    "#bcc0cc", "#d20f39", "#40a02b", "#df8e1d",
    "#1e66f5", "#ea76cb", "#179299", "#5c5f77",
    "#acb0be", "#e7103f", "#46b02f", "#e49931",
    "#3878f6", "#ef95d7", "#19a1a8", "#6c6f85",
]
cursor = "#dc8a78"
cursor-text = "#eff1f5"
selection-background = "#dc8a78"
selection-foreground = "#eff1f5"
