[meta]
name = "Slate"
mode = "dark"

[terminal]
foreground = "#35b1d2"
background = "#222222"
palette = [
    "#222222", "#e2a8bf", "#81d778", "#c4c9c0",
    "#335856", "#a481d3", "#15ab9c", "#02c5e0",
    "#ffffff", "#ffcdd9", "#beffa8", "#d0ccca",
    "#7ab0d2", "#c5a7d9", "#8cdfe0", "#e0e0e0",
]
cursor = "#87d3c4"
cursor-text = "#323232"
selection-background = "#0f3754"
selection-foreground = "#2dffc0"
