[meta]
name = "Broadcast"
mode = "dark"

[terminal]
foreground = "#e6e1dc"
background = "#2b2b2b"
palette = [
    "#000000", "#da4939", "#519f50", "#ffd24a",
    "#6d9cbe", "#d0d0ff", "#6e9cbe", "#ffffff",
    "#585858", "#ff7b6b", "#83d182", "#ffff7c",
    "#9fcef0", "#ffffff", "#a0cef0", "#ffffff",
]
cursor = "#ffffff"
cursor-text = "#c0bbb6"
selection-background = "#5a647e"
selection-foreground = "#e6e1dc"
