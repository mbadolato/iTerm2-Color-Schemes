[meta]
name = "Monospace Light"
mode = "light"
author = "Angelo Convento (https://github.com/conventoangelo)"

[terminal]
foreground = "#475365"
background = "#f4f7fd"
palette = [
    "#333e4f", "#d03941", "#007b49", "#a65921",
    "#3c60dd", "#6f4cde", "#0075a2", "#5d6a7d",
    "#000000", "#a52430", "#00522f", "#904b1a",
    "#002487", "#4d21bb", "#00607e", "#475365",
]
cursor = "#6f4cde"
cursor-text = "#f4f7fd"
selection-background = "#c7d3ff"
selection-foreground = "#1f2939"
