    "#1f0000", "#b00d0d", "#b00d0d", "#b00d0d",
    "#b00d0d", "#b00d0d", "#b00d0d", "#fafafa",
    "#554040", "#ff1111", "#ff1010", "#ff1010",
    "#ff1010", "#ff1010", "#ff1010", "#fefefe",
]
