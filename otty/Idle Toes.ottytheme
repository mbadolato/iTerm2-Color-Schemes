[meta]
name = "Idle Toes"
mode = "dark"

[terminal]
foreground = "#ffffff"
background = "#323232"
palette = [
    "#323232", "#d25252", "#7fe173", "#ffc66d",
    "#4099ff", "#f680ff", "#bed6ff", "#eeeeec",
    "#606060", "#f07070", "#9dff91", "#ffe48b",
    "#5eb7f7", "#ff9dff", "#dcf4ff", "#ffffff",
]
cursor = "#d6d6d6"
cursor-text = "#000000"
selection-background = "#5b5b5b"
selection-foreground = "#000000"
