[meta]
name = "Zacess High Contrast Dark"
mode = "dark"

[terminal]
foreground = "#ffffff"
background = "#000000"
palette = [
    "#b3b3b3", "#ff9e94", "#8fe88f", "#f5c400",
    "#8fd0ff", "#f2a6ff", "#5ef0e0", "#e0e0e0",
    "#cccccc", "#ffc4bd", "#b8f7b8", "#ffe08a",
    "#c8e6ff", "#ffcdf7", "#9ef7ee", "#ffffff",
]
cursor = "#f5c400"
cursor-text = "#000000"
selection-background = "#0a2552"
selection-foreground = "#ffffff"
