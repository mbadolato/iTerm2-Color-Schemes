[meta]
name = "Newsprint Fog"
mode = "light"

[terminal]
foreground = "#333331"
background = "#f2f2f0"
palette = [
    "#333331", "#b3402e", "#5d7f52", "#987921",
    "#4f6d94", "#85607f", "#4d7f7c", "#d5d5d0",
    "#78786f", "#cc4f3b", "#6f9562", "#af8e2c",
    "#6182ab", "#9b7494", "#5e9692", "#fdfdfb",
]
cursor = "#b3402e"
cursor-text = "#f2f2f0"
selection-background = "#ddddd6"
selection-foreground = "#333331"
