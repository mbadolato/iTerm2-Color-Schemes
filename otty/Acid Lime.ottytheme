[meta]
name = "Acid Lime"
mode = "dark"

[terminal]
foreground = "#d4efbc"
background = "#080c05"
palette = [
    "#131d0c", "#ff3344", "#97e63c", "#eeff5c",
    "#4deca0", "#a6ff6b", "#50ffb4", "#bfe0a4",
    "#4a6b36", "#ff3344", "#97e63c", "#dbff45",
    "#4deca0", "#a6ff6b", "#50ffb4", "#d4efbc",
]
cursor = "#c2ff33"
cursor-text = "#080c05"
selection-background = "#1b2a10"
selection-foreground = "#545852"
