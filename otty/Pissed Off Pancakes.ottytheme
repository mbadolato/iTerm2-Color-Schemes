[meta]
name = "Pissed Off Pancakes"
mode = "dark"

[terminal]
foreground = "#f8edd7"
background = "#1a1208"
palette = [
    "#aaa59c", "#db533e", "#7cb85b", "#e4b33f",
    "#4aa3ff", "#b35cff", "#33d6c9", "#f8edd7",
    "#c6c0b5", "#ff6b4d", "#a4dc79", "#f7d867",
    "#73b9ff", "#cd8aff", "#62e5d9", "#fff4d2",
]
cursor = "#f4d35e"
cursor-text = "#1a1208"
selection-background = "#5a3b1a"
selection-foreground = "#fff7e8"
