[meta]
name = "Elemental"
mode = "dark"

[terminal]
foreground = "#807a74"
background = "#22211d"
palette = [
    "#3c3c30", "#98290f", "#479a43", "#7f7111",
    "#497f7d", "#7f4e2f", "#387f58", "#807974",
    "#555445", "#e0502a", "#61e070", "#d69927",
    "#79d9d9", "#cd7c54", "#59d599", "#fff1e9",
]
cursor = "#facb80"
cursor-text = "#161611"
selection-background = "#413829"
selection-foreground = "#facd77"
