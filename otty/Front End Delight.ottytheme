[meta]
name = "Front End Delight"
mode = "dark"

[terminal]
foreground = "#adadad"
background = "#1b1c1d"
palette = [
    "#242526", "#f8511b", "#565747", "#fa771d",
    "#2c70b7", "#f02e4f", "#3ca1a6", "#adadad",
    "#5fac6d", "#f74319", "#74ec4c", "#fdc325",
    "#3393ca", "#e75e4f", "#4fbce6", "#8c735b",
]
cursor = "#cdcdcd"
cursor-text = "#1b1c1d"
selection-background = "#ea6154"
selection-foreground = "#1b1c1d"
