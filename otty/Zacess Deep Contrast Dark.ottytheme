[meta]
name = "Zacess Deep Contrast Dark"
mode = "dark"

[terminal]
foreground = "#ffffff"
background = "#000000"
palette = [
    "#000000", "#ff5f5f", "#00cd00", "#cdcd00",
    "#8888ff", "#ff2aff", "#00cdcd", "#e5e5e5",
    "#b8b8b8", "#ff9e9e", "#00ff00", "#ffff00",
    "#b0b0ff", "#ff8fff", "#00ffff", "#ffffff",
]
cursor = "#ffff00"
cursor-text = "#000000"
selection-background = "#1c1c38"
selection-foreground = "#ffffff"
