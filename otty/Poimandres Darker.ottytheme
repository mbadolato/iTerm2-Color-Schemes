[meta]
name = "Poimandres Darker"
mode = "dark"

[terminal]
foreground = "#a6accd"
background = "#16161e"
palette = [
    "#16161e", "#d0679d", "#5de4c7", "#fffac2",
    "#89ddff", "#fcc5e9", "#add7ff", "#ffffff",
    "#a6accd", "#d0679d", "#5de4c7", "#fffac2",
    "#add7ff", "#fae4fc", "#89ddff", "#ffffff",
]
cursor = "#ffffff"
cursor-text = "#16161e"
selection-background = "#a6accd"
selection-foreground = "#ffffff"
