[meta]
name = "Neon Raincheck: After Hours"
mode = "dark"

[terminal]
foreground = "#b8c9d9"
background = "#0b1019"
palette = [
    "#18202d", "#b95c7b", "#609d8c", "#b8a46b",
    "#6586c0", "#9679c5", "#4c9faf", "#a4b5c5",
    "#3d4c63", "#d77c99", "#7abba5", "#d5c183",
    "#86a6dc", "#b69adb", "#6bc4d1", "#dceaf2",
]
cursor = "#79c9d8"
cursor-text = "#0b1019"
selection-background = "#202c42"
selection-foreground = "#575c66"
