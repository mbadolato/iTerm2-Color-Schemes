[meta]
name = "Black Cat"
mode = "dark"

[terminal]
foreground = "#f5edff"
background = "#180a2b"
palette = [
    "#a9a0b6", "#ff8992", "#9fda65", "#edc85e",
    "#8bbdf0", "#c78bf0", "#76d2d1", "#f5edff",
    "#b3abbf", "#ff979f", "#abde77", "#efcf71",
    "#99c5f2", "#ce99f2", "#86d7d7", "#f6efff",
]
cursor = "#ff979f"
cursor-text = "#180a2b"
selection-background = "#b3abbf"
selection-foreground = "#f6efff"
