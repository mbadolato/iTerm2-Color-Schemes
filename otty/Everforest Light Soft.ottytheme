[meta]
name = "Everforest Light Soft"
mode = "light"

[terminal]
foreground = "#5c6a72"
background = "#e5dfc5"
palette = [
    "#7a8478", "#e67e80", "#8da666", "#c1a266",
    "#72aea6", "#c98ca9", "#76b385", "#a5a292",
    "#99a393", "#f85552", "#8da101", "#d29300",
    "#3a94c5", "#df69ba", "#35a77c", "#fffbef",
]
cursor = "#f57d26"
cursor-text = "#e1e4bd"
selection-background = "#e1e4bd"
selection-foreground = "#5c6a72"
