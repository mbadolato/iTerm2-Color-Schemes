[meta]
name = "Jubi"
mode = "dark"

[terminal]
foreground = "#c3d3de"
background = "#262b33"
palette = [
    "#3b3750", "#cf7b98", "#90a94b", "#6ebfc0",
    "#576ea6", "#bc4f68", "#75a7d2", "#c3d3de",
    "#a874ce", "#de90ab", "#bcdd61", "#87e9ea",
    "#8c9fcd", "#e16c87", "#b7c9ef", "#d5e5f1",
]
cursor = "#c3d3de"
cursor-text = "#1e1b2e"
selection-background = "#5b5184"
selection-foreground = "#1e1b2e"
