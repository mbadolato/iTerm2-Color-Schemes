[meta]
name = "Termius Dark"
mode = "dark"
author = "Termius (https://termius.com)"

[terminal]
foreground = "#21b568"
background = "#141729"
palette = [
    "#343851", "#f24e50", "#008463", "#eca855",
    "#08639f", "#c13282", "#2091f6", "#e2e3e8",
    "#8d91a5", "#ff7375", "#3ed7be", "#fdc47d",
    "#6ba0c3", "#ff7dc5", "#44a7ff", "#ffffff",
]
cursor = "#21b568"
cursor-text = "#141729"
selection-background = "#1b6649"
selection-foreground = "#21b568"
