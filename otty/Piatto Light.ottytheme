[meta]
name = "Piatto Light"
mode = "light"

[terminal]
foreground = "#414141"
background = "#ffffff"
palette = [
    "#414141", "#b23771", "#66781e", "#cd6f34",
    "#3c5ea8", "#a454b2", "#66781e", "#bfbfbf",
    "#3f3f3f", "#db3365", "#829429", "#cd6f34",
    "#3c5ea8", "#a454b2", "#829429", "#f2f2f2",
]
cursor = "#5e77c8"
cursor-text = "#abbee5"
selection-background = "#706b4e"
selection-foreground = "#acbcdc"
