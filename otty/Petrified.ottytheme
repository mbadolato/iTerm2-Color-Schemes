[meta]
name = "Petrified"
mode = "dark"

[terminal]
foreground = "#fff0dc"
background = "#403637"
palette = [
    "#c7c0ba", "#ee9676", "#82c794", "#e5c05c",
    "#80bdd2", "#cc9fc1", "#75ccc7", "#fff0dc",
    "#d6d0ca", "#f4aa8d", "#9bd4a7", "#efd17d",
    "#9dcddd", "#dab6cf", "#94dad5", "#fff9ed",
]
cursor = "#f0b65c"
cursor-text = "#403637"
selection-background = "#625456"
selection-foreground = "#fff8ea"
