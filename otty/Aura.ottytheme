[meta]
name = "Aura"
mode = "dark"

[terminal]
foreground = "#edecee"
background = "#15141b"
palette = [
    "#110f18", "#ff6767", "#61ffca", "#ffca85",
    "#a277ff", "#a277ff", "#61ffca", "#edecee",
    "#4d4d4d", "#ffca85", "#a277ff", "#ffca85",
    "#a277ff", "#a277ff", "#61ffca", "#edecee",
]
cursor = "#a277ff"
