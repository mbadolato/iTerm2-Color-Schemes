[meta]
name = "Firefox Dev"
mode = "dark"

[terminal]
foreground = "#7c8fa4"
background = "#0e1011"
palette = [
    "#002831", "#e63853", "#5eb83c", "#a57706",
    "#359ddf", "#d75cff", "#4b73a2", "#dcdcdc",
    "#26444d", "#e1003f", "#1d9000", "#cd9409",
    "#006fc0", "#a200da", "#005794", "#e2e2e2",
]
cursor = "#708284"
cursor-text = "#002831"
selection-background = "#163c61"
selection-foreground = "#f2f5f9"
