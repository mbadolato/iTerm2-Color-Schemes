[meta]
name = "Onenord"
mode = "dark"

[terminal]
foreground = "#e5e9f0"
background = "#2e3440"
palette = [
    "#3b4252", "#e06c75", "#9ec183", "#ebcb8b",
    "#81a1c1", "#b988b0", "#88c0d0", "#e5e9f0",
    "#596377", "#e06c75", "#9ec183", "#ebcb8b",
    "#81a1c1", "#b988b0", "#8fbcbb", "#eceff4",
]
cursor = "#81a1c1"
