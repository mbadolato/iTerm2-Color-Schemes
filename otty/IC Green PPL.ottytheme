[meta]
name = "IC Green PPL"
mode = "dark"

[terminal]
foreground = "#e0f1dc"
background = "#2c2c2c"
palette = [
    "#014401", "#ff2736", "#41a638", "#76a831",
    "#2ec3b9", "#50a096", "#3ca078", "#e6fef2",
    "#106910", "#b4fa5c", "#aefb86", "#dafa87",
    "#2efaeb", "#50fafa", "#3cfac8", "#e0f1dc",
]
cursor = "#47fa6b"
