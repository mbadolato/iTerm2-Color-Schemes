[meta]
name = "Cobalt Foundry"
mode = "dark"

[terminal]
foreground = "#c2cedb"
background = "#10151c"
palette = [
    "#1a2129", "#e57373", "#81b366", "#d4a95f",
    "#4f95e0", "#9d85cf", "#56b3c4", "#a2b0be",
    "#56626f", "#ef8f8f", "#9cc983", "#e5c07e",
    "#74aeec", "#b5a0e0", "#78cbda", "#e2eaf2",
]
cursor = "#4fa8ff"
cursor-text = "#10151c"
selection-background = "#1f3a5c"
selection-foreground = "#e2eaf2"
