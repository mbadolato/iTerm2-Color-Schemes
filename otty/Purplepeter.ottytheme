[meta]
name = "Purplepeter"
mode = "dark"

[terminal]
foreground = "#ece7fa"
background = "#2a1a4a"
palette = [
    "#0a0520", "#ff796d", "#99b481", "#efdfac",
    "#66d9ef", "#e78fcd", "#ba8cff", "#ffba81",
    "#504b63", "#f99f92", "#b4be8f", "#f2e9bf",
    "#79daed", "#ba91d4", "#a0a0d6", "#b9aed3",
]
cursor = "#c7c7c7"
cursor-text = "#8c8c8c"
selection-background = "#8689c2"
selection-foreground = "#271c50"
