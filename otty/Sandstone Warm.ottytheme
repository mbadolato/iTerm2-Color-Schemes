[meta]
name = "Sandstone Warm"
mode = "light"

[terminal]
foreground = "#3e3220"
background = "#fdf6e3"
palette = [
    "#2e2010", "#cf2522", "#5d7b00", "#865e00",
    "#0d6eb2", "#b52d6e", "#037a71", "#756c51",
    "#5c4a2a", "#c04010", "#7f6648", "#7d6646",
    "#5c6f6f", "#5f64b7", "#5f6e6e", "#fdf6e3",
]
cursor = "#3e3220"
cursor-text = "#fdf6e3"
selection-background = "#e8dfc4"
selection-foreground = "#b0a996"
