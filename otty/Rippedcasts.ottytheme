[meta]
name = "Rippedcasts"
mode = "dark"

[terminal]
foreground = "#ffffff"
background = "#2b2b2b"
palette = [
    "#000000", "#cdaf95", "#a8ff60", "#bfbb1f",
    "#75a5b0", "#ff73fd", "#5a647e", "#bfbfbf",
    "#666666", "#eecbad", "#bcee68", "#e5e500",
    "#86bdc9", "#e500e5", "#8c9bc4", "#e5e5e5",
]
cursor = "#7f7f7f"
cursor-text = "#ffffff"
selection-background = "#5a647e"
selection-foreground = "#f2f2f2"
