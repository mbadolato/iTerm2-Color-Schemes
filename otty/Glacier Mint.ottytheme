[meta]
name = "Glacier Mint"
mode = "light"

[terminal]
foreground = "#2f4640"
background = "#f0f9f6"
palette = [
    "#2f4640", "#c05045", "#3d9060", "#a48224",
    "#3f7ab8", "#8858ab", "#26948e", "#acc2ba",
    "#6c837c", "#d76458", "#4aa971", "#bb9830",
    "#5190cc", "#9e6ec1", "#32ada6", "#fbfffd",
]
cursor = "#2aa88a"
cursor-text = "#f0f9f6"
selection-background = "#c6ebdd"
selection-foreground = "#2f4640"
