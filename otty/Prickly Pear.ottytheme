[meta]
name = "Prickly Pear"
mode = "dark"

[terminal]
foreground = "#fff0df"
background = "#561038"
palette = [
    "#cbb8c2", "#ff8d99", "#78d58e", "#f5c54e",
    "#9ac4ef", "#e49bd2", "#7cdbd5", "#fff0df",
    "#dbcbd2", "#ffa8b0", "#98dfa6", "#f9d778",
    "#b4d5f4", "#edb8df", "#9ce7e2", "#fffaf2",
]
cursor = "#f4c24f"
cursor-text = "#561038"
selection-background = "#7b2853"
selection-foreground = "#fff7ed"
