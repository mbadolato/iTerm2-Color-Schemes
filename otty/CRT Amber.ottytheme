[meta]
name = "CRT Amber"
mode = "dark"
author = "theebest.com (https://www.theebest.com)"

[terminal]
foreground = "#fff3c4"
background = "#1a1005"
palette = [
    "#4c422f", "#ef4444", "#84cc16", "#fde68a",
    "#c084fc", "#f97316", "#f59e0b", "#d8a657",
    "#544435", "#f26969", "#9dd645", "#fdeb9f",
    "#cd9dfd", "#fa8f45", "#f7b13c", "#fff3c4",
]
cursor = "#fff3c4"
cursor-text = "#1a1005"
selection-background = "#fff3c4"
selection-foreground = "#1a1005"
