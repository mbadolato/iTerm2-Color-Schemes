[meta]
name = "Aardvark Blue"
mode = "dark"

[terminal]
foreground = "#dddddd"
background = "#102040"
palette = [
    "#191919", "#aa342e", "#4b8c0f", "#dbba00",
    "#1370d3", "#c43ac3", "#008eb0", "#bebebe",
    "#525252", "#f05b50", "#95dc55", "#ffe763",
    "#60a4ec", "#e26be2", "#60b6cb", "#f7f7f7",
]
cursor = "#007acc"
cursor-text = "#bfdbfe"
selection-background = "#bfdbfe"
selection-foreground = "#000000"
