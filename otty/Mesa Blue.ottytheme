[meta]
name = "Mesa Blue"
mode = "dark"

[terminal]
foreground = "#fff0d7"
background = "#164c72"
palette = [
    "#d3d8d5", "#ffad91", "#9fdfad", "#f6d67a",
    "#b7d9f4", "#ecafd4", "#a6e5df", "#fff0d7",
    "#e1e5e2", "#ffc0a8", "#b9e9c2", "#ffe596",
    "#cee6f8", "#f3c7e0", "#c2efea", "#fffaf0",
]
cursor = "#ffc05d"
cursor-text = "#164c72"
selection-background = "#35698b"
selection-foreground = "#fff8e9"
