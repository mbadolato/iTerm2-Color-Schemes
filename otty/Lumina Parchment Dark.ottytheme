[meta]
name = "Lumina Parchment Dark"
mode = "dark"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#efe5d0"
background = "#2a2116"
palette = [
    "#302619", "#d47169", "#92d3b9", "#e0ba6a",
    "#97bdf4", "#d4a3dc", "#85cbd3", "#cec4b0",
    "#9f9180", "#e1938b", "#aaeed2", "#fad484",
    "#bbd7ff", "#ecbef3", "#9ee5ee", "#efe5d0",
]
cursor = "#efe5d0"
cursor-text = "#2a2116"
selection-background = "#54452a"
selection-foreground = "#efe5d0"
