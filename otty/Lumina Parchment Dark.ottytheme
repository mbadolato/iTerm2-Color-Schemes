[meta]
name = "Lumina Parchment Dark"
mode = "dark"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#eee7d9"
background = "#342d21"
palette = [
    "#3a3224", "#db7d75", "#c3dcc7", "#f3cb7f",
    "#9ebde6", "#dd95ce", "#89c7ce", "#c5bfb1",
    "#a29785", "#e89e97", "#c4f7cd", "#ffe4b3",
    "#b8d7ff", "#ecb6e0", "#a1e1e8", "#eee7d9",
]
cursor = "#eee7d9"
cursor-text = "#342d21"
selection-background = "#4f584c"
selection-foreground = "#eee7d9"
