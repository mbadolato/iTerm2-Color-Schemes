[meta]
name = "Rainbows and Unicorns Workbench"
mode = "dark"

[terminal]
foreground = "#ffffff"
background = "#00408f"
palette = [
    "#000022", "#ffa79b", "#a6ee8e", "#ffd978",
    "#9ad2ff", "#f0b0f2", "#8cece2", "#dce6f2",
    "#7fa3cf", "#ffb066", "#c8f7b6", "#ffe9a6",
    "#c2e4ff", "#f7cff8", "#bcf5ee", "#ffffff",
]
cursor = "#ff8800"
cursor-text = "#00204a"
selection-background = "#ffffff"
selection-foreground = "#00408f"
