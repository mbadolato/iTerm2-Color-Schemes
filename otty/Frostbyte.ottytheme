[meta]
name = "Frostbyte"
mode = "light"

[terminal]
foreground = "#283645"
background = "#eef5fc"
palette = [
    "#283645", "#c2384f", "#2e7a56", "#876010",
    "#1a66be", "#5552cc", "#1a7e9e", "#586878",
    "#93a4b6", "#c2384f", "#2e7a56", "#9a5220",
    "#1a66be", "#5552cc", "#1a7e9e", "#283645",
]
cursor = "#1f73cc"
cursor-text = "#eef5fc"
selection-background = "#d2e4f4"
selection-foreground = "#a1a8af"
