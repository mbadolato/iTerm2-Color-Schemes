[meta]
name = "Cyberdyne"
mode = "dark"

[terminal]
foreground = "#00ff92"
background = "#151144"
palette = [
    "#080808", "#ff8373", "#00c172", "#d2a700",
    "#0071cf", "#ff90fe", "#6bffdd", "#f1f1f1",
    "#484848", "#ffc4be", "#d6fcba", "#fffed5",
    "#c2e3ff", "#ffb2fe", "#e6e7fe", "#ffffff",
]
cursor = "#00ff9c"
cursor-text = "#a6a6a6"
selection-background = "#454d96"
selection-foreground = "#f4f4f4"
