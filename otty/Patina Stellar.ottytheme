[meta]
name = "Patina Stellar"
mode = "light"

[terminal]
foreground = "#2e2a24"
background = "#f5f2ed"
palette = [
    "#2e2a24", "#a84040", "#3a7055", "#6e5817",
    "#2f626f", "#8a5a50", "#387775", "#5a5248",
    "#6a6258", "#bf3c3c", "#3e7a5e", "#826743",
    "#3f7381", "#9d594b", "#337675", "#393a34",
]
cursor = "#2e2a24"
cursor-text = "#f5f2ed"
selection-background = "#dbd5c5"
selection-foreground = "#2e2a24"
