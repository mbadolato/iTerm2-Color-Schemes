[meta]
name = "Bauhaus Light"
mode = "light"
author = "Damien Seguin (https://github.com/dmnsgn)"

[terminal]
foreground = "#2b2119"
background = "#e5dbd3"
palette = [
    "#2b2119", "#c5031f", "#546903", "#7e5c05",
    "#4060a3", "#9935a2", "#036d6c", "#afa59e",
    "#616161", "#8f0113", "#3b4b01", "#5a4100",
    "#254283", "#790d83", "#034d4d", "#f5ebe3",
]
cursor = "#9b0015"
cursor-text = "#e5dbd3"
selection-background = "#c1bdbe"
selection-foreground = "#2b2119"
