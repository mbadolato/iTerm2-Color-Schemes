[meta]
name = "iTerm2 Dark Background"
mode = "dark"

[terminal]
foreground = "#c7c7c7"
background = "#000000"
palette = [
    "#000000", "#c91b00", "#00c200", "#c7c400",
    "#0225c7", "#ca30c7", "#00c5c7", "#c7c7c7",
    "#686868", "#ff6e67", "#5ffa68", "#fffc67",
    "#6871ff", "#ff77ff", "#60fdff", "#ffffff",
]
cursor = "#c7c7c7"
cursor-text = "#8c8c8c"
selection-background = "#c1deff"
selection-foreground = "#000000"
