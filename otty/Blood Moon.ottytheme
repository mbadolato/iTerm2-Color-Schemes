[meta]
name = "Blood Moon"
mode = "dark"

[terminal]
foreground = "#fff0dc"
background = "#4b080d"
palette = [
    "#bbaaad", "#f17c78", "#9cca8e", "#e5c36b",
    "#8db9d8", "#cd97b7", "#7fc6c1", "#fff0dc",
    "#cfbfc1", "#f49894", "#b0d6a3", "#edd389",
    "#a8cbe2", "#dab0c7", "#9dd5d0", "#fffaf0",
]
cursor = "#ff454b"
cursor-text = "#4b080d"
selection-background = "#741b22"
selection-foreground = "#fff8ec"
