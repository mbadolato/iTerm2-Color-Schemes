[meta]
name = "Gruber Darker"
mode = "dark"

[terminal]
foreground = "#e4e4ef"
background = "#181818"
palette = [
    "#181818", "#f43841", "#73c936", "#ffdd33",
    "#96a6c8", "#9e95c7", "#95a99f", "#e4e4ef",
    "#52494e", "#ff4f58", "#73c936", "#ffdd33",
    "#96a6c8", "#afafd7", "#95a99f", "#f5f5f5",
]
cursor = "#ffdd33"
cursor-text = "#a6a6a6"
selection-background = "#ffffff"
selection-foreground = "#52494e"
