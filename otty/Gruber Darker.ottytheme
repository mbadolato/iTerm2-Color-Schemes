[meta]
name = "Gruber Darker"
mode = "dark"

[terminal]
foreground = "#e4e4e4"
background = "#181818"
palette = [
    "#181818", "#ff0a36", "#42dc00", "#ffdb00",
    "#92a7cb", "#a095cb", "#90aa9e", "#e4e4e4",
    "#54494e", "#ff3851", "#42dc00", "#ffdb00",
    "#92a7cb", "#afafda", "#90aa9e", "#f5f5f5",
]
cursor = "#ffdb00"
cursor-text = "#a6a6a6"
selection-background = "#ffffff"
selection-foreground = "#54494e"
