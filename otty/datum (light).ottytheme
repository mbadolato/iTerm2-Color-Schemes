[meta]
name = "datum (light)"
mode = "light"

[terminal]
foreground = "#292e35"
background = "#f1f6fd"
palette = [
    "#292e35", "#a24500", "#007553", "#656023",
    "#0176b8", "#973070", "#0d7a7f", "#b4b9bf",
    "#616a76", "#976700", "#007553", "#4d3919",
    "#2f516c", "#633750", "#154b4e", "#e7ecf2",
]
cursor = "#973070"
cursor-text = "#f1f6fd"
selection-background = "#ced3d9"
selection-foreground = "#292e35"
