[meta]
name = "Zacess Light"
mode = "light"

[terminal]
foreground = "#111111"
background = "#ffffff"
palette = [
    "#111111", "#ca010e", "#01751c", "#885a00",
    "#005fcc", "#b301ae", "#026f6f", "#484848",
    "#4d4d4d", "#e90112", "#008722", "#9d6902",
    "#006eed", "#cf01c7", "#028181", "#111111",
]
cursor = "#111111"
cursor-text = "#ffffff"
selection-background = "#fff1a8"
selection-foreground = "#111111"
