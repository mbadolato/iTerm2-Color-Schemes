[meta]
name = "Zacess Light"
mode = "light"

[terminal]
foreground = "#111111"
background = "#ffffff"
palette = [
    "#111111", "#640003", "#003708", "#412900",
    "#002c66", "#580055", "#003434", "#484848",
    "#4d4d4d", "#950007", "#005512", "#634100",
    "#004498", "#84007f", "#005151", "#111111",
]
cursor = "#111111"
cursor-text = "#ffffff"
selection-background = "#fff1a8"
selection-foreground = "#111111"
