[meta]
name = "Patina Dark Soft"
mode = "dark"

[terminal]
foreground = "#dbd7ca"
background = "#1a1a1a"
palette = [
    "#2e2e2e", "#cb7676", "#549c7d", "#e6cc77",
    "#6db3c2", "#c98a7d", "#5da9a7", "#dbd7ca",
    "#585858", "#cb7676", "#549c7d", "#e6cc77",
    "#6db3c2", "#c98a7d", "#5da9a7", "#dbd7ca",
]
cursor = "#dbd7ca"
cursor-text = "#1a1a1a"
selection-background = "#3a3835"
selection-foreground = "#dbd7ca"
