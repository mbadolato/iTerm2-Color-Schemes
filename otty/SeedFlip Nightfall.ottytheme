[meta]
name = "SeedFlip Nightfall"
mode = "dark"

[terminal]
foreground = "#e4e4e7"
background = "#0a0a0f"
palette = [
    "#060609", "#f04242", "#42f07c", "#f0d342",
    "#428bf0", "#f042f0", "#42f0f0", "#f2f2f3",
    "#424256", "#f58989", "#89f5ad", "#f5e389",
    "#89b6f5", "#f589f5", "#89f5f5", "#ffffff",
]
cursor = "#818cf8"
cursor-text = "#0a0a0f"
selection-background = "#12121a"
selection-foreground = "#e4e4e7"
