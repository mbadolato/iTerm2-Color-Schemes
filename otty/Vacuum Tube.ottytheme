[meta]
name = "Vacuum Tube"
mode = "dark"

[terminal]
foreground = "#f7efe3"
background = "#0c0907"
palette = [
    "#bdb5aa", "#ff826d", "#79d09b", "#f5cb67",
    "#8fb4ee", "#d9a1e8", "#83d3dc", "#f7efe3",
    "#cec7bd", "#ff9e8e", "#99ddb4", "#f9dc89",
    "#adc8f4", "#e7bbed", "#a4e2e7", "#fffaf2",
]
cursor = "#ffc078"
cursor-text = "#0c0907"
selection-background = "#35251a"
selection-foreground = "#fff4e8"
