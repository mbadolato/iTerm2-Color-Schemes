[meta]
name = "Tinacious Design Dark"
mode = "dark"

[terminal]
foreground = "#cbcbf0"
background = "#1d1d26"
palette = [
    "#1d1d26", "#ff3399", "#00d364", "#ffcc66",
    "#00cbff", "#cc66ff", "#00ceca", "#cbcbf0",
    "#636667", "#ff2f92", "#00d364", "#ffd479",
    "#00cbff", "#d783ff", "#00d5d4", "#d5d6f3",
]
cursor = "#cbcbf0"
cursor-text = "#999999"
selection-background = "#ff3399"
selection-foreground = "#ffffff"
