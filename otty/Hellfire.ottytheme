    "#c5afa7", "#f2815f", "#a9bd72", "#e8bd4e",
    "#83a9c2", "#bf879f", "#76b6ad", "#f8e2c7",
    "#ccb9b2", "#f49072", "#b3c583", "#ebc563",
    "#92b3c9", "#c795ab", "#86bfb7", "#f9e5ce",
]
