[meta]
name = "Arizona Monsoon"
mode = "dark"

[terminal]
foreground = "#e6e8ed"
background = "#0a0f14"
palette = [
    "#1f2937", "#e35d4a", "#7cc46b", "#e6b441",
    "#5b9dff", "#c678dd", "#2dd4bf", "#e8e2d1",
    "#4b5563", "#ff7b6b", "#98d98e", "#ffd166",
    "#7dbfff", "#d48cff", "#52e0cf", "#f7ead1",
]
cursor = "#f4d06f"
cursor-text = "#0a0f14"
selection-background = "#334155"
selection-foreground = "#e6e8ed"
