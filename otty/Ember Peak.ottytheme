[meta]
name = "Ember Peak"
mode = "dark"

[terminal]
foreground = "#f8fafc"
background = "#0a0a0f"
palette = [
    "#b7b5b2", "#ff806f", "#65d493", "#ffd166",
    "#86b5ff", "#e29aff", "#b8e7ef", "#f8fafc",
    "#cbc8c3", "#ff9b8f", "#84e0a8", "#ffe18a",
    "#a8c9ff", "#ecb2ff", "#c5eef4", "#ffffff",
]
cursor = "#ffb86b"
cursor-text = "#1a0f08"
selection-background = "#2b1f16"
selection-foreground = "#fff1df"
