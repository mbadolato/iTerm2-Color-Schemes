[meta]
name = "Arthur"
mode = "dark"

[terminal]
foreground = "#ddeedd"
background = "#1c1c1c"
palette = [
    "#3d352a", "#cd5c5c", "#86af80", "#e8ae5b",
    "#6495ed", "#deb887", "#b0c4de", "#bbaa99",
    "#554444", "#cc5533", "#88aa22", "#ffa75d",
    "#87ceeb", "#996600", "#b0c4de", "#ddccbb",
]
cursor = "#e2bbef"
cursor-text = "#000000"
selection-background = "#4d4d4d"
selection-foreground = "#ffffff"
