[meta]
name = "Sakura"
mode = "dark"

[terminal]
foreground = "#dd7bdc"
background = "#18131e"
palette = [
    "#000000", "#d52370", "#41af1a", "#bc7053",
    "#6964ab", "#c71fbf", "#939393", "#998eac",
    "#786d69", "#f41d99", "#22e529", "#f59574",
    "#9892f1", "#e90cdd", "#eeeeee", "#cbb6ff",
]
cursor = "#ff65fd"
cursor-text = "#24242e"
selection-background = "#c05cbf"
selection-foreground = "#24242e"
