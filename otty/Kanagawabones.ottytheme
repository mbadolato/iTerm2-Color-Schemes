[meta]
name = "Kanagawabones"
mode = "dark"

[terminal]
foreground = "#ddd8bb"
background = "#1f1f28"
palette = [
    "#1f1f28", "#e46a78", "#98bc6d", "#e5c283",
    "#7eb3c9", "#957fb8", "#7eb3c9", "#ddd8bb",
    "#49495e", "#ec818c", "#9ec967", "#f1c982",
    "#7bc2df", "#a98fd2", "#7bc2df", "#a8a48d",
]
cursor = "#e6e0c2"
cursor-text = "#1f1f28"
selection-background = "#49473e"
selection-foreground = "#ddd8bb"
