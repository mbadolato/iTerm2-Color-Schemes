[meta]
name = "Claude Light"
mode = "light"

[terminal]
foreground = "#141413"
background = "#faf9f5"
palette = [
    "#0a0a0a", "#a84b3a", "#2e7c4c", "#8a6220",
    "#184e95", "#882b4d", "#066049", "#b6b5aa",
    "#51504d", "#e34a4a", "#639900", "#b87700",
    "#3886e5", "#d55382", "#199f70", "#e2e1da",
]
cursor = "#d97757"
cursor-text = "#faf9f5"
selection-background = "#f0eee6"
selection-foreground = "#141413"
