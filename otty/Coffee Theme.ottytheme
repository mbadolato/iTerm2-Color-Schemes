[meta]
name = "Coffee Theme"
mode = "light"

[terminal]
foreground = "#000000"
background = "#f5deb3"
palette = [
    "#000000", "#c91b00", "#00c200", "#adaa00",
    "#0225c7", "#ca30c7", "#00b8ba", "#a1a1a1",
    "#686868", "#ff6e67", "#1fba28", "#b2af1b",
    "#6871ff", "#f26af2", "#20bdbf", "#ffffff",
]
cursor = "#a1a1a1"
cursor-text = "#fffc67"
selection-background = "#c1deff"
selection-foreground = "#000000"
