[meta]
name = "Modus Operandi Tinted"
mode = "light"
author = "Protesilaos Stavrou (https://protesilaos.com/)"

[terminal]
foreground = "#000000"
background = "#fbf7f0"
palette = [
    "#000000", "#a60000", "#006800", "#6f5500",
    "#0031a9", "#721045", "#005e8b", "#a6a6a6",
    "#595959", "#972500", "#00663f", "#884900",
    "#3548cf", "#531ab6", "#005f5f", "#595959",
]
cursor = "#d00000"
cursor-text = "#fbf7f0"
selection-background = "#c2bcb5"
selection-foreground = "#000000"
