[meta]
name = "X Praha"
mode = "dark"

[terminal]
foreground = "#ffffff"
background = "#1a1a1a"
palette = [
    "#1a1a1a", "#ff5555", "#b8e6a0", "#ffe4a3",
    "#bd93f9", "#ff9aa2", "#8be9fd", "#ffffff",
    "#6272a4", "#ff6e6e", "#b8e6a0", "#ffe4a3",
    "#d6acff", "#ff9aa2", "#a4ffff", "#ffffff",
]
cursor = "#ffffff"
cursor-text = "#1a1a1a"
selection-background = "#ffffff"
selection-foreground = "#1a1a1a"
