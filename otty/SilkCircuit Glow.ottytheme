[meta]
name = "SilkCircuit Glow"
mode = "dark"
author = "Stefanie Jane (https://github.com/hyperb1iss/silkcircuit)"

[terminal]
foreground = "#ffffff"
background = "#0a0816"
palette = [
    "#000000", "#ff2244", "#00ff00", "#ffff00",
    "#0099ff", "#ff00ff", "#00ffff", "#ffffff",
    "#818181", "#ff6666", "#66ff66", "#ffff66",
    "#66ccff", "#ff66ff", "#66ffff", "#ffffff",
]
cursor = "#00ffff"
cursor-text = "#0a0816"
selection-background = "#4b0654"
selection-foreground = "#ffffff"
