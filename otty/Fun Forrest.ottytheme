[meta]
name = "Fun Forrest"
mode = "dark"

[terminal]
foreground = "#dec165"
background = "#251200"
palette = [
    "#000000", "#d6262b", "#919c00", "#be8a13",
    "#4699a3", "#8d4331", "#da8213", "#ddc265",
    "#7f6a55", "#e55a1c", "#bfc65a", "#ffcb1b",
    "#7cc9cf", "#d26349", "#e6a96b", "#ffeaa3",
]
cursor = "#e5591c"
