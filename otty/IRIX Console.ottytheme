[meta]
name = "IRIX Console"
mode = "dark"

[terminal]
foreground = "#f2f2f2"
background = "#0c0c0c"
palette = [
    "#1a1919", "#d42426", "#37a327", "#c29d28",
    "#0739e2", "#911f9c", "#4497df", "#cccccc",
    "#767676", "#f34f59", "#45c731", "#f9f2a7",
    "#4079ff", "#c31ba2", "#6ed7d7", "#f2f2f2",
]
cursor = "#c7c7c7"
cursor-text = "#8c8c8c"
selection-background = "#c2deff"
selection-foreground = "#000000"
