[meta]
name = "Nord Light"
mode = "light"

[terminal]
foreground = "#414858"
background = "#e5e9f0"
palette = [
    "#3b4252", "#bf616a", "#96b17f", "#c5a565",
    "#81a1c1", "#b48ead", "#7bb3c3", "#a5abb6",
    "#4c566a", "#bf616a", "#96b17f", "#c5a565",
    "#81a1c1", "#b48ead", "#82afae", "#eceff4",
]
cursor = "#7bb3c3"
cursor-text = "#3b4252"
selection-background = "#d8dee9"
selection-foreground = "#4c556a"
