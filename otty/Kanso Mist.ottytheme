[meta]
name = "Kanso Mist"
mode = "dark"

[terminal]
foreground = "#c5c9c7"
background = "#22262d"
palette = [
    "#22262d", "#c4746e", "#8a9a7b", "#c4b28a",
    "#8ba4b0", "#a292a3", "#8ea4a2", "#a4a7a4",
    "#5c6066", "#e46876", "#87a987", "#e6c384",
    "#7fb4ca", "#938aa9", "#7aa89f", "#c5c9c7",
]
cursor = "#c5c9c7"
cursor-text = "#22262d"
selection-background = "#43464e"
selection-foreground = "#c5c9c7"
