[meta]
name = "Aardvark Ink"
mode = "dark"

[terminal]
foreground = "#b4bcca"
background = "#0f141f"
palette = [
    "#222734", "#c26265", "#52aa60", "#ad9b49",
    "#487fd4", "#af5bd1", "#269d9a", "#5a6377",
    "#3a4152", "#e48383", "#75cf84", "#c7b461",
    "#76a8f2", "#d58bf0", "#52c4c0", "#dfe5ee",
]
cursor = "#b4bcca"
cursor-text = "#0f141f"
selection-background = "#2a3645"
selection-foreground = "#dfe5ee"
