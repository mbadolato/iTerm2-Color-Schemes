[meta]
name = "iTerm2 Tango Light"
mode = "light"

[terminal]
foreground = "#000000"
background = "#ffffff"
palette = [
    "#000000", "#d81e00", "#5ea702", "#cfae00",
    "#427ab3", "#89658e", "#00a7aa", "#c1c4be",
    "#686a66", "#f54235", "#8cd636", "#d7c53b",
    "#84b0d8", "#bc94b7", "#1eccce", "#f1f1f0",
]
cursor = "#000000"
cursor-text = "#ffffff"
selection-background = "#c1deff"
selection-foreground = "#000000"
