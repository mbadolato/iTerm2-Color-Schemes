[meta]
name = "Melange Light"
mode = "light"

[terminal]
foreground = "#54433a"
background = "#f1f1f1"
palette = [
    "#e9e1db", "#c77b8b", "#6e9b72", "#bc5c00",
    "#7892bd", "#be79bb", "#739797", "#7d6658",
    "#a98a78", "#bf0021", "#3a684a", "#a06d00",
    "#465aa4", "#904180", "#3d6568", "#54433a",
]
cursor = "#54433a"
cursor-text = "#f1f1f1"
selection-background = "#54433a"
selection-foreground = "#d9d3ce"
