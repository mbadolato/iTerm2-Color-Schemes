[meta]
name = "Syncopation"
mode = "dark"

[terminal]
foreground = "#d6dad4"
background = "#0e1317"
palette = [
    "#222b34", "#e8705e", "#94c27e", "#e9ad4e",
    "#6fa3d8", "#d08aa3", "#4dbaae", "#b4bbb6",
    "#76828d", "#ff7b5e", "#b3dd9d", "#ffc03d",
    "#98c4f2", "#f2afc2", "#86ddd2", "#f0f2ec",
]
cursor = "#ffb23d"
cursor-text = "#0e1317"
selection-background = "#23384a"
selection-foreground = "#f0f2ec"
