[meta]
name = "Paul Millr"
mode = "dark"

[terminal]
foreground = "#f2f2f2"
background = "#000000"
palette = [
    "#2a2a2a", "#ff0000", "#79ff0f", "#e7bf00",
    "#396bd7", "#b449be", "#66ccff", "#bbbbbb",
    "#666666", "#ff0080", "#66ff66", "#f3d64e",
    "#709aed", "#db67e6", "#7adff2", "#ffffff",
]
cursor = "#4d4d4d"
cursor-text = "#ffffff"
selection-background = "#414141"
selection-foreground = "#ffffff"
