[meta]
name = "Haunted House"
mode = "dark"

[terminal]
foreground = "#f1f4ed"
background = "#23394e"
palette = [
    "#b9c2c9", "#ed9b8c", "#9fcba7", "#e5cb7c",
    "#9fc7e5", "#c2add8", "#93d0d0", "#f1f4ed",
    "#ccd3d8", "#f1afa3", "#b3d8ba", "#edda99",
    "#b8d6ec", "#d0c2e0", "#addddd", "#ffffff",
]
cursor = "#d5e2ee"
cursor-text = "#23394e"
selection-background = "#40566a"
selection-foreground = "#ffffff"
