[meta]
name = "Karma Light"
mode = "light"

[terminal]
foreground = "#0a0e14"
background = "#ffffff"
palette = [
    "#0a0e14", "#fc618d", "#2d972f", "#eeae11",
    "#5688c7", "#6f42c1", "#5688c7", "#525053",
    "#999999", "#fc618d", "#2d972f", "#ffaa33",
    "#5688c7", "#a86efd", "#5688c7", "#0a0e14",
]
cursor = "#a86efd"
cursor-text = "#ffffff"
selection-background = "#e5e3ea"
selection-foreground = "#0a0e14"
