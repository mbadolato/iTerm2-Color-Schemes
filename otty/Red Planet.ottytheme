[meta]
name = "Red Planet"
mode = "dark"

[terminal]
foreground = "#c2b790"
background = "#222222"
palette = [
    "#202020", "#8c3432", "#728271", "#e8bf6a",
    "#69819e", "#896492", "#5b8390", "#b9aa99",
    "#676767", "#b55242", "#869985", "#ebeb91",
    "#60827e", "#de4974", "#38add8", "#d6bfb8",
]
cursor = "#c2b790"
cursor-text = "#202020"
selection-background = "#1b324a"
selection-foreground = "#bcb291"
