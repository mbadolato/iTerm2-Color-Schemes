[meta]
name = "Duotone Dark"
mode = "dark"

[terminal]
foreground = "#b7a1ff"
background = "#1f1d27"
palette = [
    "#1f1d27", "#d9393e", "#2dcd73", "#d9b76e",
    "#ffc284", "#de8d40", "#2488ff", "#b7a1ff",
    "#4e4a60", "#d9393e", "#2dcd73", "#d9b76e",
    "#ffc284", "#de8d40", "#2488ff", "#eae5ff",
]
cursor = "#ff9839"
cursor-text = "#1f1d27"
selection-background = "#353147"
selection-foreground = "#b7a2ff"
