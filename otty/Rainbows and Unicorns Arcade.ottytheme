[meta]
name = "Rainbows and Unicorns Arcade"
mode = "dark"

[terminal]
foreground = "#ededed"
background = "#000000"
palette = [
    "#1a1a1a", "#ff2a4d", "#39ff14", "#fff01f",
    "#1f8bff", "#ff2cf0", "#00f0ff", "#c8c8c8",
    "#6e6e6e", "#ff8a1f", "#8cff75", "#fff777",
    "#6fb4ff", "#ff7df5", "#7af7ff", "#ffffff",
]
cursor = "#39ff14"
cursor-text = "#000000"
selection-background = "#39ff14"
selection-foreground = "#000000"
