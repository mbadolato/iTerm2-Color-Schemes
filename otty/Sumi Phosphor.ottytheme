[meta]
name = "Sumi Phosphor"
mode = "dark"
author = "Grok Build Composer 2.5 Fast"

[terminal]
foreground = "#bab4a8"
background = "#12100e"
palette = [
    "#1e1a16", "#d45848", "#5ca868", "#d4a03c",
    "#5a82b8", "#9870b0", "#2ec4b6", "#8a8478",
    "#474139", "#e87060", "#72c078", "#e8b84c",
    "#70a0d8", "#b088c8", "#48d8c8", "#e0dcd4",
]
cursor = "#2ec4b6"
cursor-text = "#12100e"
selection-background = "#3a3834"
selection-foreground = "#e8e4dc"
