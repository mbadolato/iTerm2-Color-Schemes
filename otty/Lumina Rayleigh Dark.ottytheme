[meta]
name = "Lumina Rayleigh Dark"
mode = "dark"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#d4dfeb"
background = "#091d30"
palette = [
    "#0b2237", "#d96d65", "#96d2a2", "#f1cc79",
    "#6fc3ff", "#eea3c9", "#afdee6", "#b4bfca",
    "#849bb4", "#e59088", "#aeedbb", "#ffe5ad",
    "#aadaff", "#ffc3e0", "#b6f4ff", "#d4dfeb",
]
cursor = "#d4dfeb"
cursor-text = "#091d30"
selection-background = "#204360"
selection-foreground = "#d4dfeb"
