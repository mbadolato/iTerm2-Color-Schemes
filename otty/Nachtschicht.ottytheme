[meta]
name = "Nachtschicht"
mode = "dark"

[terminal]
foreground = "#e8eaed"
background = "#17191d"
palette = [
    "#0e1012", "#e5484d", "#33d17a", "#e3b341",
    "#4d7cfe", "#c86ad8", "#3fc8b0", "#c9cfd6",
    "#9da4af", "#ef8f92", "#76e0a5", "#edcf88",
    "#9eb8fe", "#e0abe9", "#7edaca", "#e8eaed",
]
cursor = "#e3b341"
cursor-text = "#17191d"
selection-background = "#36393c"
selection-foreground = "#e8eaed"
