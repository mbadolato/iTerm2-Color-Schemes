[meta]
name = "Yngwie's Strat"
mode = "light"

[terminal]
foreground = "#25231f"
background = "#fbe68b"
palette = [
    "#342d27", "#9c2922", "#37663e", "#785015",
    "#244f85", "#67416c", "#17616b", "#3e3730",
    "#51463b", "#b0392b", "#3b6d45", "#845b16",
    "#315e9c", "#795080", "#206f79", "#272522",
]
cursor = "#9c2922"
cursor-text = "#fff2bd"
selection-background = "#b6a251"
selection-foreground = "#211e19"
