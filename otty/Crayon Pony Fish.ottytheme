[meta]
name = "Crayon Pony Fish"
mode = "dark"

[terminal]
foreground = "#68525a"
background = "#150707"
palette = [
    "#2b1b1d", "#91002b", "#579524", "#ab311b",
    "#8c87b0", "#692f50", "#e8a866", "#68525a",
    "#4a383b", "#c5255d", "#8dff57", "#c8381d",
    "#cfc9ff", "#fc6cba", "#ffceaf", "#b0949d",
]
cursor = "#68525a"
cursor-text = "#140707"
selection-background = "#2b1b1d"
selection-foreground = "#69525a"
