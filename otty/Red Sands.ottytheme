[meta]
name = "Red Sands"
mode = "dark"

[terminal]
foreground = "#d7c9a7"
background = "#7a251e"
palette = [
    "#000000", "#ff3f00", "#00bb00", "#e7b000",
    "#0072ff", "#bb00bb", "#00bbbb", "#bbbbbb",
    "#6e6e6e", "#d41a1a", "#00bb00", "#e7b000",
    "#0072ae", "#ff55ff", "#55ffff", "#ffffff",
]
cursor = "#ffffff"
cursor-text = "#000000"
selection-background = "#a4a390"
selection-foreground = "#000000"
