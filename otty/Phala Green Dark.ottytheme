[meta]
name = "Phala Green Dark"
mode = "dark"

[terminal]
foreground = "#c1fc03"
background = "#000000"
palette = [
    "#000000", "#ab1500", "#00b100", "#a9a700",
    "#0223c0", "#c22ec0", "#00b4c0", "#cbcbcb",
    "#797979", "#ed2200", "#00db00", "#eae700",
    "#0433ff", "#ed3aea", "#00e8ea", "#eaeaea",
]
cursor = "#c1fc03"
cursor-text = "#ff271d"
selection-background = "#014804"
selection-foreground = "#ffffff"
