[meta]
name = "Oceanic Material"
mode = "dark"

[terminal]
foreground = "#c2c8d7"
background = "#1c262b"
palette = [
    "#000000", "#ee2b2a", "#40a33f", "#ffea2e",
    "#1e80f0", "#8800a0", "#16afca", "#a4a4a4",
    "#777777", "#dc5c60", "#70be71", "#fff163",
    "#54a4f3", "#aa4dbc", "#42c7da", "#ffffff",
]
cursor = "#b3b8c3"
cursor-text = "#ffffff"
selection-background = "#6dc2b8"
selection-foreground = "#e8eefd"
