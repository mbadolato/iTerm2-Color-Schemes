[meta]
name = "Prince of Barkness"
mode = "dark"

[terminal]
foreground = "#f1dfbf"
background = "#100e17"
palette = [
    "#7d7b86", "#f16b77", "#6fe0a2", "#f6c85a",
    "#8eaeff", "#d5a0f5", "#6adbe2", "#f1dfbf",
    "#81798f", "#ff8e99", "#92f2b8", "#ffe08b",
    "#b7c8ff", "#e7b8ff", "#94eef0", "#fff4de",
]
cursor = "#f6c85a"
