[meta]
name = "Obsidian"
mode = "dark"

[terminal]
foreground = "#cdcdcd"
background = "#283033"
palette = [
    "#000000", "#b30d0e", "#00bb00", "#fecd22",
    "#3a9bdb", "#bb00bb", "#00bbbb", "#bbbbbb",
    "#555555", "#ff0003", "#93c863", "#fef874",
    "#a1d7ff", "#ff55ff", "#55ffff", "#ffffff",
]
cursor = "#c0cad0"
cursor-text = "#8d8d8d"
selection-background = "#3e4c4f"
selection-foreground = "#dfe1e2"
