[meta]
name = "Zacess High Contrast Light"
mode = "light"

[terminal]
foreground = "#000000"
background = "#ffffff"
palette = [
    "#000000", "#ca0000", "#017424", "#875b00",
    "#005bdc", "#b400ac", "#006f6e", "#3d3d3d",
    "#333333", "#e90100", "#018726", "#9c6a01",
    "#016eee", "#cf00c6", "#028181", "#000000",
]
cursor = "#000000"
cursor-text = "#ffffff"
selection-background = "#015f5e"
selection-foreground = "#ffffff"
