[meta]
name = "Zacess High Contrast Light"
mode = "light"

[terminal]
foreground = "#000000"
background = "#ffffff"
palette = [
    "#000000", "#8b0000", "#005518", "#5c3d00",
    "#003d99", "#6b0066", "#004f4e", "#3d3d3d",
    "#333333", "#a30000", "#00661a", "#6b4700",
    "#0049a3", "#80007a", "#005f5f", "#000000",
]
cursor = "#000000"
cursor-text = "#ffffff"
selection-background = "#fff1a0"
selection-foreground = "#000000"
