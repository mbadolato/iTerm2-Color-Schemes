    "#383838", "#a95551", "#666666", "#a98051",
    "#657d3e", "#767676", "#c9c9c9", "#d0b8a3",
    "#545454", "#a97775", "#8c8c8c", "#a99175",
    "#98bd5e", "#a3a3a3", "#dcdcdc", "#d8c8bb",
]
cursor = "#aa9175"
