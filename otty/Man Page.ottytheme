[meta]
name = "Man Page"
mode = "light"

[terminal]
foreground = "#000000"
background = "#fef49c"
palette = [
    "#000000", "#cc0000", "#00a600", "#999900",
    "#0000b2", "#b200b2", "#00a6b2", "#b2b2b2",
    "#666666", "#e50000", "#00cc00", "#bfbf00",
    "#0000ff", "#e500e5", "#00cbcb", "#e5e5e5",
]
cursor = "#7f7f7f"
cursor-text = "#000000"
selection-background = "#a4c9cd"
selection-foreground = "#000000"
