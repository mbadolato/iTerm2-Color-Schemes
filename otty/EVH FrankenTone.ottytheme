[meta]
name = "EVH FrankenTone"
mode = "dark"

[terminal]
foreground = "#f7ede5"
background = "#76231f"
palette = [
    "#e7d8d0", "#ffb4a5", "#e6d27e", "#f4d45d",
    "#a9cbe7", "#d9c3c9", "#a7d7d7", "#f7ede5",
    "#c9b8b1", "#ffd0bf", "#f2e4a0", "#ffe27d",
    "#c5ddf3", "#f0d8de", "#c4e9e8", "#ffffff",
]
cursor = "#f5cc48"
cursor-text = "#171313"
selection-background = "#201719"
selection-foreground = "#ffffff"
