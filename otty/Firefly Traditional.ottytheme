[meta]
name = "Firefly Traditional"
mode = "dark"

[terminal]
foreground = "#f5f5f5"
background = "#000000"
palette = [
    "#000000", "#c23720", "#33bc26", "#afad24",
    "#5a63ff", "#d53ad2", "#33bbc7", "#cccccc",
    "#828282", "#ff3b1e", "#2ee720", "#ecec16",
    "#838dff", "#ff5cfe", "#29f0f0", "#ebebeb",
]
cursor = "#00f900"
cursor-text = "#999999"
selection-background = "#cfeac6"
selection-foreground = "#000000"
