[meta]
name = "Night Owl"
mode = "dark"

[terminal]
foreground = "#d6deeb"
background = "#011627"
palette = [
    "#011627", "#ef5350", "#22da6e", "#addb67",
    "#82aaff", "#c792ea", "#21c7a8", "#ffffff",
    "#575656", "#ef5350", "#22da6e", "#ffeb95",
    "#82aaff", "#c792ea", "#7fdbca", "#ffffff",
]
cursor = "#7e57c2"
cursor-text = "#ffffff"
selection-background = "#5f7e97"
selection-foreground = "#dfe5ee"
