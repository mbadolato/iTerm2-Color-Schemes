[meta]
name = "Parchment"
mode = "light"

[terminal]
foreground = "#1a1a1a"
background = "#fdf7e7"
palette = [
    "#292929", "#851c1c", "#0d6030", "#685000",
    "#164a9b", "#663194", "#004a58", "#3c3a36",
    "#55514b", "#922323", "#084d2a", "#594500",
    "#123a78", "#523073", "#004957", "#47433e",
]
cursor = "#7a5700"
cursor-text = "#fffaf0"
selection-background = "#e5dcc3"
selection-foreground = "#1a1a1a"
