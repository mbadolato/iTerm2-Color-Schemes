[meta]
name = "Copper Canyon"
mode = "dark"

[terminal]
foreground = "#fff0d5"
background = "#5a3018"
palette = [
    "#d6c8b8", "#ffa17e", "#94d9a5", "#f5cf69",
    "#91c9ed", "#e5a7d0", "#85ddd6", "#fff0d5",
    "#e4d8ca", "#ffb698", "#ace2b8", "#ffdf8a",
    "#aed8f3", "#eebedc", "#a5e8e2", "#fffaf0",
]
cursor = "#f6bd55"
cursor-text = "#5a3018"
selection-background = "#7a4a2e"
selection-foreground = "#fff8e8"
