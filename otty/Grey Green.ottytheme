[meta]
name = "Grey Green"
mode = "dark"

[terminal]
foreground = "#ffffff"
background = "#002a1a"
palette = [
    "#000000", "#fe1414", "#74ff00", "#f1ff01",
    "#00deff", "#ff00f0", "#00ffbc", "#ffffff",
    "#666666", "#ff3939", "#00ff44", "#ffd100",
    "#00afff", "#ff008a", "#00ffd3", "#f5ecec",
]
cursor = "#fff400"
cursor-text = "#aeb1b0"
selection-background = "#517e50"
selection-foreground = "#e2e2e2"
