[meta]
name = "Trick or Treat"
mode = "dark"

[terminal]
foreground = "#fff0e3"
background = "#40145f"
palette = [
    "#bbaec8", "#ff8b82", "#a8dc72", "#f8c94e",
    "#8fc9f2", "#e78bd8", "#78dce1", "#fff0e3",
    "#cec1da", "#ffa5a0", "#bde88d", "#fbdc72",
    "#acd9f7", "#efaae3", "#99e7ea", "#fffaf2",
]
cursor = "#ff65bd"
