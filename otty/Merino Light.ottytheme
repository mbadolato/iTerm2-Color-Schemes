[meta]
name = "Merino Light"
mode = "light"

[terminal]
foreground = "#1f2328"
background = "#ffffff"
palette = [
    "#24292f", "#cf222e", "#116329", "#9d5c00",
    "#0969da", "#8250df", "#1b7c83", "#6e7781",
    "#57606a", "#a40e26", "#1a7f37", "#c47a00",
    "#218bff", "#a475f9", "#3192aa", "#8c959f",
]
cursor = "#0969da"
cursor-text = "#b6d8ff"
selection-background = "#1f2328"
selection-foreground = "#ffffff"
