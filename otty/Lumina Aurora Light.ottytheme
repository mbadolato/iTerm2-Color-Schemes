[meta]
name = "Lumina Aurora Light"
mode = "light"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#163236"
background = "#f2faf9"
palette = [
    "#163236", "#942a28", "#026d43", "#9f6116",
    "#425b7a", "#894c84", "#007386", "#59767b",
    "#556f71", "#6d2926", "#005734", "#864e01",
    "#17467d", "#733a6e", "#005d6d", "#77959a",
]
cursor = "#163236"
cursor-text = "#f2faf9"
selection-background = "#b9d4c9"
selection-foreground = "#163236"
