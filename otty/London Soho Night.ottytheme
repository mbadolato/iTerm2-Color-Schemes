[meta]
name = "London Soho Night"
mode = "dark"

[terminal]
foreground = "#ebe0c8"
background = "#1a1612"
palette = [
    "#2a221a", "#d4574a", "#8fae5e", "#e8b04a",
    "#6a8fb5", "#d96aa5", "#9ab8a8", "#ebe0c8",
    "#6b5a48", "#e87765", "#aac874", "#f4c560",
    "#88a8c8", "#ed85b8", "#b8cebd", "#f8eed2",
]
cursor = "#ff5db1"
cursor-text = "#1a1612"
selection-background = "#3a2f24"
selection-foreground = "#ebe0c8"
