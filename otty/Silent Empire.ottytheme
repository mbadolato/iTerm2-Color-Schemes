[meta]
name = "Silent Empire"
mode = "dark"

[terminal]
foreground = "#e3f3f5"
background = "#071e29"
palette = [
    "#a6a7a6", "#df8179", "#86c5a4", "#e6c579",
    "#7ab8ec", "#b399e9", "#71d6de", "#e3f3f5",
    "#c4c7c8", "#e4958e", "#99ceb3", "#eace8e",
    "#8fc3ef", "#bfa9ed", "#88dde3", "#fff9ee",
]
cursor = "#e6c579"
cursor-text = "#071e29"
selection-background = "#394653"
selection-foreground = "#fff8ee"
