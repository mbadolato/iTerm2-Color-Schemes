[meta]
name = "Adwaita"
mode = "light"

[terminal]
foreground = "#1d1d20"
background = "#ffffff"
palette = [
    "#1d1d20", "#c01c28", "#26a269", "#a2734c",
    "#12488b", "#a347ba", "#2aa1b3", "#c2c2c2",
    "#5d5d5d", "#f66151", "#33d17a", "#e9ad0c",
    "#2a7bde", "#c061cb", "#33c7de", "#ffffff",
]
cursor = "#1d1d20"
cursor-text = "#ffffff"
selection-background = "#1d1d20"
selection-foreground = "#ffffff"
