[meta]
name = "Evergreen"
mode = "dark"

[terminal]
foreground = "#e9f7ef"
background = "#032b1b"
palette = [
    "#aebfb6", "#ff8a82", "#82d6a5", "#f0d16e",
    "#8bb8ee", "#d6a5e5", "#82d7d2", "#e9f7ef",
    "#c5d1cb", "#ffa29b", "#a2e2bc", "#f6df90",
    "#abcdf4", "#e5bfed", "#a3e5e0", "#ffffff",
]
cursor = "#7cf0ad"
cursor-text = "#032b1b"
selection-background = "#18553a"
selection-foreground = "#f3fff7"
