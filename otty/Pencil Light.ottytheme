[meta]
name = "Pencil Light"
mode = "light"

[terminal]
foreground = "#424242"
background = "#f1f1f1"
palette = [
    "#212121", "#c30771", "#10a778", "#a89c14",
    "#008ec4", "#523c79", "#20a5ba", "#b3b3b3",
    "#424242", "#fb007a", "#52caa2", "#c0b100",
    "#20bbfc", "#6855de", "#4fb8cc", "#f1f1f1",
]
cursor = "#20bbfc"
cursor-text = "#424242"
selection-background = "#b6d6fd"
selection-foreground = "#424242"
