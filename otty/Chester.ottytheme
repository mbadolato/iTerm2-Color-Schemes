[meta]
name = "Chester"
mode = "dark"

[terminal]
foreground = "#ffffff"
background = "#2c3643"
palette = [
    "#080200", "#fa5e5b", "#16c98d", "#ffc83f",
    "#288ad6", "#d34590", "#28ddde", "#e7e7e7",
    "#6f6b68", "#fa5e5b", "#16c98d", "#feef6d",
    "#278ad6", "#d34590", "#27dede", "#ffffff",
]
cursor = "#b4b1b1"
cursor-text = "#000000"
selection-background = "#67747c"
selection-foreground = "#ffffff"
