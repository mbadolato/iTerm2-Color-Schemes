[meta]
name = "Lumina Quartz Dark"
mode = "dark"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#cdd0d4"
background = "#1a1b1c"
palette = [
    "#1f2021", "#d96e66", "#b9daaa", "#ddbb67",
    "#9cc2f4", "#e2a9dd", "#95e0e8", "#adb0b4",
    "#82898f", "#e59189", "#cbf8b6", "#f9d57d",
    "#c0dbff", "#fec2f8", "#acf7ff", "#cdd0d4",
]
cursor = "#cdd0d4"
cursor-text = "#1a1b1c"
selection-background = "#403b54"
selection-foreground = "#cdd0d4"
