[meta]
name = "Lumina Quartz Dark"
mode = "dark"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#ccd0d3"
background = "#161719"
palette = [
    "#1a1c1e", "#c57c74", "#9dd7b7", "#dfcfb0",
    "#b6ceed", "#e4bddf", "#a8d5db", "#acb0b3",
    "#868b90", "#d59a93", "#c2edd5", "#ffe5b1",
    "#d6e8ff", "#ffd7fa", "#c1eff6", "#ccd0d3",
]
cursor = "#ccd0d3"
cursor-text = "#161719"
selection-background = "#44474a"
selection-foreground = "#ccd0d3"
