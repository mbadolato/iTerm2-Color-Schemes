[meta]
name = "Stardust Voltage"
mode = "light"

[terminal]
foreground = "#27354e"
background = "#f0e5d9"
palette = [
    "#685c59", "#892c3e", "#346c51", "#745418",
    "#274988", "#684376", "#2b666f", "#27354e",
    "#534a47", "#792737", "#2e5f47", "#664a15",
    "#224078", "#5c3b68", "#265a62", "#1f2a3e",
]
cursor = "#664a15"
cursor-text = "#f0e5d9"
selection-background = "#dbc6c4"
selection-foreground = "#27354e"
