[meta]
name = "Sequoia Monochrome Dark"
mode = "dark"
author = "Michael Andreuzza (https://github.com/michael-andreuzza/Sequoia-Theme)"

[terminal]
foreground = "#868690"
background = "#0f1014"
palette = [
    "#131317", "#999eb2", "#626983", "#d3d5de",
    "#7c829d", "#e2e4ed", "#b6bac8", "#868690",
    "#575861", "#999eb2", "#626983", "#d3d5de",
    "#7c829d", "#e2e4ed", "#b6bac8", "#868690",
]
cursor = "#43444d"
cursor-text = "#868690"
selection-background = "#817c9c"
selection-foreground = "#acacb6"
