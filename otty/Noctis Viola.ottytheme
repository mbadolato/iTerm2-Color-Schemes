[meta]
name = "Noctis Viola"
mode = "dark"
author = "Liviu Schera (https://github.com/liviuschera), ported by Abel Dantas (https://github.com/abeldantas)"

[terminal]
foreground = "#ccbfd9"
background = "#30243d"
palette = [
    "#362f3d", "#e66533", "#49e9a6", "#e4b781",
    "#49ace9", "#df769b", "#49d6e9", "#bfafcf",
    "#594e65", "#e97749", "#60ebb1", "#e69533",
    "#60b6eb", "#e798b3", "#60dbeb", "#ccbfd9",
]
cursor = "#ccbfd9"
cursor-text = "#30243d"
selection-background = "#3e3352"
selection-foreground = "#ccbfd9"
