[meta]
name = "Arcoiris"
mode = "dark"

[terminal]
foreground = "#eee4d9"
background = "#201f1e"
palette = [
    "#333333", "#da2700", "#12c258", "#ffc656",
    "#518bfc", "#e37bd9", "#63fad5", "#bab2b2",
    "#777777", "#ffb9b9", "#e3f6aa", "#ffddaa",
    "#b3e8f3", "#cbbaf9", "#bcffc7", "#efefef",
]
cursor = "#872929"
cursor-text = "#fffbf2"
selection-background = "#25524a"
selection-foreground = "#f3fffd"
