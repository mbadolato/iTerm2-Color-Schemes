[meta]
name = "Horizon Bright"
mode = "light"

[terminal]
foreground = "#16161d"
background = "#fdf0ed"
palette = [
    "#16161d", "#fc4777", "#00ca86", "#f2a682",
    "#00bedd", "#ff58b1", "#00cdcb", "#bfafac",
    "#1a1c24", "#fe5f87", "#00d193", "#e5a688",
    "#00c9e2", "#ff6cba", "#00c3c2", "#fff2ef",
]
cursor = "#d3a89d"
cursor-text = "#ffe8dc"
selection-background = "#f9cec3"
selection-foreground = "#16161d"
