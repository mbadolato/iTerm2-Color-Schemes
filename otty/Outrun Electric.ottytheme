[meta]
name = "Outrun Electric"
mode = "dark"

[terminal]
foreground = "#f2f3f7"
background = "#0c0a20"
palette = [
    "#131033", "#e61f44", "#a7da1e", "#ffd400",
    "#1ea8fc", "#ff2afc", "#42c6ff", "#f2f3f7",
    "#546a90", "#ef6d85", "#c6e76d", "#ffe359",
    "#6dc6fd", "#df85ff", "#84daff", "#ffffff",
]
cursor = "#ff2afc"
cursor-text = "#0c0a20"
selection-background = "#ba45a3"
selection-foreground = "#f2f3f7"
