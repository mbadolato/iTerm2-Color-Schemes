[meta]
name = "Harvest Moon"
mode = "dark"

[terminal]
foreground = "#fff1d2"
background = "#0d3557"
palette = [
    "#b8c2c6", "#ee997d", "#9bca8e", "#edc667",
    "#8fc1dd", "#c7a1c8", "#80ced0", "#fff1d2",
    "#cbd3d6", "#f2ae92", "#b0d6a4", "#f4d585",
    "#aad1e7", "#d4b8d5", "#9edbdc", "#fff9e8",
]
cursor = "#f3b64a"
cursor-text = "#0d3557"
selection-background = "#2a5371"
selection-foreground = "#fff8e8"
