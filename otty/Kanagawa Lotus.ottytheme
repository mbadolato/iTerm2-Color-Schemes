[meta]
name = "Kanagawa Lotus"
mode = "light"

[terminal]
foreground = "#545464"
background = "#f2ecbc"
palette = [
    "#1f1f28", "#c84053", "#6f894e", "#77713f",
    "#4d699b", "#b35b79", "#597b75", "#545464",
    "#8a8980", "#d7474b", "#6e915f", "#836f4a",
    "#6693bf", "#624c83", "#5e857a", "#43436c",
]
cursor = "#43436c"
cursor-text = "#f2ecbc"
selection-background = "#545464"
selection-foreground = "#f2ecbc"
