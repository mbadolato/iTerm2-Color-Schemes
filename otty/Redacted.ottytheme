[meta]
name = "Redacted"
mode = "light"

[terminal]
foreground = "#171717"
background = "#fffdf8"
palette = [
    "#292929", "#821e1e", "#125b31", "#654b00",
    "#17458d", "#5e2e86", "#005766", "#393939",
    "#464646", "#8d2424", "#176238", "#6c5000",
    "#123a78", "#66368e", "#004a57", "#414141",
]
cursor = "#202020"
