[meta]
name = "Snazzy"
mode = "dark"

[terminal]
foreground = "#ebece6"
background = "#1e1f29"
palette = [
    "#000000", "#fc4346", "#50fb7c", "#f0fb8c",
    "#49baff", "#fc4cb4", "#8be9fe", "#ededec",
    "#555555", "#fc4346", "#50fb7c", "#f0fb8c",
    "#49baff", "#fc4cb4", "#8be9fe", "#ededec",
]
cursor = "#e4e4e4"
cursor-text = "#a9a9a9"
selection-background = "#81aec6"
selection-foreground = "#000000"
