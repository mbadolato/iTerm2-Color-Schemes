[meta]
name = "Lumina Cherenkov Dark"
mode = "dark"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#d7e7f5"
background = "#021129"
palette = [
    "#031530", "#db6c64", "#9ad8a6", "#ead293",
    "#4ca1ff", "#ecafe6", "#8fe7fd", "#b7c6d4",
    "#738fad", "#e79088", "#b2f3bf", "#ffe6a4",
    "#90bbee", "#ffcefa", "#bff2ff", "#d7e7f5",
]
cursor = "#d7e7f5"
cursor-text = "#021129"
selection-background = "#10325a"
selection-foreground = "#d7e7f5"
