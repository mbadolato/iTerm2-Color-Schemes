[meta]
name = "Lumina Cherenkov Dark"
mode = "dark"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#d0dce9"
background = "#0a111f"
palette = [
    "#0e1525", "#da6159", "#8bd29a", "#e0b955",
    "#c4dbed", "#e7a3e0", "#6ad0db", "#b0bcc8",
    "#79879c", "#e5867e", "#a4edb2", "#fcd36b",
    "#d3ecff", "#ffbff8", "#84eaf6", "#d0dce9",
]
cursor = "#d0dce9"
cursor-text = "#0a111f"
selection-background = "#252f52"
selection-foreground = "#d0dce9"
