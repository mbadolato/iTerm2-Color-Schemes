    "#a9a19f", "#f47c62", "#67c894", "#e9bd59",
    "#72c6c2", "#e778a8", "#65d5d0", "#ffe6c7",
    "#c0b4b0", "#ff986d", "#86d7a8", "#ffd071",
    "#8bd8d2", "#f194bd", "#89e2dc", "#fff4df",
]
cursor = "#ff9f2e"
