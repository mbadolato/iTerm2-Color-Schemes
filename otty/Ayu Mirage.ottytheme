[meta]
name = "Ayu Mirage"
mode = "dark"
author = "Ayu Theme (https://github.com/ayu-theme)"

[terminal]
foreground = "#cccac2"
background = "#1f2430"
palette = [
    "#171b24", "#ed8274", "#87d96c", "#facc6e",
    "#6dcbfa", "#dabafa", "#90e1c6", "#c7c7c7",
    "#686868", "#f28779", "#d5ff80", "#ffd173",
    "#73d0ff", "#dfbfff", "#95e6cb", "#ffffff",
]
cursor = "#ffcc66"
cursor-text = "#1f2430"
selection-background = "#409fff"
selection-foreground = "#1f2430"
