[meta]
name = "Kitty Low Contrast"
mode = "dark"

[terminal]
foreground = "#ffffff"
background = "#333333"
palette = [
    "#000000", "#cc0403", "#19cb00", "#cecb00",
    "#0d73cc", "#cb1ed1", "#0dcdcd", "#dddddd",
    "#767676", "#f2201f", "#23fd00", "#fffd00",
    "#1a8fff", "#fd28ff", "#14ffff", "#ffffff",
]
cursor = "#cccccc"
cursor-text = "#111111"
selection-background = "#fffacd"
selection-foreground = "#000000"
