[meta]
name = "Liquid Carbon"
mode = "dark"

[terminal]
foreground = "#afc2c2"
background = "#303030"
palette = [
    "#000000", "#ff3030", "#559a70", "#ccac00",
    "#0099cc", "#cc69c8", "#7ac4cc", "#bccccc",
    "#595959", "#ff3030", "#559a70", "#ccac00",
    "#0099cc", "#cc69c8", "#7ac4cc", "#bccccc",
]
cursor = "#ffffff"
cursor-text = "#000000"
selection-background = "#7dbeff"
selection-foreground = "#000000"
