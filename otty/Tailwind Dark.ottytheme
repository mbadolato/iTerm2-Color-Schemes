[meta]
name = "Tailwind Dark"
mode = "dark"

[terminal]
foreground = "#e5e5e5"
background = "#262626"
palette = [
    "#404040", "#f87171", "#4ade80", "#facc15",
    "#38bdf8", "#e879f9", "#2dd4bf", "#e5e5e5",
    "#a3a3a3", "#fca5a5", "#86efac", "#fde047",
    "#7dd3fc", "#f0abfc", "#5eead4", "#f5f5f5",
]
cursor = "#e5e5e5"
cursor-text = "#262626"
selection-background = "#475569"
selection-foreground = "#e5e5e5"
