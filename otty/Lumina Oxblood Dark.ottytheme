[meta]
name = "Lumina Oxblood Dark"
mode = "dark"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#e8d6dc"
background = "#200f16"
palette = [
    "#26131b", "#db6c63", "#7dc797", "#f9c875",
    "#9ac3f8", "#ddb7ed", "#6fcad4", "#c7b6bc",
    "#a6838f", "#e78f86", "#9ce0b2", "#ffe4b8",
    "#c2dcff", "#f2d5ff", "#8de4ed", "#e8d6dc",
]
cursor = "#e8d6dc"
cursor-text = "#200f16"
selection-background = "#522c3d"
selection-foreground = "#e8d6dc"
