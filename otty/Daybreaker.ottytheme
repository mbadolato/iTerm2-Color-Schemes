[meta]
name = "Daybreaker"
mode = "light"

[terminal]
foreground = "#1e1e1e"
background = "#fffaf6"
palette = [
    "#292929", "#9f1717", "#075523", "#594300",
    "#1452ad", "#6f2d9b", "#005064", "#3d3d3d",
    "#555555", "#a91e1e", "#075923", "#5d4700",
    "#16478f", "#7434a1", "#005369", "#484848",
]
cursor = "#8a4b00"
cursor-text = "#fffaf6"
selection-background = "#e5e1d8"
selection-foreground = "#1e1e1e"
