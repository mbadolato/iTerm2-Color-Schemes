[meta]
name = "Zenbones"
mode = "light"

[terminal]
foreground = "#2c363c"
background = "#f0edec"
palette = [
    "#f0edec", "#a8334c", "#4f6c31", "#944927",
    "#286486", "#88507d", "#3b8992", "#2c363c",
    "#b5a7a0", "#94253e", "#3f5a22", "#803d1c",
    "#1d5573", "#7b3b70", "#2b747c", "#4f5e68",
]
cursor = "#2c363c"
cursor-text = "#f0edec"
selection-background = "#cbd9e3"
selection-foreground = "#2c363c"
