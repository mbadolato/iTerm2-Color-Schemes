[meta]
name = "Graveyard Shift"
mode = "dark"

[terminal]
foreground = "#eef2e8"
background = "#2e4240"
palette = [
    "#c0cbc5", "#ed9b86", "#9fc79a", "#dfc977",
    "#91bcc8", "#b6a5c0", "#87c7c2", "#eef2e8",
    "#c8d1cc", "#efa795", "#abcea6", "#e3cf87",
    "#9ec4cf", "#bfb0c8", "#95cec9", "#f0f4eb",
]
cursor = "#efa795"
cursor-text = "#2e4240"
selection-background = "#c8d1cc"
selection-foreground = "#979b92"
