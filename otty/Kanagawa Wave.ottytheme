[meta]
name = "Kanagawa Wave"
mode = "dark"

[terminal]
foreground = "#dcd7ba"
background = "#1f1f28"
palette = [
    "#090618", "#c34043", "#76946a", "#c0a36e",
    "#7e9cd8", "#957fb8", "#6a9589", "#c8c093",
    "#727169", "#e82424", "#98bb6c", "#e6c384",
    "#7fb4ca", "#938aa9", "#7aa89f", "#dcd7ba",
]
cursor = "#dcd7ba"
cursor-text = "#1f1f28"
selection-background = "#dcd7ba"
selection-foreground = "#1f1f28"
