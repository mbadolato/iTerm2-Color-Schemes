[meta]
name = "Saffron Nightfall"
mode = "dark"

[terminal]
foreground = "#d9d4c8"
background = "#131320"
palette = [
    "#1e1e30", "#e0705f", "#9cb56b", "#ffc247",
    "#7d8fd0", "#bb87c0", "#76b7ad", "#b7b2a5",
    "#625f72", "#ee8b7a", "#b6cc87", "#ffd36e",
    "#98a9e0", "#d0a3d3", "#93cfc5", "#f1ecdf",
]
cursor = "#ffc247"
cursor-text = "#131320"
selection-background = "#33324e"
selection-foreground = "#f1ecdf"
