[meta]
name = "Sumi Linen"
mode = "light"
author = "Grok Build Composer 2.5 Fast"

[terminal]
foreground = "#1c1814"
background = "#e6dfd0"
palette = [
    "#3a342c", "#b83830", "#2e8050", "#a87820",
    "#3060a0", "#704890", "#18786c", "#5a5448",
    "#6a6458", "#c84840", "#3a9868", "#c09030",
    "#4080c0", "#8858a8", "#28a090", "#14100c",
]
cursor = "#18786c"
cursor-text = "#e6dfd0"
selection-background = "#9ec4ba"
selection-foreground = "#14100c"
