[meta]
name = "Aurora Drift"
mode = "dark"

[terminal]
foreground = "#e6f1ff"
background = "#050814"
palette = [
    "#aab7c8", "#ff6b6b", "#5fd9ad", "#ffd166",
    "#6ea8ff", "#c58cff", "#54ddeb", "#e6f1ff",
    "#c0cad6", "#ff8b8b", "#80e5bd", "#ffe28a",
    "#91bdff", "#d9adff", "#7be9f2", "#ffffff",
]
cursor = "#00e5ff"
cursor-text = "#050814"
selection-background = "#263449"
selection-foreground = "#f7fbff"
