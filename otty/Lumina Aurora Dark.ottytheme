[meta]
name = "Lumina Aurora Dark"
mode = "dark"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#d9d5e3"
background = "#120c1c"
palette = [
    "#171022", "#d45f58", "#53e39c", "#fecc74",
    "#b8c5e4", "#eeaae7", "#75d7e2", "#b9b5c3",
    "#8a819b", "#e0847c", "#a2f4c4", "#ffe4b7",
    "#d2dfff", "#ffcbf9", "#8ef2fd", "#d9d5e3",
]
cursor = "#d9d5e3"
cursor-text = "#120c1c"
selection-background = "#263a3a"
selection-foreground = "#d9d5e3"
