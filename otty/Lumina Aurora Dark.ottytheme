[meta]
name = "Lumina Aurora Dark"
mode = "dark"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#d6e3e2"
background = "#041212"
palette = [
    "#061717", "#d86f66", "#6cd79d", "#e9d487",
    "#c5d8ed", "#e7ade1", "#84d2db", "#b6c3c2",
    "#789091", "#e59289", "#a7eac2", "#ffe791",
    "#d7eaff", "#ffc9f9", "#9decf6", "#d6e3e2",
]
cursor = "#d6e3e2"
cursor-text = "#041212"
selection-background = "#1a3e32"
selection-foreground = "#d6e3e2"
