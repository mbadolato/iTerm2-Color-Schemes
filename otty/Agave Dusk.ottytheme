palette = [
    "#d0d8d0", "#ffad91", "#a8dfae", "#f5d578",
    "#afd4f1", "#ecb0d4", "#a6e3dc", "#fff0d8",
    "#dfe5dd", "#ffc0a7", "#bde8c1", "#ffe494",
    "#c7e2f5", "#f3c6df", "#c2eee8", "#fffaf0",
]
cursor = "#f6bd59"
