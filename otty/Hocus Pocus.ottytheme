[meta]
name = "Hocus Pocus"
mode = "dark"

[terminal]
foreground = "#f6edff"
background = "#431455"
palette = [
    "#c2b1ca", "#f18b8c", "#9bd674", "#e9c657",
    "#8fc1e8", "#d187e4", "#7bd3d1", "#f6edff",
    "#c9bad0", "#f3999a", "#a7db85", "#eccd6b",
    "#9cc8eb", "#d795e7", "#8bd8d7", "#f7efff",
]
cursor = "#f3999a"
