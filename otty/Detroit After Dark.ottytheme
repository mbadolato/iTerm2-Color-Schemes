[meta]
name = "Detroit After Dark"
mode = "dark"

[terminal]
foreground = "#f7e6d7"
background = "#24141b"
palette = [
    "#a8b2b8", "#e66e62", "#9dc28e", "#e9bd66",
    "#8cb3d9", "#c89bd4", "#84c9cb", "#f7e6d7",
    "#b9c1c6", "#e97f75", "#a9c99c", "#ecc578",
    "#9abcde", "#cfa7d9", "#93cfd1", "#f9ebdf",
]
cursor = "#ecc578"
cursor-text = "#24141b"
selection-background = "#4c343f"
selection-foreground = "#f7e6d7"
