[meta]
name = "The Fog"
mode = "dark"

[terminal]
foreground = "#eef4f3"
background = "#294552"
palette = [
    "#c0ced2", "#ee9d8b", "#9bc8ad", "#dec978",
    "#93c3d6", "#baadca", "#87ced0", "#eef4f3",
    "#c8d4d7", "#f0a999", "#a7cfb7", "#e2cf88",
    "#a0cadb", "#bfb2ce", "#95d4d6", "#f0f5f4",
]
cursor = "#f0a999"
cursor-text = "#294552"
selection-background = "#c8d4d7"
selection-foreground = "#979c9b"
