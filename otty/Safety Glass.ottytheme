[meta]
name = "Safety Glass"
mode = "light"

[terminal]
foreground = "#142322"
background = "#f2fbfa"
palette = [
    "#293837", "#842424", "#125a37", "#634c00",
    "#17458b", "#5e3186", "#005866", "#394847",
    "#465554", "#902a2a", "#17603d", "#6b5200",
    "#123a78", "#65388e", "#004b57", "#414f4e",
]
cursor = "#176d67"
cursor-text = "#f2fbfa"
selection-background = "#d7ebe8"
selection-foreground = "#142322"
