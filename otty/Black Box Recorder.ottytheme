[meta]
name = "Black Box Recorder"
mode = "dark"

[terminal]
foreground = "#f4f1e8"
background = "#050608"
palette = [
    "#b9b7b0", "#ff806d", "#78d19d", "#f1ca63",
    "#8cb2ed", "#d5a0e6", "#80d3dc", "#f4f1e8",
    "#cbc8c0", "#ff9c8b", "#99deb5", "#f7db86",
    "#aac7f3", "#e4b9ed", "#a1e1e7", "#fffdf7",
]
cursor = "#ffcc33"
cursor-text = "#050608"
selection-background = "#2b2414"
selection-foreground = "#fff8e7"
