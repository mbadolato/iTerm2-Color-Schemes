[meta]
name = "Witching Hour"
mode = "dark"

[terminal]
foreground = "#f5edff"
background = "#261044"
palette = [
    "#b9aec8", "#f18a9d", "#a4d66e", "#e9c86b",
    "#91c4ed", "#c995f0", "#80d4d2", "#f5edff",
    "#cec3dc", "#f5a6b4", "#bae187", "#f1d98a",
    "#add5f3", "#d9b1f5", "#a0e1df", "#fffaff",
]
cursor = "#b56cff"
cursor-text = "#261044"
selection-background = "#45236b"
selection-foreground = "#fff8ff"
