[meta]
name = "Modus Vivendi"
mode = "dark"
author = "Protesilaos Stavrou (https://protesilaos.com/)"

[terminal]
foreground = "#ffffff"
background = "#000000"
palette = [
    "#000000", "#ff5f59", "#44bc44", "#d0bc00",
    "#2fafff", "#feacd0", "#00d3d0", "#a6a6a6",
    "#595959", "#ff7f9f", "#00c06f", "#fec43f",
    "#79a8ff", "#b6a0ff", "#6ae4b9", "#ffffff",
]
cursor = "#ffffff"
cursor-text = "#000000"
selection-background = "#5a5a5a"
selection-foreground = "#ffffff"
