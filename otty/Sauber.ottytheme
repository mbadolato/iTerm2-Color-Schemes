[meta]
name = "Sauber"
mode = "light"

[terminal]
foreground = "#1345f6"
background = "#ecffe5"
palette = [
    "#14191e", "#b43c2a", "#00c200", "#c7c400",
    "#2744c7", "#c040be", "#00c5c7", "#bababa",
    "#686868", "#dd7975", "#3fcd76", "#c6bb00",
    "#a7abf2", "#e17ee1", "#048b8f", "#a4801c",
]
cursor = "#000000"
cursor-text = "#ffffff"
selection-background = "#b3d7ff"
selection-foreground = "#000000"
