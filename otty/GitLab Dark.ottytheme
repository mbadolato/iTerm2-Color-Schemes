[meta]
name = "GitLab Dark"
mode = "dark"

[terminal]
foreground = "#ffffff"
background = "#28262b"
palette = [
    "#000000", "#f57f6c", "#52b87a", "#d99530",
    "#7fb6ed", "#f88aaf", "#32c5d2", "#ffffff",
    "#666666", "#fcb5aa", "#91d4a8", "#e9be74",
    "#498dd1", "#fcacc5", "#5edee3", "#ffffff",
]
cursor = "#ffffff"
cursor-text = "#bfbfbf"
selection-background = "#ad95e9"
selection-foreground = "#28262b"
