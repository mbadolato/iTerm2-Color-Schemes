[meta]
name = "Lumina Harbor Light"
mode = "light"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#1c2d4f"
background = "#fbf5ec"
palette = [
    "#1c2d4f", "#8c1c1d", "#19784d", "#a25f06",
    "#0468a4", "#8b499a", "#046871", "#5b7097",
    "#5d6b7e", "#651f1d", "#00623c", "#874e00",
    "#005486", "#713b7d", "#00535a", "#7a8fb8",
]
cursor = "#1c2d4f"
cursor-text = "#fbf5ec"
selection-background = "#e3bcce"
selection-foreground = "#1c2d4f"
