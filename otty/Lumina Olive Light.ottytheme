[meta]
name = "Lumina Olive Light"
mode = "light"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#302e16"
background = "#f7f6e5"
palette = [
    "#302e16", "#8a1f1f", "#30624e", "#a16010",
    "#3264a3", "#8e4c89", "#006f83", "#727056",
    "#6a6b54", "#64201e", "#005139", "#874e00",
    "#1e508c", "#763a72", "#00596a", "#918f74",
]
cursor = "#302e16"
cursor-text = "#f7f6e5"
selection-background = "#c6cda8"
selection-foreground = "#302e16"
