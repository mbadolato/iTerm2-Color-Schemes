[meta]
name = "SeedFlip Coral"
mode = "light"

[terminal]
foreground = "#1d1d1d"
background = "#ffffff"
palette = [
    "#d9d9d9", "#bd0f0f", "#0fbd49", "#bda00f",
    "#0f58bd", "#bd0fbd", "#0fbdbd", "#101010",
    "#b3b3b3", "#ee2b2b", "#12d452", "#e1c01e",
    "#2b7cee", "#ee2bee", "#12d4d4", "#1d1d1d",
]
cursor = "#f24e1e"
cursor-text = "#1d1d1d"
selection-background = "#f5f5f5"
selection-foreground = "#1d1d1d"
