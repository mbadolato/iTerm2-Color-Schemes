[meta]
name = "CGA"
mode = "dark"

[terminal]
foreground = "#aaaaaa"
background = "#000000"
palette = [
    "#000000", "#aa0000", "#00aa00", "#aa5500",
    "#0d0db7", "#aa00aa", "#00aaaa", "#aaaaaa",
    "#555555", "#ff5555", "#55ff55", "#ffff55",
    "#5555ff", "#ff55ff", "#55ffff", "#ffffff",
]
cursor = "#b8b8b8"
cursor-text = "#ffffff"
selection-background = "#c1deff"
selection-foreground = "#000000"
