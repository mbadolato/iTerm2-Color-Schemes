[meta]
name = "Gruvbox Dark"
mode = "dark"

[terminal]
foreground = "#ebdbb2"
background = "#282828"
palette = [
    "#282828", "#cc241d", "#98971a", "#d79921",
    "#458588", "#b16286", "#689d6a", "#a89984",
    "#928374", "#fb4934", "#b8bb26", "#fabd2f",
    "#83a598", "#d3869b", "#8ec07c", "#ebdbb2",
]
cursor = "#ebdbb2"
cursor-text = "#282828"
selection-background = "#665c54"
selection-foreground = "#ebdbb2"
