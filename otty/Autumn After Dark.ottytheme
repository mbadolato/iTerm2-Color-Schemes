[meta]
name = "Autumn After Dark"
mode = "dark"

[terminal]
foreground = "#f8e9cf"
background = "#57210d"
palette = [
    "#c8b6a6", "#f18f67", "#9ac47c", "#e9bf55",
    "#83b8d0", "#c794af", "#78c4b8", "#f8e9cf",
    "#cfbfb1", "#f39c79", "#a6cb8c", "#ecc769",
    "#92c1d6", "#cea1b9", "#88cbc1", "#f9ecd5",
]
cursor = "#f39c79"
