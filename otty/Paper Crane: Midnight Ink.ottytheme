[meta]
name = "Paper Crane: Midnight Ink"
mode = "dark"

[terminal]
foreground = "#e6e2d6"
background = "#20272a"
palette = [
    "#303a3c", "#b9685c", "#7d9e85", "#c1a06b",
    "#819cbd", "#aa88a7", "#79a9a5", "#d4d3c9",
    "#607073", "#dc8977", "#a2c2a4", "#dfc08b",
    "#a5bbdb", "#c7a9c4", "#a1d0c8", "#fff8e8",
]
cursor = "#d9826b"
cursor-text = "#20272a"
selection-background = "#3c4b49"
selection-foreground = "#6c7376"
