[meta]
name = "datum (dark)"
mode = "dark"

[terminal]
foreground = "#dbe0e8"
background = "#0f1318"
palette = [
    "#2b2f35", "#fe9864", "#54dcaa", "#e8df69",
    "#69b9f7", "#fa94cd", "#6ae5ec", "#dbe0e8",
    "#8f98a3", "#f8bd5f", "#54dcaa", "#fcdcad",
    "#b2dafb", "#f5b9d9", "#a5f5f9", "#eef2f7",
]
cursor = "#fa94cd"
cursor-text = "#0f1318"
selection-background = "#2b2f35"
selection-foreground = "#dbe0e8"
