[meta]
name = "Japanesque"
mode = "dark"

[terminal]
foreground = "#f7f6ec"
background = "#1e1e1e"
palette = [
    "#343935", "#cf3f61", "#7bb75b", "#e9b32a",
    "#4c9ad4", "#a57fc4", "#389aad", "#fafaf6",
    "#595b59", "#d18fa6", "#767f2c", "#78592f",
    "#135979", "#604291", "#76bbca", "#b2b5ae",
]
cursor = "#edcf4f"
cursor-text = "#343935"
selection-background = "#175877"
selection-foreground = "#f7f6ec"
