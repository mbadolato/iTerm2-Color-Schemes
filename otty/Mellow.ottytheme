[meta]
name = "Mellow"
mode = "dark"

[terminal]
foreground = "#c9c7cd"
background = "#161617"
palette = [
    "#27272a", "#f5a191", "#90b99f", "#e6b99d",
    "#aca1cf", "#e29eca", "#ea83a5", "#c1c0d4",
    "#424246", "#ffae9f", "#9dc6ac", "#f0c5a9",
    "#b9aeda", "#ecaad6", "#f591b2", "#cac9dd",
]
cursor = "#cac9dd"
cursor-text = "#161617"
selection-background = "#2a2a2d"
selection-foreground = "#c1c0d4"
