[meta]
name = "Chalk"
mode = "dark"

[terminal]
foreground = "#d2d8d9"
background = "#2b2d2e"
palette = [
    "#7d8b8f", "#b23a52", "#789b6a", "#b9ac4a",
    "#2a7fac", "#bd4f5a", "#44a799", "#d2d8d9",
    "#888888", "#f24840", "#80c470", "#ffeb62",
    "#4196ff", "#fc5275", "#53cdbd", "#d2d8d9",
]
cursor = "#708284"
cursor-text = "#002831"
selection-background = "#e4e8ed"
selection-foreground = "#3f4041"
