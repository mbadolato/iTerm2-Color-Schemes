[meta]
name = "Sunset Strip"
mode = "dark"

[terminal]
foreground = "#fce9dd"
background = "#1c1832"
palette = [
    "#a8b2b8", "#f07880", "#8ec9a0", "#f5c46c",
    "#83b7e7", "#e58ecb", "#7bd2d7", "#fce9dd",
    "#b9c1c6", "#f2888f", "#9ccfab", "#f6cb7e",
    "#92c0ea", "#e89cd1", "#8bd7dc", "#fdede4",
]
cursor = "#f6cb7e"
cursor-text = "#1c1832"
selection-background = "#47374f"
selection-foreground = "#fce9dd"
