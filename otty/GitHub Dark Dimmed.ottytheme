[meta]
name = "GitHub Dark Dimmed"
mode = "dark"

[terminal]
foreground = "#adbac7"
background = "#22272e"
palette = [
    "#545d68", "#f47067", "#57ab5a", "#c69026",
    "#539bf5", "#b083f0", "#39c5cf", "#909dab",
    "#636e7b", "#ff938a", "#6bc46d", "#daaa3f",
    "#6cb6ff", "#dcbdfb", "#56d4dd", "#cdd9e5",
]
cursor = "#539bf5"
cursor-text = "#93dbff"
selection-background = "#adbac7"
selection-foreground = "#22272e"
