[meta]
name = "Miasma"
mode = "dark"

[terminal]
foreground = "#c2c2b0"
background = "#222222"
palette = [
    "#000000", "#685742", "#5f875f", "#b36d43",
    "#78824b", "#bb7744", "#c9a554", "#d7c483",
    "#666666", "#685742", "#5f875f", "#b36d43",
    "#78824b", "#bb7744", "#c9a554", "#d7c483",
]
cursor = "#c7c7c7"
cursor-text = "#959595"
selection-background = "#e5c47b"
selection-foreground = "#000000"
