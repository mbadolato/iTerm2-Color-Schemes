[meta]
name = "Crystal Ball"
mode = "dark"

[terminal]
foreground = "#f2edff"
background = "#2b1050"
palette = [
    "#b7acc9", "#ef8ca4", "#9ed08c", "#dfc86b",
    "#82c8ef", "#c18df0", "#77d7de", "#f2edff",
    "#c0b6cf", "#f19aaf", "#aad69a", "#e3cf7d",
    "#91cff1", "#c89bf2", "#87dce2", "#f4efff",
]
cursor = "#f19aaf"
cursor-text = "#2b1050"
selection-background = "#c0b6cf"
selection-foreground = "#fffcff"
