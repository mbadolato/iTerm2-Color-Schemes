[meta]
name = "Highway"
mode = "dark"

[terminal]
foreground = "#ededed"
background = "#222225"
palette = [
    "#000000", "#d00e18", "#138034", "#ffcb3e",
    "#006bb3", "#783482", "#455271", "#ededed",
    "#5d504a", "#f07e18", "#b1d130", "#fff120",
    "#4fc2fd", "#de0071", "#5d504a", "#ffffff",
]
cursor = "#e0d9b9"
cursor-text = "#1f192a"
selection-background = "#384564"
selection-foreground = "#ededed"
