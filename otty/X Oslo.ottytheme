[meta]
name = "X Oslo"
mode = "dark"

[terminal]
foreground = "#abb2bf"
background = "#3f4451"
palette = [
    "#3f4451", "#e05561", "#8cc265", "#d18f52",
    "#4aa5f0", "#c162de", "#42b3c2", "#e6e6e6",
    "#687080", "#ff616e", "#a5e075", "#f0a45d",
    "#4dc4ff", "#de73ff", "#4cd1e0", "#ffffff",
]
cursor = "#abb2bf"
cursor-text = "#3f4451"
selection-background = "#abb2bf"
selection-foreground = "#3f4451"
