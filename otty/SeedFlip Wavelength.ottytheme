[meta]
name = "SeedFlip Wavelength"
mode = "dark"

[terminal]
foreground = "#e6edf3"
background = "#0d1117"
palette = [
    "#090c10", "#d55d5d", "#5dd585", "#d5c15d",
    "#5d8fd5", "#d55dd5", "#5dd5d5", "#f7f9fb",
    "#364255", "#e59a9a", "#9ae5b3", "#e5d89a",
    "#9ab9e5", "#e59ae5", "#9ae5e5", "#ffffff",
]
cursor = "#238636"
cursor-text = "#0d1117"
selection-background = "#161b22"
selection-foreground = "#e6edf3"
