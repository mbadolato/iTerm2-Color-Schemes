[meta]
name = "Sequoia Retro Dark"
mode = "dark"
author = "Michael Andreuzza (https://github.com/michael-andreuzza/Sequoia-Theme)"

[terminal]
foreground = "#868690"
background = "#0f1014"
palette = [
    "#131317", "#829fa7", "#648f68", "#da674b",
    "#5c87a4", "#e8b246", "#a27e57", "#868690",
    "#575861", "#e8b246", "#648f68", "#da674b",
    "#5c87a4", "#829fa7", "#a27e57", "#868690",
]
cursor = "#43444d"
cursor-text = "#868690"
selection-background = "#817c9c"
selection-foreground = "#acacb6"
