[meta]
name = "Wombat"
mode = "dark"

[terminal]
foreground = "#dedacf"
background = "#171717"
palette = [
    "#000000", "#ff615a", "#b1e969", "#ebd99c",
    "#5da9f6", "#e86aff", "#82fff7", "#dedacf",
    "#4a4a4a", "#f58c80", "#ddf88f", "#eee5b2",
    "#a5c7ff", "#ddaaff", "#b7fff9", "#ffffff",
]
cursor = "#bbbbbb"
cursor-text = "#ffffff"
selection-background = "#453b39"
selection-foreground = "#b6bbc0"
