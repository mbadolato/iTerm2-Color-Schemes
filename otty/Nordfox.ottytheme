[meta]
name = "Nordfox"
mode = "dark"

[terminal]
foreground = "#cdcecf"
background = "#2e3440"
palette = [
    "#3b4252", "#bf616a", "#a3be8c", "#ebcb8b",
    "#81a1c1", "#b48ead", "#88c0d0", "#e5e9f0",
    "#53648d", "#d06f79", "#b1d196", "#f0d399",
    "#8cafd2", "#c895bf", "#93ccdc", "#e7ecf4",
]
cursor = "#cdcecf"
cursor-text = "#2e3440"
selection-background = "#3e4a5b"
selection-foreground = "#cdcecf"
