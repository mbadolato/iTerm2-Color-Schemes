[meta]
name = "Pandora"
mode = "dark"

[terminal]
foreground = "#e1e1e1"
background = "#141e43"
palette = [
    "#000000", "#ff4242", "#74af68", "#ffad29",
    "#338f86", "#9414e6", "#23d7d7", "#e2e2e2",
    "#3f5648", "#ff3242", "#74cd68", "#ffb929",
    "#23d7d7", "#ff37ff", "#00ede1", "#ffffff",
]
cursor = "#43d58e"
cursor-text = "#ffffff"
selection-background = "#2d37ff"
selection-foreground = "#82e0ff"
