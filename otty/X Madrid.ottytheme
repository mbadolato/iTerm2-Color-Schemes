[meta]
name = "X Madrid"
mode = "light"

[terminal]
foreground = "#1a1a1a"
background = "#fafafa"
palette = [
    "#fafafa", "#990026", "#007a28", "#8a6408",
    "#007a9e", "#4d2699", "#007a9e", "#1a1a1a",
    "#4d4d4d", "#990026", "#007a28", "#8a6408",
    "#007a9e", "#4d2699", "#007a9e", "#1a1a1a",
]
cursor = "#1a1a1a"
cursor-text = "#fafafa"
selection-background = "#1a1a1a"
selection-foreground = "#fafafa"
