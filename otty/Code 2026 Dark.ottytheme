[meta]
name = "Code 2026 Dark"
mode = "dark"

[terminal]
foreground = "#bbbebf"
background = "#121314"
palette = [
    "#202122", "#ff7b72", "#7ee787", "#cd9731",
    "#79c0ff", "#d2a8ff", "#4ec9b0", "#bbbebf",
    "#555555", "#ffa198", "#91eb99", "#ffa657",
    "#a5d6ff", "#b267e6", "#71d4c0", "#ffffff",
]
cursor = "#bbbebf"
cursor-text = "#121314"
selection-background = "#276782"
selection-foreground = "#ffffff"
