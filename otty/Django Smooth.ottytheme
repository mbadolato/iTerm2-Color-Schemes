[meta]
name = "Django Smooth"
mode = "dark"

[terminal]
foreground = "#f8f8f8"
background = "#245032"
palette = [
    "#000000", "#fd6209", "#41a83e", "#ffe862",
    "#989898", "#f8f8f8", "#9df39f", "#e8e8e7",
    "#727272", "#ff943b", "#73da70", "#ffff94",
    "#cacaca", "#ffffff", "#cfffd1", "#ffffff",
]
cursor = "#4c7e5c"
cursor-text = "#f8f8f8"
selection-background = "#336442"
selection-foreground = "#f8f8f8"
