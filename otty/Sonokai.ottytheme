[meta]
name = "Sonokai"
mode = "dark"

[terminal]
foreground = "#e2e2e3"
background = "#2c2e34"
palette = [
    "#181819", "#fc5d7c", "#9ed072", "#e7c664",
    "#76cce0", "#b39df3", "#f39660", "#e2e2e3",
    "#7f8490", "#fc5d7c", "#9ed072", "#e7c664",
    "#76cce0", "#b39df3", "#f39660", "#e2e2e3",
]
cursor = "#e2e2e3"
cursor-text = "#2c2e34"
selection-background = "#414550"
selection-foreground = "#e2e2e3"
