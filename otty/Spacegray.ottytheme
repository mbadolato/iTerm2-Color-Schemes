[meta]
name = "Spacegray"
mode = "dark"

[terminal]
foreground = "#b3b8c3"
background = "#20242d"
palette = [
    "#000000", "#b04b57", "#87b379", "#e5c179",
    "#7d8fa4", "#a47996", "#85a7a5", "#b3b8c3",
    "#4c4c4c", "#b04b57", "#87b379", "#e5c179",
    "#7d8fa4", "#a47996", "#85a7a5", "#ffffff",
]
cursor = "#b3b8c3"
cursor-text = "#1d1f21"
selection-background = "#16181e"
selection-foreground = "#b3b8c3"
