[meta]
name = "Citrus Ink"
mode = "dark"

[terminal]
foreground = "#eaf0e2"
background = "#0b1413"
palette = [
    "#14201e", "#ff6b5b", "#5fd3a0", "#e6c84a",
    "#c2ef45", "#f2b441", "#cfe89a", "#eaf0e2",
    "#4f6b5e", "#ff8174", "#72d8ab", "#f2a23e",
    "#b8e62e", "#b8e62e", "#d5eba6", "#ffffff",
]
cursor = "#b8e62e"
cursor-text = "#0b1413"
selection-background = "#1f302d"
selection-foreground = "#4b5453"
