[meta]
name = "Lumina Quartz Light Contrast"
mode = "light"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#0e0f13"
background = "#fdfdfe"
palette = [
    "#0e0f13", "#660005", "#00581f", "#7e4800",
    "#004b7a", "#72246e", "#005463", "#727479",
    "#595f64", "#470103", "#004215", "#643800",
    "#00385d", "#5b0f58", "#00404b", "#929399",
]
cursor = "#0e0f13"
cursor-text = "#fdfdfe"
selection-background = "#b7d0d5"
selection-foreground = "#0e0f13"
