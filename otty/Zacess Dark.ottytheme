[meta]
name = "Zacess Dark"
mode = "dark"

[terminal]
foreground = "#f5f5f5"
background = "#121212"
palette = [
    "#a3a3a3", "#ffa79b", "#1bdb41", "#f0b40b",
    "#90c1ff", "#f7a0f1", "#37d2cf", "#e6e6e6",
    "#c8c8c8", "#ffd5ce", "#34ff57", "#ffda8a",
    "#c9e0ff", "#ffd0fa", "#23f6f8", "#ffffff",
]
cursor = "#ffd400"
cursor-text = "#121212"
selection-background = "#4fbdff"
selection-foreground = "#121212"
