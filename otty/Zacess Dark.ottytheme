[meta]
name = "Zacess Dark"
mode = "dark"

[terminal]
foreground = "#f5f5f5"
background = "#121212"
palette = [
    "#2b2b2b", "#ffa79b", "#8dcd8e", "#deb967",
    "#90c1ff", "#eba8e4", "#52d0cf", "#e6e6e6",
    "#aeaeae", "#ffd5ce", "#aceead", "#ffda8a",
    "#c9e0ff", "#ffd0fa", "#76f1f0", "#ffffff",
]
cursor = "#ffd400"
cursor-text = "#121212"
selection-background = "#1a2436"
selection-foreground = "#f5f5f5"
