palette = [
    "#a8b2b8", "#ef767d", "#87c79c", "#ebc86b",
    "#84b5ed", "#d69edc", "#79d2d2", "#edf0f4",
    "#b9c1c6", "#f1868d", "#95cea8", "#edcf7d",
    "#93beef", "#dbaae0", "#89d7d7", "#f1f3f6",
]
cursor = "#edcf7d"
