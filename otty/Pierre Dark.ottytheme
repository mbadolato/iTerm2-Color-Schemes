[meta]
name = "Pierre Dark"
mode = "dark"
author = "Pierre (https://diffs.com/theme)"

[terminal]
foreground = "#fbfbfb"
background = "#070707"
palette = [
    "#141415", "#ff2e3f", "#0dbe4e", "#ffca00",
    "#009fff", "#c635e4", "#08c0ef", "#c6c6c8",
    "#6c6c71", "#ff6762", "#5ecc71", "#ffd452",
    "#69b1ff", "#d568ea", "#68cdf2", "#fbfbfb",
]
cursor = "#009fff"
cursor-text = "#070707"
selection-background = "#19283c"
selection-foreground = "#fbfbfb"
