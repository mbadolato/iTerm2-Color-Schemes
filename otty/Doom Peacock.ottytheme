[meta]
name = "Doom Peacock"
mode = "dark"

[terminal]
foreground = "#ede0ce"
background = "#2b2a27"
palette = [
    "#1c1f24", "#cb4b16", "#26a6a6", "#bcd42a",
    "#2a6cc6", "#a9a1e1", "#5699af", "#ede0ce",
    "#51504d", "#ff5d38", "#98be65", "#e6f972",
    "#51afef", "#c678dd", "#46d9ff", "#dfdfdf",
]
cursor = "#9c9c9d"
cursor-text = "#36312b"
selection-background = "#a60033"
selection-foreground = "#ffffff"
