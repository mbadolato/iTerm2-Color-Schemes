[meta]
name = "Wilmersdorf"
mode = "dark"

[terminal]
foreground = "#c6c6c6"
background = "#282b33"
palette = [
    "#34373e", "#e06383", "#7ebebd", "#cccccc",
    "#a6c1e0", "#e1c1ee", "#5b94ab", "#ababab",
    "#50545d", "#fa7193", "#8fd7d6", "#d1dfff",
    "#b2cff0", "#efccfd", "#69abc5", "#d3d3d3",
]
cursor = "#7ebebd"
cursor-text = "#1f2024"
selection-background = "#1f2024"
selection-foreground = "#c6c6c6"
