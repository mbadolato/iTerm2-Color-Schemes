[meta]
name = "Trapped in Amber"
mode = "dark"

[terminal]
foreground = "#f0a020"
background = "#0a1017"
palette = [
    "#4a3220", "#e05c1c", "#7a9c4a", "#f0a020",
    "#4a7ec9", "#c95a8c", "#7a9ea8", "#ffd9a0",
    "#5a4a3a", "#ff7832", "#a8c46b", "#ffd700",
    "#6b9fff", "#ff7fa8", "#a5c2cc", "#fff5e0",
]
cursor = "#ffc940"
cursor-text = "#0a1017"
selection-background = "#4a3416"
selection-foreground = "#ffd9a0"
