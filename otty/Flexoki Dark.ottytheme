[meta]
name = "Flexoki Dark"
mode = "dark"

[terminal]
foreground = "#cecdc3"
background = "#100f0f"
palette = [
    "#100f0f", "#d14d41", "#879a39", "#d0a215",
    "#4385be", "#ce5d97", "#3aa99f", "#878580",
    "#575653", "#af3029", "#66800b", "#ad8301",
    "#205ea6", "#a02f6f", "#24837b", "#cecdc3",
]
cursor = "#cecdc3"
cursor-text = "#100f0f"
selection-background = "#403e3c"
selection-foreground = "#cecdc3"
