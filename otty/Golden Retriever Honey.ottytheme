[meta]
name = "Golden Retriever Honey"
mode = "light"

[terminal]
foreground = "#5b4630"
background = "#fdf6e7"
palette = [
    "#6b4a2f", "#d35400", "#8ba83e", "#d4b24c",
    "#4a8fbd", "#a86bd8", "#5fb7a7", "#c2baac",
    "#805e3b", "#f1734f", "#9abc5d", "#d9ba4f",
    "#6eb9f5", "#c28ae6", "#56c9b5", "#f4e4c9",
]
cursor = "#d4a24c"
cursor-text = "#5b4630"
selection-background = "#c6a477"
selection-foreground = "#4b3826"
