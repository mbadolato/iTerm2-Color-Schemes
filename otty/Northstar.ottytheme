[meta]
name = "Northstar"
mode = "dark"

[terminal]
foreground = "#f5f7fb"
background = "#0b0f1a"
palette = [
    "#aeb6c2", "#ff6f73", "#6ed99a", "#f7d66d",
    "#7ea8ff", "#d79af4", "#70dce8", "#eef2f7",
    "#c1c7d0", "#ff8b8e", "#8ae3ad", "#ffe38b",
    "#9bbcff", "#e5b0f8", "#91e7ef", "#ffffff",
]
cursor = "#fcd34d"
cursor-text = "#0b0f1a"
selection-background = "#1f2937"
selection-foreground = "#ffffff"
