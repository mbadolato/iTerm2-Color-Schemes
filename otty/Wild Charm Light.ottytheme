[meta]
name = "Wild Charm Light"
mode = "light"

[terminal]
foreground = "#000000"
background = "#ffffff"
palette = [
    "#000000", "#af0000", "#008700", "#af5f00",
    "#005faf", "#870087", "#008f9f", "#8a8a8a",
    "#808080", "#d70000", "#5faf5f", "#d78700",
    "#0087d7", "#af00af", "#00afaf", "#ffffff",
]
cursor = "#767676"
cursor-text = "#ffffff"
selection-background = "#00afff"
selection-foreground = "#ffffff"
