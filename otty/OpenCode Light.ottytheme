[meta]
name = "OpenCode Light"
mode = "light"

[terminal]
foreground = "#1a1a1a"
background = "#ffffff"
palette = [
    "#1a1a1a", "#c20f26", "#1f8c44", "#c7811e",
    "#226bcc", "#6b47a7", "#077786", "#bebebe",
    "#8a8a8a", "#d1383d", "#3d9a57", "#d68c27",
    "#3b7dd8", "#7b5bb6", "#318795", "#ffffff",
]
cursor = "#d68c27"
cursor-text = "#ffffff"
selection-background = "#d4e5fd"
selection-foreground = "#1a1a1a"
