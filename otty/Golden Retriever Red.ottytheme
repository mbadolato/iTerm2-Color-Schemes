[meta]
name = "Golden Retriever Red"
mode = "light"

[terminal]
foreground = "#6b3d2a"
background = "#fff0e3"
palette = [
    "#8b3a1b", "#d3542c", "#7a9b45", "#d9a441",
    "#468bd6", "#b05cc7", "#4db7a0", "#e06b8f",
    "#8c5a3c", "#e67356", "#9bba5d", "#d6ad45",
    "#65b8e8", "#c889e0", "#57c8b4", "#f4a7c3",
]
cursor = "#c97b2e"
cursor-text = "#6b3d2a"
selection-background = "#d28b6c"
selection-foreground = "#7d4c38"
