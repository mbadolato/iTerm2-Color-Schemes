[meta]
name = "Rainbows and Unicorns EGA 85"
mode = "dark"

[terminal]
foreground = "#aaaaaa"
background = "#050507"
palette = [
    "#1a1a1f", "#cc3b3b", "#2fb84a", "#c2782e",
    "#4a6cf0", "#c24bc2", "#2bb8b8", "#aaaaaa",
    "#6a6a72", "#ff5555", "#55ff55", "#ffff55",
    "#7b7bff", "#ff55ff", "#55ffff", "#ffffff",
]
cursor = "#aaaaaa"
cursor-text = "#050507"
selection-background = "#aaaaaa"
selection-foreground = "#050507"
