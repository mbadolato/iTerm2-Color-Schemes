[meta]
name = "Shades Of Purple"
mode = "dark"

[terminal]
foreground = "#ffffff"
background = "#1e1d40"
palette = [
    "#000000", "#d90429", "#3ad900", "#ffe700",
    "#6943ff", "#ff2c70", "#00c5c7", "#c7c7c7",
    "#686868", "#f92a1c", "#43d426", "#f1d000",
    "#6871ff", "#ff77ff", "#79e8fb", "#ffffff",
]
cursor = "#fad000"
cursor-text = "#98998e"
selection-background = "#b362ff"
selection-foreground = "#c2c2c2"
