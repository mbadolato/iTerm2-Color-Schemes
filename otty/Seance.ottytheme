[meta]
name = "Seance"
mode = "dark"

[terminal]
foreground = "#f9eddf"
background = "#3b2035"
palette = [
    "#bdb1b8", "#e99b8e", "#a8cf8f", "#e5c779",
    "#9fc2dc", "#d5a6c8", "#8fcfc8", "#f9eddf",
    "#d0c5ca", "#efb0a5", "#bbdba5", "#edd796",
    "#b8d1e5", "#e0bfd5", "#addbd5", "#fffaf2",
]
cursor = "#f1c76d"
cursor-text = "#3b2035"
selection-background = "#5b3b52"
selection-foreground = "#fff8ed"
