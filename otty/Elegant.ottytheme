[meta]
name = "Elegant"
mode = "dark"

[terminal]
foreground = "#ced2d6"
background = "#292b31"
palette = [
    "#0a1222", "#ff0257", "#85cc95", "#ffcb8b",
    "#8dabe1", "#c792eb", "#78ccf0", "#ffffff",
    "#575656", "#ff0057", "#85cc95", "#ffcb8b",
    "#8dabe1", "#c792eb", "#3facef", "#ffffff",
]
cursor = "#00beff"
cursor-text = "#ffffff"
selection-background = "#d5d5d5"
selection-foreground = "#144385"
