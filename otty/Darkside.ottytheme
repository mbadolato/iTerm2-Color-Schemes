[meta]
name = "Darkside"
mode = "dark"

[terminal]
foreground = "#bababa"
background = "#222324"
palette = [
    "#000000", "#e8341c", "#68c256", "#f2d42c",
    "#1c98e8", "#8e69c9", "#1c98e8", "#bababa",
    "#4c4c4c", "#e05a4f", "#77b869", "#efd64b",
    "#387cd3", "#957bbe", "#3d97e2", "#bababa",
]
cursor = "#bbbbbb"
cursor-text = "#ffffff"
selection-background = "#303333"
selection-foreground = "#bababa"
