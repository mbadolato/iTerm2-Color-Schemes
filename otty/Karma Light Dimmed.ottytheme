[meta]
name = "Karma Light Dimmed"
mode = "light"

[terminal]
foreground = "#1c1f24"
background = "#f5f3f7"
palette = [
    "#1c1f24", "#e07a90", "#4a9a4c", "#d49a26",
    "#6688b8", "#7c5ab0", "#6688b8", "#5a5860",
    "#999999", "#e07a90", "#4a9a4c", "#e0a040",
    "#6688b8", "#9676d0", "#6688b8", "#1c1f24",
]
cursor = "#9676d0"
cursor-text = "#f5f3f7"
selection-background = "#ddd8e2"
selection-foreground = "#1c1f24"
