[meta]
name = "Afterimage"
mode = "light"

[terminal]
foreground = "#211522"
background = "#fff7fb"
palette = [
    "#332a33", "#881f3b", "#175b36", "#695000",
    "#1a478e", "#623080", "#005765", "#403640",
    "#504650", "#932746", "#155735", "#624900",
    "#143b77", "#693889", "#004956", "#4a404a",
]
cursor = "#6f356e"
