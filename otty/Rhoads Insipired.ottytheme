[meta]
name = "Rhoads Insipired"
mode = "dark"

[terminal]
foreground = "#f5f5f0"
background = "#0a0a0a"
palette = [
    "#161616", "#e85d5d", "#b7d96c", "#f5a623",
    "#5aa9e6", "#b66de8", "#50c8c6", "#e8e8e3",
    "#555555", "#ff7474", "#d4ef91", "#ffd166",
    "#85c7f2", "#d69bf4", "#7be0dc", "#ffffff",
]
cursor = "#a855f7"
cursor-text = "#f5f5f0"
selection-background = "#f4b942"
selection-foreground = "#111111"
