[meta]
name = "Rouge 2"
mode = "dark"

[terminal]
foreground = "#a2a3aa"
background = "#17182b"
palette = [
    "#5d5d6b", "#c6797e", "#969e92", "#dbcdab",
    "#6e94b9", "#4c4e78", "#8ab6c1", "#e8e8ea",
    "#616274", "#c6797e", "#e6dcc4", "#e6dcc4",
    "#98b3cd", "#8283a1", "#abcbd3", "#e8e8ea",
]
cursor = "#969e92"
cursor-text = "#ffffff"
selection-background = "#5d5d6b"
selection-foreground = "#dfe5ee"
