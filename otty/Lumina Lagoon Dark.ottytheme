[meta]
name = "Lumina Lagoon Dark"
mode = "dark"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#d7e6e7"
background = "#042930"
palette = [
    "#042e36", "#d3726a", "#9fd4a9", "#e7cf94",
    "#8ec3f9", "#e5b0df", "#5ad3d6", "#b7c5c6",
    "#7d9ba2", "#e0938c", "#b8efc2", "#ffe6a7",
    "#badcff", "#ffcaf9", "#9fe6e8", "#d7e6e7",
]
cursor = "#d7e6e7"
cursor-text = "#042930"
selection-background = "#0e535a"
selection-foreground = "#d7e6e7"
