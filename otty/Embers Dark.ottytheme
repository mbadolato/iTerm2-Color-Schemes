[meta]
name = "Embers Dark"
mode = "dark"

[terminal]
foreground = "#a39a90"
background = "#16130f"
palette = [
    "#16130f", "#826d57", "#57826d", "#6d8257",
    "#6d5782", "#82576d", "#576d82", "#a39a90",
    "#5a5047", "#828257", "#464039", "#50483f",
    "#8a8075", "#beb6ae", "#825757", "#dbd6d1",
]
cursor = "#a39a90"
cursor-text = "#16130f"
selection-background = "#433b32"
selection-foreground = "#a39a90"
