[meta]
name = "Zacess Yellow on Black"
mode = "dark"

[terminal]
foreground = "#ffeb3b"
background = "#000000"
palette = [
    "#a3a3a3", "#ffa79b", "#01dc3f", "#edb618",
    "#90c1ff", "#fd9cf8", "#1fd3d3", "#d9d9d9",
    "#c8c8c8", "#ffd5ce", "#3cff5d", "#ffda8a",
    "#c9e0ff", "#ffd0fa", "#00f7f5", "#ffffff",
]
cursor = "#ffeb3b"
cursor-text = "#000000"
selection-background = "#09bcc4"
selection-foreground = "#000000"
