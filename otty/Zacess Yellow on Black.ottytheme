[meta]
name = "Zacess Yellow on Black"
mode = "dark"

[terminal]
foreground = "#ffffff"
background = "#000000"
palette = [
    "#262626", "#ffa79b", "#82d085", "#e5b851",
    "#90c1ff", "#f2a4eb", "#1fd3d3", "#d9d9d9",
    "#aeaeae", "#ffd5ce", "#a2f1a4", "#ffda8a",
    "#c9e0ff", "#ffd0fa", "#55f4f3", "#ffffff",
]
cursor = "#ffeb3b"
cursor-text = "#000000"
selection-background = "#0a2257"
selection-foreground = "#ffeb3b"
