[meta]
name = "Karasu Snow"
mode = "light"

[terminal]
foreground = "#292524"
background = "#fafafa"
palette = [
    "#0a0a0a", "#b84755", "#3f7e4a", "#8a6a1f",
    "#2e5e9b", "#6c4bb8", "#2d7e7a", "#b5b5b5",
    "#404040", "#d93c3c", "#2f9150", "#9a7a1d",
    "#2b72c7", "#7b59d6", "#1f968f", "#ffffff",
]
cursor = "#0a0a0a"
cursor-text = "#fafafa"
selection-background = "#e5e5e5"
selection-foreground = "#292524"
