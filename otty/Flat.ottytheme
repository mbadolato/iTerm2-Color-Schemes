[meta]
name = "Flat"
mode = "dark"

[terminal]
foreground = "#2cc55d"
background = "#002240"
palette = [
    "#222d3f", "#a82320", "#32a548", "#e58d11",
    "#3167ac", "#781aa0", "#2c9370", "#b0b6ba",
    "#475262", "#d4312e", "#2d9440", "#e5be0c",
    "#3c7dd2", "#8230a7", "#35b387", "#e7eced",
]
cursor = "#e5be0c"
cursor-text = "#ffffff"
selection-background = "#792b9c"
selection-foreground = "#ffffff"
