[meta]
name = "Poimandres Storm"
mode = "dark"

[terminal]
foreground = "#a6accd"
background = "#252b37"
palette = [
    "#252b37", "#d0679d", "#5de4c7", "#fffac2",
    "#89ddff", "#f087bd", "#89ddff", "#ffffff",
    "#a6accd", "#d0679d", "#5de4c7", "#fffac2",
    "#add7ff", "#f087bd", "#add7ff", "#ffffff",
]
cursor = "#ffffff"
cursor-text = "#252b37"
selection-background = "#a6accd"
selection-foreground = "#ffffff"
