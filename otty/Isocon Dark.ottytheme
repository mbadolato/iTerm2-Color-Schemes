[meta]
name = "Isocon Dark"
mode = "dark"

[terminal]
foreground = "#868686"
background = "#062329"
palette = [
    "#062329", "#e34b87", "#419658", "#ba783e",
    "#408cbd", "#976fe3", "#3e8c7e", "#868686",
    "#565656", "#f81486", "#109b48", "#c7700e",
    "#0f8dcd", "#9c61fc", "#0f907f", "#868686",
]
cursor = "#868686"
cursor-text = "#062329"
selection-background = "#868686"
selection-foreground = "#062329"
