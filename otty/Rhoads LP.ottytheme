[meta]
name = "Rhoads LP"
mode = "light"

[terminal]
foreground = "#2b2618"
background = "#fdf7e8"
palette = [
    "#3b3525", "#c5423a", "#5f8f4f", "#d6b852",
    "#5b7fd6", "#a678d6", "#46c5c3", "#c2bcb0",
    "#8a8474", "#e66f67", "#91bd79", "#ceb352",
    "#86a5e8", "#c39be8", "#68bfbb", "#fffef9",
]
cursor = "#d4b34f"
cursor-text = "#fffaf0"
selection-background = "#e0c878"
selection-foreground = "#80651f"
