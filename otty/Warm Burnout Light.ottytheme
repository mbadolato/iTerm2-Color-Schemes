[meta]
name = "Warm Burnout Light"
mode = "light"

[terminal]
foreground = "#3a3630"
background = "#f5ede0"
palette = [
    "#3a3630", "#b82820", "#2d6a14", "#8a6000",
    "#2060a0", "#8a3090", "#146858", "#b3ab9d",
    "#686868", "#c83028", "#3a7a20", "#9a7008",
    "#2870b0", "#9a38a0", "#208870", "#faf6f0",
]
cursor = "#8a6600"
cursor-text = "#f5ede0"
selection-background = "#e5e8e2"
selection-foreground = "#3a3630"
