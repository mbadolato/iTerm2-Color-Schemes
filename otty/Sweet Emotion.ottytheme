[meta]
name = "Sweet Emotion"
mode = "dark"

[terminal]
foreground = "#f9e5f4"
background = "#211027"
palette = [
    "#a6a7a6", "#ee75a8", "#78c6a6", "#e6b86b",
    "#89a8ee", "#c38bec", "#75cbd6", "#f9e5f4",
    "#c4c7c8", "#f18bb6", "#8ecfb4", "#eac383",
    "#9cb6f1", "#cd9eef", "#8bd3dd", "#fff9ee",
]
cursor = "#e6b86b"
cursor-text = "#211027"
selection-background = "#49343d"
selection-foreground = "#fff8ee"
