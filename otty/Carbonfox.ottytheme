[meta]
name = "Carbonfox"
mode = "dark"

[terminal]
foreground = "#f2f4f8"
background = "#161616"
palette = [
    "#282828", "#ee5396", "#25be6a", "#08bdba",
    "#78a9ff", "#be95ff", "#33b1ff", "#dfdfe0",
    "#484848", "#f16da6", "#46c880", "#2dc7c4",
    "#8cb6ff", "#c8a5ff", "#52bdff", "#e4e4e5",
]
cursor = "#f2f4f8"
cursor-text = "#161616"
selection-background = "#2a2a2a"
selection-foreground = "#f2f4f8"
