[meta]
name = "Scarlet Protocol"
mode = "dark"

[terminal]
foreground = "#e41951"
background = "#1c153d"
palette = [
    "#101116", "#ff0051", "#00dc84", "#faf945",
    "#0271b6", "#ca30c7", "#00c5c7", "#c7c7c7",
    "#686868", "#ff6e67", "#5ffa68", "#fffc67",
    "#6871ff", "#bd35ec", "#60fdff", "#ffffff",
]
cursor = "#76ff9f"
cursor-text = "#a6a6a6"
selection-background = "#c1deff"
selection-foreground = "#000000"
