[meta]
name = "Lumina Olive Dark"
mode = "dark"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#dfddce"
background = "#212311"
palette = [
    "#262814", "#cd6f71", "#9acca4", "#edba7a",
    "#8fb9f7", "#ddabd8", "#8acbd2", "#bfbdae",
    "#8a8b76", "#da9090", "#b2e7bd", "#ffd7a6",
    "#b5d3ff", "#f8c4f3", "#a2e5ed", "#dfddce",
]
cursor = "#dfddce"
cursor-text = "#212311"
selection-background = "#454343"
selection-foreground = "#dfddce"
