[meta]
name = "Lumina Olive Dark"
mode = "dark"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#e1dfce"
background = "#1a1b0c"
palette = [
    "#1f200f", "#d3726a", "#b5d5c6", "#ebc27c",
    "#a2c4f0", "#d5a2d0", "#8bcfd7", "#c1bfae",
    "#8c8c76", "#e0938c", "#b5f7da", "#ffdea7",
    "#c4ddff", "#f0bbeb", "#a3e9f2", "#e1dfce",
]
cursor = "#e1dfce"
cursor-text = "#1a1b0c"
selection-background = "#3d4224"
selection-foreground = "#e1dfce"
