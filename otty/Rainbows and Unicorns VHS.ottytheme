[meta]
name = "Rainbows and Unicorns VHS"
mode = "dark"

[terminal]
foreground = "#f2ebdd"
background = "#101b45"
palette = [
    "#0a1230", "#ff6b6b", "#8fe3a0", "#f7d774",
    "#7fb2ff", "#d59cff", "#7fe3e0", "#d6d0c2",
    "#6f7ba8", "#ffa862", "#b5f0c1", "#fbe6a3",
    "#abcdff", "#e5c2ff", "#aef0ee", "#ffffff",
]
cursor = "#f2ebdd"
cursor-text = "#101b45"
selection-background = "#f2ebdd"
selection-foreground = "#101b45"
