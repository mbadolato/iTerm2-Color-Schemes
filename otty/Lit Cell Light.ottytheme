[meta]
name = "Lit Cell Light"
mode = "light"
author = "Zerebos (https://github.com/zerebos)"

[terminal]
foreground = "#1b2620"
background = "#f1f4ef"
palette = [
    "#1b2620", "#aa2826", "#09663f", "#834d00",
    "#225b9d", "#7e3e98", "#096561", "#a9b4ad",
    "#5f6e66", "#c9382f", "#0c7e4f", "#9e5f00",
    "#316fb7", "#9a4bb9", "#0c7b75", "#ffffff",
]
cursor = "#0b7a4b"
cursor-text = "#f1f4ef"
selection-background = "#cbe6d6"
selection-foreground = "#0f1311"
