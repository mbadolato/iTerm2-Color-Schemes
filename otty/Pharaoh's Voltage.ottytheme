[meta]
name = "Pharaoh's Voltage"
mode = "dark"

[terminal]
foreground = "#f8e9ca"
background = "#102c3c"
palette = [
    "#a8b2b8", "#ea9166", "#8bc49c", "#e9c366",
    "#78b9e8", "#c79cda", "#74d5d6", "#f8e9ca",
    "#b9c1c6", "#ed9e78", "#99cba8", "#ecca78",
    "#88c1eb", "#cea8de", "#85dadb", "#f9edd5",
]
cursor = "#ecca78"
cursor-text = "#102c3c"
selection-background = "#3e4556"
selection-foreground = "#f8e9ca"
