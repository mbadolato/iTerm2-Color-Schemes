[meta]
name = "Ollie"
mode = "dark"

[terminal]
foreground = "#8a8dae"
background = "#222125"
palette = [
    "#000000", "#ac2e31", "#31ac61", "#ac4300",
    "#2d57ac", "#b08528", "#1fa6ac", "#8a8eac",
    "#684432", "#ff3d48", "#3bff99", "#ff5e1e",
    "#4488ff", "#ffc21d", "#1ffaff", "#5b6ea7",
]
cursor = "#5b6ea7"
cursor-text = "#2a292d"
selection-background = "#1e3a66"
selection-foreground = "#8a8eac"
