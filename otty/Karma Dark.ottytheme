[meta]
name = "Karma Dark"
mode = "dark"

[terminal]
foreground = "#f7f1ff"
background = "#0a0e14"
palette = [
    "#0a0e14", "#fc618d", "#7bd88f", "#fce566",
    "#5ad4e6", "#af98e6", "#5ad4e6", "#bab6c0",
    "#69676c", "#ff7ba0", "#9ce3ab", "#fce566",
    "#7fe0ee", "#c3b0f0", "#7fe0ee", "#f7f1ff",
]
cursor = "#fce566"
cursor-text = "#0a0e14"
selection-background = "#3a384a"
selection-foreground = "#f7f1ff"
