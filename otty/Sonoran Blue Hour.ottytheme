[meta]
name = "Sonoran Blue Hour"
mode = "dark"

[terminal]
foreground = "#e9dcd8"
background = "#171d35"
palette = [
    "#252b48", "#cb777d", "#83adab", "#d4ae85",
    "#799bd6", "#a894cb", "#72bfc6", "#d5cfd6",
    "#555c82", "#ef9b91", "#a6d2c7", "#f2cc9e",
    "#a9bcf3", "#d2b7ed", "#9be4e5", "#fff1e8",
]
cursor = "#f0af94"
cursor-text = "#171d35"
selection-background = "#353a61"
selection-foreground = "#636a82"
