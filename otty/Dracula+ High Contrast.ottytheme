[meta]
name = "Dracula+ High Contrast"
mode = "dark"
author = "Cursor agent assisting Mark Badolato"

[terminal]
foreground = "#f8f8f2"
background = "#14141a"
palette = [
    "#9ba0b4", "#ff7676", "#50fa7b", "#ffcb6b",
    "#82aaff", "#c792ea", "#8be9fd", "#f8f8f2",
    "#9ba1b5", "#ff8a8a", "#69ff94", "#ffd98a",
    "#d6acff", "#ff92df", "#a4ffff", "#ffffff",
]
cursor = "#eceff4"
cursor-text = "#14141a"
selection-background = "#44475a"
selection-foreground = "#f8f8f2"
