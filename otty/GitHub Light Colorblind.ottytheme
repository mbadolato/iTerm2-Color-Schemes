[meta]
name = "GitHub Light Colorblind"
mode = "light"

[terminal]
foreground = "#24292f"
background = "#ffffff"
palette = [
    "#24292f", "#b35900", "#0550ae", "#4d2d00",
    "#0969da", "#8250df", "#1b7c83", "#6e7781",
    "#57606a", "#8a4600", "#0969da", "#633c01",
    "#218bff", "#a475f9", "#3192aa", "#8c959f",
]
cursor = "#0969da"
cursor-text = "#3c9cff"
selection-background = "#24292f"
selection-foreground = "#ffffff"
