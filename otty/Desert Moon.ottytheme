[meta]
name = "Desert Moon"
mode = "dark"

[terminal]
foreground = "#f2f2e8"
background = "#0b3459"
palette = [
    "#b9c6cb", "#e79b90", "#8fc9a3", "#e2c979",
    "#8dbfdd", "#b9a7d7", "#80cdd0", "#f2f2e8",
    "#cbd5d8", "#efb0a7", "#a8d6b6", "#ecd995",
    "#a9d0e7", "#cabce2", "#9bdadd", "#fffdf5",
]
cursor = "#d9e3d3"
cursor-text = "#0b3459"
selection-background = "#285273"
selection-foreground = "#fffdf2"
