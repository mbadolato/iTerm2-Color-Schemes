[meta]
name = "Prism"
mode = "dark"

[terminal]
foreground = "#d7e3f4"
background = "#0b1326"
palette = [
    "#060c18", "#ff7192", "#71e0b0", "#fad77c",
    "#47b3ff", "#9da9ff", "#31dcf2", "#b6c4dc",
    "#5e6f90", "#ff96ad", "#93ecc7", "#fca76d",
    "#77caff", "#b8c1ff", "#6ceafb", "#eaf1fb",
]
cursor = "#56d5ff"
cursor-text = "#0b1326"
selection-background = "#1e2c49"
selection-foreground = "#4b5366"
