[meta]
name = "Ghostty Default Style Dark"
mode = "dark"

[terminal]
foreground = "#ffffff"
background = "#282c34"
palette = [
    "#1d1f21", "#cc6566", "#b6bd68", "#f0c674",
    "#82a2be", "#b294bb", "#8abeb7", "#c4c8c6",
    "#666666", "#d54e53", "#b9ca4b", "#e7c547",
    "#7aa6da", "#c397d8", "#70c0b1", "#eaeaea",
]
cursor = "#ffffff"
cursor-text = "#353a44"
selection-background = "#ffffff"
selection-foreground = "#282c34"
