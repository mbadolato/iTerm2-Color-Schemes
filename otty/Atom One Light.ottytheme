[meta]
name = "Atom One Light"
mode = "light"

[terminal]
foreground = "#383a42"
background = "#fafafa"
palette = [
    "#000000", "#de3e35", "#3f953a", "#d2b67c",
    "#2f5af3", "#950095", "#0184bc", "#bbbbbb",
    "#000000", "#de3e35", "#3f953a", "#d2b67c",
    "#2f5af3", "#a00095", "#0184bc", "#ffffff",
]
cursor = "#526fff"
cursor-text = "#ffffff"
selection-background = "#d0dffc"
selection-foreground = "#2a2c33"
