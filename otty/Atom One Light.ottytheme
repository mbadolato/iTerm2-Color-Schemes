[meta]
name = "Atom One Light"
mode = "light"

[terminal]
foreground = "#2a2c33"
background = "#f9f9f9"
palette = [
    "#000000", "#de3e35", "#3f953a", "#d2b67c",
    "#2f5af3", "#950095", "#3f953a", "#bbbbbb",
    "#000000", "#de3e35", "#3f953a", "#d2b67c",
    "#2f5af3", "#a00095", "#3f953a", "#ffffff",
]
cursor = "#bbbbbb"
cursor-text = "#ffffff"
selection-background = "#d0dffc"
selection-foreground = "#2a2c33"
