[meta]
name = "Lumina Ember Dark"
mode = "dark"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#e0d8cb"
background = "#1c1916"
palette = [
    "#211e1a", "#d1635b", "#90d6b4", "#e4d874",
    "#78bbea", "#e5a7df", "#77cfd9", "#c0b8ab",
    "#978b7e", "#dd867e", "#a3f2cc", "#f7eb89",
    "#99d4ff", "#ffc1f9", "#90e9f4", "#e0d8cb",
]
cursor = "#e0d8cb"
cursor-text = "#1c1916"
selection-background = "#4e3929"
selection-foreground = "#e0d8cb"
