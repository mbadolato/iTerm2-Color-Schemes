[meta]
name = "Lumina Ember Dark"
mode = "dark"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#e4ddd0"
background = "#171511"
palette = [
    "#1c1a15", "#cb7870", "#a9cc97", "#e5cc88",
    "#94bedc", "#d7a2c6", "#91c7cd", "#c4bdb0",
    "#8e8577", "#da9890", "#c5e5b5", "#ffe6a2",
    "#b0d7f4", "#f0bcdf", "#aae1e7", "#e4ddd0",
]
cursor = "#e4ddd0"
cursor-text = "#171511"
selection-background = "#46342a"
selection-foreground = "#e4ddd0"
