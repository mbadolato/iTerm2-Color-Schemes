[meta]
name = "Rainbows and Unicorns Mane"
mode = "dark"

[terminal]
foreground = "#e9e7f2"
background = "#14131a"
palette = [
    "#24222e", "#eb413a", "#68c44a", "#fede3c",
    "#3092e2", "#b866d6", "#45c8c0", "#c8cae4",
    "#6e6a82", "#fa821e", "#8fdb74", "#ffe978",
    "#62b0f0", "#f0a0be", "#7fe0d8", "#ffffff",
]
cursor = "#ffd65a"
cursor-text = "#14131a"
selection-background = "#9230aa"
selection-foreground = "#ffffff"
