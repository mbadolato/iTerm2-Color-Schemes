[meta]
name = "Cobalt Next"
mode = "dark"

[terminal]
foreground = "#d7deea"
background = "#162c35"
palette = [
    "#000000", "#ff527b", "#8cc98f", "#ffc64c",
    "#409dd4", "#cba3c7", "#37b5b4", "#d7deea",
    "#62747f", "#e47e8b", "#baddbb", "#ffdc91",
    "#7ac0eb", "#f3ccef", "#84e4e3", "#ffffff",
]
cursor = "#ffc64c"
cursor-text = "#8a919d"
selection-background = "#4c5b67"
selection-foreground = "#ffffff"
