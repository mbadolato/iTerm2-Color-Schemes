[meta]
name = "SeedFlip Abyss"
mode = "dark"

[terminal]
foreground = "#e0e0f0"
background = "#050510"
palette = [
    "#030308", "#d26060", "#60d286", "#d2bf60",
    "#6090d2", "#d260d2", "#60d2d2", "#f1f1f8",
    "#3d3d70", "#e39c9c", "#9ce3b3", "#e3d79c",
    "#9cb9e3", "#e39ce3", "#9ce3e3", "#ffffff",
]
cursor = "#6e56cf"
cursor-text = "#050510"
selection-background = "#0c0c1e"
selection-foreground = "#e0e0f0"
