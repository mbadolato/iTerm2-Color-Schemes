[meta]
name = "Adventure Time"
mode = "dark"

[terminal]
foreground = "#f8dcc0"
background = "#1f1d45"
palette = [
    "#050404", "#bd0013", "#4ab118", "#e7741e",
    "#0f4ac6", "#665993", "#70a598", "#f8dcc0",
    "#4e7cbf", "#fc5f5a", "#9eff6e", "#efc11a",
    "#1997c6", "#9b5953", "#c8faf4", "#f6f5fb",
]
cursor = "#efbf38"
cursor-text = "#08080a"
selection-background = "#706b4e"
selection-foreground = "#f3d9c4"
