[meta]
name = "Nephrite Jade"
mode = "dark"
author = "Nephrite (https://github.com/Nephrite-theme/terminal)"

[terminal]
foreground = "#e7f2eb"
background = "#132e20"
palette = [
    "#2e4639", "#ffaaa7", "#4dbf74", "#e0c262",
    "#96c9fe", "#d5b2ff", "#4cdbe3", "#bdccc3",
    "#7f9187", "#ffaaa7", "#65ddbb", "#e0c262",
    "#96c9fe", "#fea4cc", "#4cdbe3", "#e7f2eb",
]
cursor = "#4dbf74"
cursor-text = "#132e20"
selection-background = "#3c5346"
selection-foreground = "#e7f2eb"
