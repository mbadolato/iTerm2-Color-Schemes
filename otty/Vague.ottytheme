[meta]
name = "Vague"
mode = "dark"

[terminal]
foreground = "#cdcdcd"
background = "#141415"
palette = [
    "#252530", "#d8647e", "#7fa563", "#f3be7c",
    "#6e94b2", "#bb9dbd", "#aeaed1", "#cdcdcd",
    "#606079", "#e08398", "#99b782", "#f5cb96",
    "#8ba9c1", "#c9b1ca", "#bebeda", "#d7d7d7",
]
cursor = "#cdcdcd"
cursor-text = "#141415"
selection-background = "#252530"
selection-foreground = "#cdcdcd"
