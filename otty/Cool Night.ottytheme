[meta]
name = "Cool Night"
mode = "dark"

[terminal]
foreground = "#ecdef4"
background = "#010c18"
palette = [
    "#0b3b61", "#ff3a3a", "#52ffd0", "#fff383",
    "#1376f9", "#c792ea", "#ff5ed4", "#16fda2",
    "#63686d", "#ff54b0", "#74ffd8", "#fcf5ae",
    "#388eff", "#ae81ff", "#ff6ad7", "#60fbbf",
]
cursor = "#38ff9d"
cursor-text = "#000000"
selection-background = "#38ff9c"
selection-foreground = "#000000"
