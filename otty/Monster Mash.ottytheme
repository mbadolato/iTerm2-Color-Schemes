[meta]
name = "Monster Mash"
mode = "dark"

[terminal]
foreground = "#f0f5d8"
background = "#173b0d"
palette = [
    "#b8c9ae", "#f09579", "#9ee566", "#e7cf52",
    "#86c5e8", "#bd91e8", "#72d8cc", "#f0f5d8",
    "#c1cfb8", "#f2a289", "#aae878", "#ead567",
    "#95cceb", "#c59eeb", "#83ddd2", "#f2f6dd",
]
cursor = "#f2a289"
