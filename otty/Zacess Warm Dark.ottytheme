[meta]
name = "Zacess Warm Dark"
mode = "dark"

[terminal]
foreground = "#e5d5b6"
background = "#211b17"
palette = [
    "#ada398", "#fc9a8d", "#a2be6f", "#e4b35b",
    "#88b9e3", "#dfa1ca", "#73c2b8", "#cbc1b1",
    "#b9b1a9", "#fee4e0", "#d9f2b0", "#ffe9b6",
    "#d7ecff", "#ffe1f4", "#b1f7ed", "#fbf1dc",
]
cursor = "#fec9a7"
cursor-text = "#211b17"
selection-background = "#7abad3"
selection-foreground = "#211b17"
