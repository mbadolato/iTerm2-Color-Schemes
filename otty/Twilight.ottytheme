[meta]
name = "Twilight"
mode = "dark"

[terminal]
foreground = "#ffffd4"
background = "#141414"
palette = [
    "#141414", "#c06d44", "#afb97a", "#c2a86c",
    "#44474a", "#b4be7c", "#778385", "#ffffd4",
    "#404040", "#de7c4c", "#ccd88c", "#e2c47e",
    "#5a5e62", "#d0dc8e", "#8a989b", "#ffffd4",
]
cursor = "#ffffff"
cursor-text = "#000000"
selection-background = "#313131"
selection-foreground = "#ffffd4"
