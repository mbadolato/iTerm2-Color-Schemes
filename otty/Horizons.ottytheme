[meta]
name = "Horizons"
mode = "light"

[terminal]
foreground = "#0f172a"
background = "#f8fafc"
palette = [
    "#283548", "#761515", "#126b32", "#755600",
    "#174da6", "#65349a", "#00657a", "#3d4858",
    "#536071", "#7d1818", "#16713a", "#7a5c00",
    "#123d82", "#6c3ca0", "#006c81", "#465264",
]
cursor = "#8a4300"
cursor-text = "#f8fafc"
selection-background = "#e2e8f0"
selection-foreground = "#0f172a"
