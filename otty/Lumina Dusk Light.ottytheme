[meta]
name = "Lumina Dusk Light"
mode = "light"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#3f3341"
background = "#f1eaf2"
palette = [
    "#3f3341", "#882322", "#27693a", "#644c31",
    "#334f9d", "#6f2c79", "#006576", "#736575",
    "#6e6073", "#622220", "#125529", "#593500",
    "#283e7a", "#532559", "#00505e", "#918394",
]
cursor = "#3f3341"
cursor-text = "#f1eaf2"
selection-background = "#decee1"
selection-foreground = "#3f3341"
