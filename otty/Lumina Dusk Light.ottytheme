[meta]
name = "Lumina Dusk Light"
mode = "light"
author = "Razik Ikhlef (https://github.com/RazikSF/lumina-themes)"

[terminal]
foreground = "#2e2945"
background = "#f6f3fe"
palette = [
    "#2e2945", "#872423", "#357545", "#9e611b",
    "#3163ad", "#874d82", "#007185", "#706b8b",
    "#69637b", "#622320", "#216033", "#854e07",
    "#2b5088", "#713a6c", "#005b6c", "#8e8aac",
]
cursor = "#2e2945"
cursor-text = "#f6f3fe"
selection-background = "#d7bcc6"
selection-foreground = "#2e2945"
