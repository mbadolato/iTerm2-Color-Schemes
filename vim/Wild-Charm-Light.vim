" Vim Color File
" Generated by iTerm2-Color-Schemes
" Name: Wild Charm Light
" URL: https://github.com/mbadolato/iTerm2-Color-Schemes

hi clear
if exists("syntax_on")
  syntax reset
endif

let g:colors_name = "Wild-Charm-Light"

" Normal colors
hi Normal guifg=#000000 guibg=#ffffff

" Syntax highlighting groups
hi Comment guifg=#808080
hi Constant guifg=#af5f00
hi Identifier guifg=#005faf
hi Statement guifg=#d70000
hi PreProc guifg=#af00af
hi Type guifg=#5faf5f
hi Special guifg=#00afaf
hi Underlined guifg=#0087d7 gui=underline
hi Error guifg=#af0000 guibg=#ffffff
hi Todo guifg=#d78700 guibg=#ffffff

" Additional groups for better compatibility
hi String guifg=#008700
hi Character guifg=#008700
hi Number guifg=#af5f00
hi Boolean guifg=#af5f00
hi Float guifg=#af5f00

hi Function guifg=#005faf

hi Conditional guifg=#d70000
hi Repeat guifg=#d70000
hi Label guifg=#d70000
hi Operator guifg=#8a8a8a
hi Keyword guifg=#d70000
hi Exception guifg=#af0000

hi Include guifg=#af00af
hi Define guifg=#af00af
hi Macro guifg=#af00af
hi PreCondit guifg=#af00af

hi StorageClass guifg=#5faf5f
hi Structure guifg=#5faf5f
hi Typedef guifg=#5faf5f

hi SpecialChar guifg=#00afaf
hi Tag guifg=#00afaf
hi Delimiter guifg=#8a8a8a
hi SpecialComment guifg=#808080
hi Debug guifg=#d78700

hi Ignore guifg=#ffffff

" Cursor and line highlighting
hi Cursor guifg=#ffffff guibg=#767676
hi CursorLine guibg=#00afff
hi CursorColumn guibg=#00afff

" Visual selection
hi Visual guibg=#00afff

" Search highlighting
hi Search guibg=#d78700 guifg=#ffffff
hi IncSearch guibg=#d78700 guifg=#ffffff

" Line numbers
hi LineNr guifg=#808080
hi CursorLineNr guifg=#000000

" Status line
hi StatusLine guifg=#000000 guibg=#808080
hi StatusLineNC guifg=#808080 guibg=#ffffff

" Tab line
hi TabLine guifg=#808080 guibg=#ffffff
hi TabLineSel guifg=#000000 guibg=#00afff
hi TabLineFill guibg=#ffffff

" Popup menu
hi Pmenu guifg=#000000 guibg=#808080
hi PmenuSel guifg=#ffffff guibg=#00afff
hi PmenuSbar guibg=#808080
hi PmenuThumb guibg=#000000

" Diff highlighting
hi DiffAdd guibg=#008700
hi DiffChange guibg=#af5f00
hi DiffDelete guibg=#af0000
hi DiffText guibg=#005faf

" Fold highlighting
hi Folded guifg=#808080 guibg=#ffffff
hi FoldColumn guifg=#808080 guibg=#ffffff

" Spell checking
hi SpellBad gui=undercurl guisp=#af0000
hi SpellCap gui=undercurl guisp=#005faf
hi SpellRare gui=undercurl guisp=#870087
hi SpellLocal gui=undercurl guisp=#008f9f

" Error and warning messages
hi ErrorMsg guifg=#af0000
hi WarningMsg guifg=#af5f00
hi MoreMsg guifg=#005faf
hi Question guifg=#008700

" Mode message
hi ModeMsg guifg=#008700

" Directory
hi Directory guifg=#005faf

" Title
hi Title guifg=#870087

" Match parenthesis
hi MatchParen guibg=#808080

" Sign column
hi SignColumn guifg=#808080 guibg=#ffffff
